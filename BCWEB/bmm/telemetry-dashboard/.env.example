# THIS FILE IS FOR RUNNING THE DASHBOARD STANDALONE ONLY.
#
# Under Docker — which is how BCWEB actually runs it — none of this is read. The Dockerfile
# copies only server/Cargo.toml, server/migrations, server/src, the built binary and web/dist,
# so the .env beside this one never enters the image. `dotenvy::dotenv()` in main.rs finds
# nothing and every value comes from docker-compose.yml, which reads BCWEB/infra/compose/.env.
#
# So editing a value here and restarting the stack changes NOTHING, silently. That already
# bit once: RETENTION_DAYS could say 30 here while Docker kept the built-in 180, because
# compose was not passing it through. It is passed now, from TELEMETRY_RETENTION_DAYS in
# BCWEB's .env — set it THERE.
#
# The mapping, for the deployed stack:
#   API_KEY        <- TELEMETRY_API_KEY          (PUBLIC ingest key; must match the BMM client)
#   ADMIN_KEY      <- TELEMETRY_ADMIN_KEY        (the real secret)
#   RETENTION_DAYS <- TELEMETRY_RETENTION_DAYS
#   DELETE_DELAY_H <- TELEMETRY_DELETE_DELAY_H
#   PORT, DATABASE_URL, STATIC_DIR, BC_API_URL, BC_LINK_SECRET — all set by compose.
#
# STORAGE_LIMIT_MB is NOT read by the server any more; the limit is an admin setting in the
# dashboard itself.

# Copy to .env and fill in.
PORT=8900
# Must match BMM links-config analytics_key. Generate a long random value.
API_KEY=changeme-generate-a-long-random-key
# Unlocks the in-dashboard deletion-approval panel. Keep this secret.
ADMIN_KEY=changeme-admin-secret

# NOTE: RETENTION_DAYS, DELETE_DELAY_H and STORAGE_LIMIT_MB below are just the
# INITIAL defaults. Once set, they can be changed LIVE (persisted to config.json,
# no restart) from BCWEB → Admin → Hosting settings → "BMM telemetry (live)", or via
# the admin API (GET/POST /api/admin/config with X-Admin-Key). config.json overrides
# these env values.

# GDPR retention: raw events older than this are auto-deleted (default 180 days).
RETENTION_DAYS=180
# Mandatory review delay before an un-actioned erasure request auto-applies (default 72h).
DELETE_DELAY_H=72

STORAGE_LIMIT_MB=5120