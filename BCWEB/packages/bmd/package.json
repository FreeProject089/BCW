{
  "name": "@bettercommunity/bmd",
  "version": "3.0.0",
  "description": "B.MD — better.markdown: a block system on GitHub-flavoured Markdown (callouts, cards, tabs, steps, timelines, stats, FAQ, API cards, embeds, live values, diagrams…) as one React component, with a public AST, a link checker and an HTML exporter. The renderer behind BetterCommunity's blog, docs and pages.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.jsx",
  "types": "./src/markdown.d.ts",
  "exports": {
    ".": "./src/index.jsx",
    "./config": "./src/config.js",
    "./icons": "./src/icons.jsx",
    "./brands": "./src/brands.jsx",
    "./plugins": "./src/plugins.js",
    "./openapi": "./src/openapi.js",
    "./export": "./src/export.jsx",
    "./ast": "./src/ast.js",
    "./editor-blocks": "./src/editor-blocks.js",
    "./links": "./src/links.js",
    "./markdown.css": "./src/markdown.css",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "docs",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "keywords": [
    "markdown",
    "react",
    "openapi",
    "mermaid",
    "directives",
    "remark",
    "blocks",
    "docs",
    "bettercommunity"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/BetterDCS/BCW",
    "directory": "BCWEB/packages/bmd"
  },
  "homepage": "https://bettercommunity.ch/dev/markdown",
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "react": ">=18",
    "react-dom": ">=18",
    "react-markdown": "^9",
    "rehype-raw": "^7",
    "rehype-sanitize": "^6",
    "remark-directive": "^3",
    "remark-gfm": "^4",
    "unist-util-visit": "^5",
    "unified": "^11",
    "remark-parse": "^11",
    "mermaid": ">=10",
    "rehype-highlight": "^7",
    "remark-math": "^6",
    "rehype-katex": "^7",
    "katex": ">=0.16"
  },
  "peerDependenciesMeta": {
    "mermaid": {
      "optional": true
    },
    "rehype-highlight": {
      "optional": true
    },
    "remark-math": {
      "optional": true
    },
    "rehype-katex": {
      "optional": true
    },
    "katex": {
      "optional": true
    }
  },
  "scripts": {
    "pack:check": "npm pack --dry-run"
  }
}
