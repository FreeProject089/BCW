// BetterCommunity Web — data model. `npx prisma migrate dev` to apply.
generator client {
  provider      = "prisma-client-js"
  // native = local dev; musl target = the alpine containers.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Runtime queries go through `url` (which can point at PgBouncer in transaction
  // pooling mode, `?pgbouncer=true`), while migrations / `db push` use `directUrl`
  // (a direct Postgres connection — PgBouncer transaction mode can't run them).
  // By default both are the same direct connection, so nothing changes until you
  // actually enable the pgbouncer compose profile.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Role {
  USER
  MOD
  ADMIN
  SUPERADMIN // implicitly satisfies every requireRole()/Protected role check — see lib.mjs
}

// `Project.key` used to be an enum, which meant adding an official project — one that can
// carry a catalogue, take blog permissions and have its own page — required a schema
// migration. A ShowcaseProject already covers a custom PAGE; what it cannot be is the target
// of a CatalogItem or a projectKey grant, and that was the whole gap.
//
// A string, with the five built-ins created by the seed and protected against deletion in
// projects.mjs. The validation that used to be the enum's job is now a lookup against the
// rows that exist, which is the same question asked of the place that knows the answer.
enum CatalogKind {
  APP
  PLUGIN
  THEME
  PRESET
  /// A .bmp modpack — a set of mods and the profile that arranges them, published as one
  /// downloadable thing. Added last, so existing rows keep their ordinal.
  MODPACK
  TUTORIAL
  /// A .mm mod list — the oldest shareable thing in BMM, and the last one to get a
  /// catalogue. Appended, so existing rows keep their ordinal.
  LIST
}

enum ItemStatus {
  PENDING
  PUBLISHED
  REJECTED
  HIDDEN
  SUSPENDED // admin-locked: not public, and the owner CANNOT resubmit (unlike REJECTED)
}

enum SubmissionType {
  NEW
  UPDATE
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum RepoStatus {
  PROVISIONING
  ONLINE
  SUSPENDED
  OFFLINE
}

model User {
  id               String         @id @default(cuid())
  email            String         @unique
  // Null for accounts created purely via OAuth (GitHub/Discord) that never set a
  // password — /auth/login rejects those with a clear "use <provider> to sign in"
  // error instead of crashing on argon2.verify(null, ...).
  passwordHash     String?
  displayName      String
  role             Role           @default(USER)
  // Fine-grained capability grants layered ON TOP of the role (e.g. a MOD/USER granted
  // "manage_repos"). ADMIN/SUPERADMIN implicitly have every capability; see CAPABILITIES
  // in lib/lib.mjs. Empty for most accounts.
  permissions      String[]       @default([])
  // Custom, SUPERADMIN-authored roles (CustomRole) assigned to this user. Each expands
  // into a bundle of capabilities that are UNION-ed with `permissions` to form the
  // user's effective caps (see currentUser() in lib/lib.mjs). A user may hold several.
  // Denormalized id list (matches the codebase's String[] idiom); dangling ids left by a
  // deleted role are simply ignored at resolution time.
  customRoleIds    String[]       @default([])
  emailVerified    Boolean        @default(false)
  bio              String         @default("")
  avatar           Json? // { variant, seed } for the Boring Avatar
  termsAcceptedAt  DateTime? // last time the user accepted the Terms + Payments policy at checkout
  /// The published Terms version that acceptance refers to. Without it the timestamp above
  /// points at whatever the document says TODAY, which in a dispute is worth nothing.
  termsVersion     Int?
  /// Last time the user agreed to a policy change that required it. Distinct from
  /// termsAcceptedAt, which is tied to a purchase; this one can be prompted at any time.
  legalAcceptedAt  DateTime?
  stripeCustomerId String?        @unique
  apiKeys          ApiKey[]
  // Mails sent to this account's address, matched when the mail was sent. Cascade: an
  // erased account takes its mail history with it (see MailLog).
  mailLogs         MailLog[]
  customDomains     CustomDomain[]
  boostCredits      BoostCredit[]
  polls            Poll[]         @relation("PollAuthor")
  oauthClients     OAuthClient[]  @relation("OAuthClientOwner")
  pollVotes        PollVote[]     @relation("PollVoter")
  pollAnswers      PollAnswer[]   @relation("PollAnswerer")
  blockedUrls      BlockedUrl[]
  legalEdits       LegalSection[]
  legalPublished   LegalVersion[] @relation("LegalPublisher")
  expenses         Expense[]      @relation("ExpenseAuthor")
  sessions         Session[]
  economy          UserEconomy?
  purchases        EconomyPurchase[]
  projectPurchases ProjectProductPurchase[]
  ledger           EconomyLedger[]
  /// M11: the landing review this member posted (at most one per account).
  review           Review?
  createdAt        DateTime       @default(now())

  // ── 2FA (TOTP) — see totp.mjs. Recovery codes are argon2 hashes, one-time use. ──
  totpSecret        String?
  totpEnabled       Boolean   @default(false)
  totpRecoveryCodes String[]  @default([])
  // Extra, SUPERADMIN-grantable permission (orthogonal to the role hierarchy)
  // required — together with a step-up 2FA challenge — to reach the server-control
  // tools (perf dashboard actions, Docker, terminal, power). See lib.mjs's
  // requireElevated() and server-control.mjs.
  canControlServer  Boolean   @default(false)
  // Admin-tier grant to view the BMM telemetry dashboard. Enforced at the Caddy
  // edge via forward_auth → GET /api/telemetry/authorize (telemetry.mjs), so the
  // separate telemetry app itself is never touched. SUPERADMIN is always allowed.
  canViewTelemetry  Boolean   @default(false)
  // Bumped on logout — invalidates any outstanding telemetry SSO token / tele_session
  // cookie so a signed-out user immediately loses BMM-telemetry access (telemetry.mjs
  // bakes this epoch into the token + host cookie and rejects on mismatch).
  telemetryEpoch    Int       @default(0)
  // Set once, the first time a Ko-fi donation webhook matches this account's
  // email — gates the one-time 25% hosting discount grant so repeat donations
  // (or webhook retries) don't mint duplicate codes.
  kofiDonorAt       DateTime?

  // ── Account moderation (admin suspend / ban) ──────────────────────────────────
  // `status` gates login AND live sessions (enforced via a short-TTL cache in lib.mjs
  // so a JWT session dies within ~15s of a ban). `suspended` is a lighter temporary
  // lock; `banned` is the harsher one — same mechanics, different label + messaging.
  // Both carry a reason (shown to the user + emailed) and an optional lift date
  // (`moderationUntil` null = permanent). Expired locks read as active and are cleared
  // lazily at next login.
  status           String    @default("active") // active | suspended | banned
  moderationUntil  DateTime? // when a temp lock lifts; null = permanent
  moderationReason String? // reason shown to the user + emailed
  moderatedAt      DateTime?
  moderatedById    String?

  // ── Public profile ──────────────────────────────────────────────────────────
  // A shareable /u/<id> page shows only the pseudo, avatar, badges, join date, role,
  // and PUBLIC repos/catalogs — no email or other PII. The owner controls visibility.
  // ── Account closure ──────────────────────────────────────────────────────
  // Closing is a REQUEST with a month of grace, not an act. What finally happens is
  // anonymisation, never a row delete: twenty-nine tables point at a user, and the ones
  // that matter most — payments, the audit chain — are exactly the ones that must survive
  // for as long as the law says. So the row stays and everything personal is scrubbed off
  // it, which keeps every invoice attached to something without keeping a person.
  closureRequestedAt     DateTime?
  closureScheduledFor    DateTime?
  // The cancel link. Random, and usable for as long as the closure is pending — someone
  // changing their mind may be doing it from an email on a device they are not signed in
  // on, and "log in first to stop your account being deleted" is a trap.
  closureToken           String?   @unique
  closedAt               DateTime?
  // Set when STAFF scheduled the closure rather than the account holder. Both fields are
  // null on a self-request, which is how the two are told apart everywhere else.
  closureReason          String?
  closureBy              String?
  // Can the account holder call this off? True for anything they asked for themselves.
  // Staff choose: a closure meant as a sanction that the target can undo with one click is
  // not a sanction, and one they CANNOT undo needs to be a deliberate choice rather than a
  // side effect of who pressed the button. When false no cancel token is minted at all —
  // an unusable link in an email is worse than no link.
  closureCancellable     Boolean   @default(true)
  // What everything this account owns looked like BEFORE the closure suspended it.
  //
  // During the grace period nothing is deleted — repos, catalogs and items are suspended, so
  // the account stops serving content while it is on its way out but nothing is lost if it
  // changes its mind. Restoring then has to put each one back where it WAS: a repo that was
  // OFFLINE must return to OFFLINE, not to ONLINE. That is only possible if the previous
  // state was written down, so it is, here, as { repos: {id: status}, catalogs: {id: {...}},
  // items: {id: status} }.
  closureSuspendState    Json?
  // The same snapshot, for a MODERATION suspension. Separate from the closure one because
  // the two can overlap — an account can be suspended and then closed — and one field would
  // let the second event overwrite the first's memory of the original state.
  moderationSuspendState Json?
  // Which notification CATEGORIES this account has switched off, as { category: false }.
  //
  // Absent means enabled, so a new category starts on for everybody and nobody has to opt
  // in to being told about their own things. Stored as JSON rather than a table because it
  // is a handful of booleans read on every notify() — one row read instead of a join.
  notifPrefs             Json?
  // ── Confirming the address is part of creating the account ──────────────────
  // When this unconfirmed sign-up stops being an account. See lib/verify-gate.mjs for what it
  // can and cannot do in the meantime, and sweepUnverifiedAccounts for what happens at the
  // end. Set at registration ONLY when e-mail is switched on for the deployment (nobody can
  // confirm a link that cannot be sent), and cleared in the same write that sets
  // emailVerified — two rows saying whether an account is on the clock is one row that will
  // disagree with the other.
  //
  // Null therefore means "no deadline", which covers an OAuth sign-up (the provider already
  // proved the address), an account that predates this column, and one that has confirmed.
  // The sweeper only ever looks at rows where it is SET and past, so every account that
  // existed before this rule is out of its reach by construction rather than by a date check
  // somebody has to remember.
  verifyDeadline         DateTime?
  // Set when the single day-7 "you never confirmed" reminder goes out, so it goes out once
  // instead of on every sweeper tick.
  verifyRemindedAt       DateTime?
  loginAlerts            LoginAlert[]
  // SHA-256 of the email the account had before anonymisation.
  //
  // Closing erases the address, which is the point — but it also erases the only link
  // between a closed account and the person who comes back. Without this, someone banned
  // for cause could close, re-register with the same address, and arrive with a clean
  // record; and someone returning in good faith would lose the history they earned. The
  // hash matches without storing the address: it can confirm "this is the same mailbox",
  // and it cannot be read back into one.
  closedEmailHash        String?
  // The closed account this one was recognised as coming back to.
  priorUser              User?     @relation("AccountReturn", fields: [priorUserId], references: [id], onDelete: SetNull)
  priorUserId            String?
  returnedAccounts       User[]    @relation("AccountReturn")
  profilePublic          Boolean   @default(true) // false = only the owner + staff (mod+) can view
  // Which linked connections to surface on the profile, e.g. ["github","discord","website"].
  // Empty = show none. The owner opts each in explicitly.
  showConnections        String[]  @default([])
  website                String? // optional public link the user chooses to show
  // Preferred UI language (BCP-47), persisted so it follows the account across devices (B9).
  // Null = no account preference; the browser's localStorage choice is used instead.
  locale                 String?

  badges UserBadge[]

  items                CatalogItem[]
  communityCatalogs    CommunityCatalog[]
  submissions          Submission[]
  notifications        Notification[]
  serverRepos          ServerRepo[]
  subscriptions        Subscription[]
  posts                BlogPost[]
  payments             Payment[]
  hostingGroups        HostingGroup[]
  creatorLinks         CreatorLink[]
  discordLinks         DiscordLink[]
  blogPermissions      BlogPermission[]
  projectPermissions   ProjectPermission[]
  myoRequests          MyoRequest[]
  myoAssigned          MyoRequest[]         @relation("MyoAssignee")
  myoMessages          MyoMessage[]
  submissionComments   SubmissionComment[]
  contactMessages      ContactMessage[]
  reportsMade          Report[]             @relation("ReportReporter")
  reportMessages       ReportMessage[]
  reportParticipations ReportParticipant[]
  socialConnections    SocialConnection[]
  showcaseRequests     ShowcaseRequest[]
  loginAttempts        LoginAttempt[]
  auditLogEntries      AuditLogEntry[]
  repoFavorites        RepoFavorite[]
  catalogFavorites     CatalogFavorite[]
  oauthAccounts        OAuthAccount[]
  blogComments         BlogComment[]
  docComments          DocComment[]
  // Moderation paperwork. `sanctions` is what landed ON them; `sanctionsIssued` is what
  // they handed out as staff — two different questions, and conflating them in one
  // relation would make both unanswerable.
  sanctions            Sanction[]           @relation("SanctionTarget")
  sanctionsIssued      Sanction[]           @relation("SanctionIssuer")
  rightsNotices        RightsNotice[]       @relation("RightsNoticeReporter")
  rightsReviews        RightsNotice[]       @relation("RightsNoticeReviewer")
  protectedWorks       ProtectedWork[]      @relation("ProtectedWorkAuthor")
  botActions           BotAction[]          @relation("BotActionRequester")
  staffNotes           StaffNote[]          @relation("StaffNoteAuthor")
  teamsOwned           Team[]               @relation("TeamOwner")
  teamMemberships      TeamMember[]
  threadsOwned         ContactThread[]      @relation("ThreadOwner")
  threadsSent          ContactThread[]      @relation("ThreadSender")
  threadMessages       ContactThreadMessage[] @relation("ThreadMsgAuthor")
  sanctionEvidence     SanctionAttachment[] @relation("SanctionAttachmentAuthor")
  pendingDismissals    PendingDismissal[]
  webhooks             WebhookEndpoint[]
  botWarnsIssued       BotWarn[]            @relation("BotWarnIssuer")

  @@index([status])
  @@index([closedEmailHash])
  @@index([priorUserId])
  dataKey           UserDataKey?
  /// Teams this account may own beyond the admin's limit (`teams.maxOwned`) — one per paid slot.
  extraTeamSlots   Int       @default(0)
}

// A GitHub/Discord identity linked to a website account — powers "Continue with
// GitHub/Discord" login AND signup (see oauth.mjs). Distinct from DiscordLink,
// which is a BMM/bot-gated pairing, not an auth method.
model OAuthAccount {
  id                String   @id @default(cuid())
  user              User     @relation(fields: [userId], references: [id])
  userId            String
  provider          String // 'github' | 'discord'
  providerAccountId String
  username          String?
  linkedAt          DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// A Discord account linked to a website account. One Discord id ↔ one account.
// Enables gated channel access (BMM + Discord + BCWEB) and telemetry enrichment.
model DiscordLink {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  discordId   String   @unique
  username    String?
  linkedAt    DateTime @default(now())
  // Set when a link is created/refreshed (e.g. via Discord OAuth sign-in) so the bot's
  // buffer poll (/bot/links/pending) can pick it up and refresh the member's roles.
  pendingSync Boolean  @default(false)

  @@index([userId])
  @@index([pendingSync])
}

// Discord activity reported by the bot, keyed by Discord id — surfaced in the BMM
// telemetry dashboard alongside the linked creator id (join date, last message, last
// voice join/create, avatar/username).
model DiscordActivity {
  // Now keyed per GUILD (B4): storage is budgeted per server, so a member in three guilds is
  // three rows. Was keyed by discordId alone (one flat global table) — which is why one busy
  // guild could evict another's members and why a 1M-member guild meant 1M unbudgeted rows.
  guildId           String    @default("")
  discordId         String
  username          String?
  avatar            String? // full CDN avatar URL
  guildJoinedAt     DateTime?
  lastMessageAt     DateTime?
  lastVoiceJoinAt   DateTime?
  lastVoiceCreateAt DateTime?
  /// Role NAMES as the guild reports them, refreshed by the member scan. Names rather than ids
  /// because the admin screen has no way to resolve an id, and a moderator deciding whether to
  /// ban somebody needs to see "Moderator", not a snowflake.
  roles             String[]  @default([])
  nickname          String?
  updatedAt         DateTime  @updatedAt

  @@id([guildId, discordId])
  // Per-guild oldest-first eviction (`where guildId orderBy updatedAt asc take N`): the sweeper
  // now prunes within ONE guild's budget, never across guilds.
  @@index([guildId, updatedAt])
  // Cross-guild lookups (a member's link/telemetry) still hit discordId directly.
  @@index([discordId])
}

// Per-guild bot configuration + member-storage budget (B4). Replaces the loose
// `bot.config.guilds[guildId]` JSON for the storage-relevant fields; the JSON keeps the
// feature toggles (welcome/joinToCreate/…) it already holds.
model BotGuild {
  guildId        String   @id
  name           String?
  // none = don't scan or store members (the safe default; a fresh guild stores nothing).
  // moderation  = run mod commands, log to Discord; store logs only if storeLogs + a pool.
  // pool        = store members, budgeted against a storage pool.
  memberMode     String   @default("none")
  logChannelId   String? // required to enable `moderation`
  storeLogs      Boolean  @default(false) // moderation: also persist logs (needs a pool)
  // The storage pool this guild draws from (a HostingGroup id — a loose FK, no relation, so
  // HostingGroup stays untouched). Null → the free-tier default budget.
  hostingGroupId String?
  // Bytes this guild may use for member rows + logs. 0 = the global default budget.
  storageQuotaBytes BigInt @default(0)
  // The guild's REAL member count from the gateway — kept accurate even when NOT storing rows,
  // so "at capacity" can still show how big the server actually is.
  memberCount    Int      @default(0)
  // B10: who may manage this guild from the USER-facing dashboard (not just site admins).
  // The bot reports the guild owner (always) + best-effort Manage-Server admins on every
  // heartbeat, so this is populated for EVERY guild the bot is in, even one still in `none`
  // mode. A logged-in site user whose linked DiscordLink.discordId is the owner — or is in
  // managerDiscordIds — may configure this guild's bot settings for their own server.
  // The bot's language in this server, chosen on the onboarding card: auto (each member's
  // Discord locale) or a code. Null = auto.
  language          String?
  ownerDiscordId    String?
  managerDiscordIds String[] @default([])
  updatedAt      DateTime @updatedAt

  @@index([memberMode])
  @@index([ownerDiscordId])
}

// A moderation action (B4). Written only when the guild is `pool`, or `moderation` + storeLogs;
// otherwise sanctions are logged to Discord only. Counts against the guild's storage budget.
model ModerationLog {
  id        String   @id @default(cuid())
  guildId   String
  actorId   String // who did it (a moderator, or the bot for an automatic action)
  targetId  String // who it was done to
  action    String // ban | kick | warn | timeout | unban | …
  reason    String?
  auto      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([guildId, createdAt])
}

// Short-lived pairing code the bot issues (via /link) so a website account can claim
// the Discord id by entering the code on BCWEB. Redeeming creates a DiscordLink.
model DiscordLinkCode {
  id        String   @id @default(cuid())
  code      String   @unique
  discordId String
  username  String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// A short-lived pairing code BMM requests (local-first) so a website account can
// claim the creator id by entering the code. Redeeming it creates a CreatorLink.
model LinkCode {
  id          String   @id @default(cuid())
  code        String   @unique
  creatorId   String
  displayName String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([expiresAt])
}

// A BMM creator id linked to an account. One creator id ↔ one account (unique),
// but an account may link several. Locked from unlinking until unlinkableAt.
model CreatorLink {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id])
  userId       String
  creatorId    String   @unique
  displayName  String? // the creator's display name as reported by BMM
  linkedAt     DateTime @default(now())
  unlinkableAt DateTime // linkedAt + 14 days (2-week lock)

  @@index([userId])
}

// Creator key v5 (BMM src-tauri/src/commands/creator_v5.rs, API lib/creator-identity.mjs).
//
// The Creator ID never changes between v4 and v5 — the key that proves it does. This pins
// the key: the first verified v5 proof for a creator id records which key it was signed by
// and where that key sits in the rotation chain. From then on:
//   · a bare v4 proof (bmmc1) for this id is refused — the v4 key is derivable from the
//     PC's serials, so after an upgrade it must not be able to speak for the id alone;
//   · a v5 chain that does not pass through the pinned key is a FORK and is refused.
// No relation to User, like FreeTierClaim: a creator id need not be linked to anybody.
// Reset by the linked account's owner or by staff (manage_sanctions) after a lost key store.
model CreatorKeyPin {
  creatorId   String   @id
  kid         String // the active key last seen
  seq         Int // its position in the chain (0 = the root signs for itself)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
}

// The hashed fingerprint components a v5 proof carried, one row per (id, component, hash).
// BMM salts every hash with this server's origin, so none of them is a serial number and
// none can be matched against another service. Kept to answer two staff questions: how
// stable is this id's machine (a changing hash per component), and does another id share
// its hardware (ban evasion). Pruned FINGERPRINT_RETENTION_DAYS after it was last seen.
model CreatorFingerprint {
  id          String   @id @default(cuid())
  creatorId   String
  component   String // "board" | "os" | "disk" | "canvas"
  hash        String // 32 hex
  count       Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([creatorId, component, hash])
  @@index([component, hash])
  @@index([lastSeenAt])
}

// A v5 proof's nonce, kept until the proof would have expired anyway. Inserting a nonce
// that is already here is a replay, and the unique key is what refuses it — across API
// processes, which an in-memory set would not.
model CreatorProofNonce {
  nonce     String   @id
  expiresAt DateTime

  @@index([expiresAt])
}

// Permanent record that a creator id (or, absent one, an account) has already
// claimed its ONE free hosted repo / free catalog upload. Deliberately never
// deleted — unlike CreatorLink, which a user CAN delete by unlinking — so
// unlink-then-relink-elsewhere can't be used to claim a second free item on the
// same creator id.
model FreeTierClaim {
  id        String   @id @default(cuid())
  kind      String // "REPO" | "CATALOG"
  creatorId String? // set when the claim is tied to a creator id
  userId    String // the account that made the claim (informational)
  createdAt DateTime @default(now())

  @@unique([kind, creatorId])
  @@index([userId])
}

// "Tell me when there is room."
//
// Hosting sells a finite disk, so the answer to a visitor is sometimes no. Until now that
// was the end of the conversation: the free tier said "sold out right now — check back
// later", and checking back later is work the site was asking a stranger to remember to do.
//
// No relation to User on purpose, like FreeTierClaim above: a waiting visitor may have no
// account at all, and the ones who do must not lose their place if they close it. `userId`
// is set when we know who asked, so the in-app notification can find them; `email` is what
// makes the promise keepable either way.
model HostingWaitlist {
  id         String    @id @default(cuid())
  email      String
  userId     String? // set when the request came from a signed-in account
  wantedGB   Int // how much space they were after — nobody is told about 1 GB when they need 50
  freeTier   Boolean   @default(false) // waiting on the free tier specifically, not on the disk
  createdAt  DateTime  @default(now())
  notifiedAt DateTime? // set once, when they were told; a row is never used twice

  // One open request per address per size. Somebody who asks three times is one person
  // waiting, and a partial unique index is what keeps that true without blocking them from
  // asking again later for a different size, or after being told.
  @@unique([email, wantedGB, freeTier])
  @@index([notifiedAt, wantedGB])
  @@index([userId])
}

// A storage pool for "multi-repo" hosting: the user divides poolBytes across
// several repos. Single-repo hosting doesn't use a group (each repo owns its quota).
model HostingGroup {
  id              String             @id @default(cuid())
  owner           User               @relation(fields: [ownerId], references: [id])
  ownerId         String
  name            String
  // Same provenance flag as ServerRepo.freePlan — a pool provisioned via the $0 Free
  // plan. The Free-pool gauge counts a free pool by its poolBytes (not per-repo), so
  // splitting the pool across repos can't inflate the count.
  freePlan        Boolean            @default(false)
  poolBytes       BigInt             @default(0) // total storage the user can distribute
  color           String             @default("") // owner-chosen accent colour for the dashboard card
  uploadLimitKbps Int                @default(8192) // sandbox upload cap applied to every repo
  cpuShare        Float              @default(0.5)
  // A pool attributed to a team: every member manages what sits in it.
  team            Team?              @relation(fields: [teamId], references: [id])
  teamId          String?
  createdAt       DateTime           @default(now())
  repos           ServerRepo[]
  catalogs        CommunityCatalog[]
  subscriptions   Subscription[] // the pool's hosting subscriptions (>1 once pools are merged)

  @@index([ownerId])
  changes           ChangeEvent[]
}

model Project {
  id             String             @id @default(cuid())
  key            String             @unique
  name           String
  // Per-blog toggle: do this project's posts also surface in the home page's
  // unified "Latest news"? They always show on /blog regardless of this flag.
  showOnHomeNews Boolean            @default(true)
  // Opt-in "Blog" tab on the project's own page, showing only this project's posts.
  showBlogTab    Boolean            @default(false)
  posts          BlogPost[]
  items          CatalogItem[]
  catalogs       CommunityCatalog[]

  // Same visibility gate as ShowcaseProject (see there for the full comment) —
  // applies to every fixed project EXCEPT 'community', which is always public
  // (enforced in projects.mjs, not here, since Prisma can't express a per-row
  // enum exception).
  visibility          String @default("public")
  visibilityWhitelist Json   @default("[]")

  // Same staged-edit mechanism as ShowcaseProject.scheduledNext, but the payload
  // is just `{ config }` — a fixed project's name/key never change.
  scheduledAt   DateTime?
  scheduledNext Json?
}

model BlogPost {
  id                String           @id @default(cuid())
  // A post belongs to exactly one blog "space" — a fixed Project (bmm/bsm/community/
  // installer) OR an admin-created ShowcaseProject ("custom" page). Exactly one of
  // project/showcaseProject is set; enforced in blog.mjs (Prisma can't express an
  // either-or FK constraint directly).
  project           Project?         @relation(fields: [projectId], references: [id])
  projectId         String?
  showcaseProject   ShowcaseProject? @relation(fields: [showcaseProjectId], references: [id])
  showcaseProjectId String?
  author            User             @relation(fields: [authorId], references: [id])
  authorId          String
  title             String
  slug              String           @unique
  excerpt           String           @default("")
  cover             String? // cover image URL
  coverInBody       Boolean          @default(true) // also show the cover at the top of the article body
  body              String // markdown (supports images, embeds, links)
  // Optional French translation. When absent, readers see the base (EN) marked "not translated".
  titleFr           String?
  excerptFr         String?
  bodyFr            String?
  status            PostStatus       @default(DRAFT)
  publishedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Author-configured reactions: on/off + up to 3 reaction types (emoji). The
  // reactions themselves live in BlogReaction (one per user per post).
  reactionsEnabled Boolean        @default(false)
  reactionTypes    String[]       @default([])
  reactions        BlogReaction[]
  // Auto table-of-contents (a "sommaire") rendered from the post's headings.
  showToc          Boolean        @default(false)
  tocTitle         String?
  // Collaborative authoring: extra author user ids beyond `authorId`. Their avatars
  // render at the bottom of the post next to the main author's.
  coAuthorIds      String[]       @default([])
  // Optimistic-concurrency counter — bumped on every content save. A PATCH carrying a
  // stale baseVersion means someone else saved in the meantime → the client 3-way
  // merges (see merge3.js) instead of clobbering.
  version          Int            @default(1)
  revisions        BlogRevision[]
  // Editor-collaboration comments (threaded). `commentsPublic` = readers can also SEE
  // them on the published article (they still can't post — comments are an editor tool).
  comments         BlogComment[]
  commentsPublic   Boolean        @default(false)
  // Set the first time this post is announced to newsletter subscribers, so editing a
  // published post later never re-blasts everyone (see notifyNewsletterOfPost).
  newsletterSentAt DateTime?

  @@index([showcaseProjectId])
}

// A threaded comment on a blog post — an editor-collaboration tool (like a PR review
// comment). Any editor of the post (author / co-author / staff) can read, add, resolve,
// and EDIT any comment (collaborative). `anchor` optionally pins it to a section/line
// label. When the post is `commentsPublic`, readers see them read-only.
model BlogComment {
  id        String   @id @default(cuid())
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  parentId  String? // null = top-level thread; else a reply to this comment id
  anchor    String? // freeform pin label (e.g. a heading or "line 42"); null = general
  body      String
  resolved  Boolean  @default(false)
  // Everyone who has EDITED this comment (collaborative) — their pfps show on it.
  editorIds String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
}

// A snapshot of a blog post's content, captured BEFORE each content save — the edit
// history. Nothing is lost: reverting is just re-saving an old snapshot (which itself
// snapshots the then-current state). Pruned to the most recent N per post.
model BlogRevision {
  id        String   @id @default(cuid())
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  version   Int // the version number this snapshot represents
  title     String
  body      String
  bodyFr    String?
  editorId  String? // who authored this snapshot (may be deleted later)
  createdAt DateTime @default(now())

  @@index([postId, version])
}

// GitBook-style documentation: a flat set of pages grouped into named categories,
// rendered with the doc-block markdown system (md.jsx). Only ADMIN/SUPERADMIN can
// create/edit/reorder/delete pages (the "special role"); everyone can read published
// ones. `order` sorts within a category; categories sort by their pages' min order.
model DocPage {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  // The sidebar entry and the page heading. The body had bodyFr while the TITLE did not, so
  // a fully translated page still appeared under an English name in the French sidebar.
  titleFr        String?
  category       String        @default("General")
  categoryFr     String?
  icon           String? // lucide icon name (see md.jsx ICONS) shown in the sidebar
  body           String        @default("") // markdown w/ doc blocks (EN base)
  bodyFr         String? // optional French translation
  order          Int           @default(0)
  published      Boolean       @default(true)
  // "Was this helpful?" tallies (3-face rating, one vote per browser).
  helpfulYes     Int           @default(0) // 🙂 good
  helpfulOk      Int           @default(0) // 😐 ok
  helpfulNo      Int           @default(0) // 🙁 bad
  updatedAt      DateTime      @updatedAt
  createdAt      DateTime      @default(now())
  // Optimistic-concurrency counter for git-style concurrent editing (see BlogPost.version).
  version        Int           @default(1)
  revisions      DocRevision[]
  // Threaded editor-collaboration comments (see BlogComment). `commentsPublic` lets
  // readers see them read-only on the published page.
  comments       DocComment[]
  commentsPublic Boolean       @default(false)

  @@index([category])
}

// Per-comment edit history (blog + doc comments, polymorphic via `kind`). One row is
// written when a comment is created (v1) and on every body edit, so the full timeline of
// a comment's content — who wrote each version and when — is preserved (nothing lost,
// git-like). Pruned/cascaded manually when the parent comment is deleted.
model CommentRevision {
  id        String   @id @default(cuid())
  commentId String
  kind      String // 'blog' | 'doc'
  body      String
  editorId  String? // who wrote this version
  createdAt DateTime @default(now())

  @@index([commentId])
}

// Threaded comment on a doc page — the same editor-collaboration tool as BlogComment.
// Any docs editor (ADMIN/SUPERADMIN) can read, add, reply, resolve and edit any comment.
model DocComment {
  id        String   @id @default(cuid())
  page      DocPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId    String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  parentId  String?
  anchor    String?
  body      String
  resolved  Boolean  @default(false)
  editorIds String[] @default([]) // everyone who edited this comment — pfps show on it
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId])
}

// Edit-history snapshot of a doc page (see BlogRevision).
model DocRevision {
  id        String   @id @default(cuid())
  page      DocPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId    String
  version   Int
  title     String
  body      String
  bodyFr    String?
  editorId  String?
  createdAt DateTime @default(now())

  @@index([pageId, version])
}

// One reaction per user per post; `type` is one of the post's reactionTypes (emoji).
model BlogReaction {
  id        String   @id @default(cuid())
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  userId    String
  type      String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

// Lets an ADMIN/SUPERADMIN grant a regular USER permission to author blog posts,
// either globally (projectKey and showcaseProjectId both null) or scoped to one
// blog (a fixed Project OR a custom ShowcaseProject page). MOD/ADMIN/SUPERADMIN
// never need a row here — they already pass requireRole('MOD','ADMIN') everywhere
// blog.mjs checks it; this table is purely for extending that ability to USER role.
model BlogPermission {
  id                String      @id @default(cuid())
  user              User        @relation(fields: [userId], references: [id])
  userId            String
  projectKey        String?
  showcaseProjectId String?
  grantedBy         String // admin userId — audit trail only, no relation needed
  createdAt         DateTime    @default(now())

  @@unique([userId, projectKey, showcaseProjectId])
  @@index([userId])
}

// A SUPERADMIN-authored, reusable named bundle of capabilities. Assigning one (or
// several) to a user via User.customRoleIds grants that user every capability in the
// bundle, on top of their built-in role tier and any individual `permissions`. Purely
// additive — a custom role can never REMOVE what the tier already grants. `capabilities`
// holds capability slugs from CAPABILITIES (lib/lib.mjs); unknown slugs are ignored.
model CustomRole {
  id           String   @id @default(cuid())
  name         String   @unique
  // Badge tone shown in the UI: one of the Badge component's tones (primary/amber/green/
  // red/…) — cosmetic only.
  color        String   @default("primary")
  capabilities String[] @default([])
  // A SCOPED role: { projectKeys: [], showcaseIds: [], allShowcase: false }. When set, the
  // role's capabilities are NOT added site-wide; instead the role grants content-edit rights
  // on exactly those elements (like ProjectPermission rows, but reusable and named). Null =
  // the role applies everywhere, as before.
  scope        Json?
  createdBy    String // SUPERADMIN userId — audit trail only
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Per-project EDIT grant, mirroring BlogPermission but for a project's own content/config
// rather than its blog. Exactly one scope is set:
//   • showcaseProjectId → edit that one "other project" (ShowcaseProject)
//   • projectKey        → edit that one fixed Project (bmm/bsm/community/installer)
//   • allShowcase=true  → edit EVERY other project (blanket grant)
// A grantee edits content + config but NOT the reserved controls (pinTopbar, visibility,
// announcement, publish/order) — those require the manage_showcase capability or an
// admin-tier role. Enforced field-by-field in showcase.mjs / projects.mjs.
model ProjectPermission {
  id                String      @id @default(cuid())
  user              User        @relation(fields: [userId], references: [id])
  userId            String
  showcaseProjectId String?
  projectKey        String?
  allShowcase       Boolean     @default(false)
  // WHAT the grant allows on its target: 'pages' (edit the page's content, what a grant always
  // meant) and/or 'studio' (draw its studio pages, PLAN-STUDIO-2026 3.1). The default is the
  // old meaning, so no grant that existed before this column gives the studio.
  rights            String[]    @default(["pages"])
  grantedBy         String // admin userId — audit trail only
  createdAt         DateTime    @default(now())

  @@unique([userId, showcaseProjectId, projectKey, allShowcase])
  @@index([userId])
}

model CatalogItem {
  id             String       @id @default(cuid())
  project        Project      @relation(fields: [projectId], references: [id])
  projectId      String
  kind           CatalogKind
  owner          User         @relation(fields: [ownerId], references: [id])
  ownerId        String
  name           String
  slug           String       @unique
  // Unguessable key for the item's PRIVATE direct link (?k=…). Mirrors Server-Repos:
  // an item that isn't PUBLISHED stays reachable via its own link (owner-shared) but is
  // never in the public list/feed. Public listing requires admin validation (PUBLISHED).
  shareKey       String?      @unique
  description    String       @default("")
  tags           String[]     @default([])
  version        String       @default("1.0.0")
  status         ItemStatus   @default(PENDING)
  payloadKey     String? // object-storage key (the uploaded file/bundle)
  payloadSize    Int          @default(0) // uploaded payload bytes (≤500MB cap fits Int) — counted against the temp submissions margin
  meta           Json         @default("{}") // preset JSON / plugin manifest / etc.
  views          Int          @default(0) // all-time views (1 per item .json fetch)
  downloads      Int          @default(0) // all-time downloads
  deleteAt       DateTime? // scheduled hard-deletion (72h grace); cancellable until then
  // When a rejected submission's payload file is purged to reclaim temp storage. Set on
  // reject (now + hosting.rejectedRetentionDays), cleared if the owner resubmits within
  // the grace (item flips back to PENDING). The sweeper deletes the object + clears
  // payloadKey/Size when this elapses; the REJECTED row itself stays (owner still sees it).
  payloadPurgeAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  submissions    Submission[]

  @@index([deleteAt])
  @@index([payloadPurgeAt])
  // Hot-path indexes for the public browse (/catalog: filter by status, sort by the
  // chosen column) and the BMM-native feed (/catalog.json: status+project+kind, sort
  // by downloads). Without these, both do a seq-scan + in-memory sort as the catalog grows.
  @@index([status, updatedAt])
  @@index([status, downloads])
  @@index([status, views])
  @@index([projectId, kind, status])
}

// Time-stamped catalog events for windowed popularity (e.g. "popular this month").
model CatalogEvent {
  id        String   @id @default(cuid())
  itemId    String
  kind      String // "view" | "download"
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
  @@index([itemId])
}

// A community-hosted catalog — its OWN catalog (unlike the implicit official catalog
// of CatalogItem rows). Two modes: "raw" (owner uploads a BMM-native catalog.json,
// downloads stay self-hosted → ~free) or "managed" (items + payloads on our storage,
// counted against a HostingGroup pool). Storage is fungible with repos via `group`.
// visibility "private" gates the feed + downloads to an access list; bans (in `access`)
// apply even when public. status SUSPENDED (admin) / HIDDEN (unpaid) hide it from all.
model CommunityCatalog {
  id                String                 @id @default(cuid())
  owner             User                   @relation(fields: [ownerId], references: [id])
  ownerId           String
  name              String
  slug              String                 @unique
  description       String                 @default("")
  kinds             String[]               @default([]) // app/plugin/theme/preset sub-feeds exposed
  // Which Better* app this catalog is for. Same optional Project relation CatalogItem
  // uses, rather than a free-text key: a client that must ignore catalogs meant for
  // another app needs an answer it can trust, and a typed relation cannot drift into
  // "BMM" / "bmm" / "Bmm" the way a string column does.
  // Nullable: catalogs created before this existed have no answer, and guessing one
  // would be worse than saying so — the feed omits the app rather than inventing it.
  project           Project?               @relation(fields: [projectId], references: [id])
  projectId         String?
  mode              String                 @default("managed") // "managed" | "raw"
  rawJson           Json? // mode raw: the uploaded BMM-native feed (validated on save)
  status            String                 @default("ACTIVE") // ACTIVE | SUSPENDED (admin) | HIDDEN (unpaid)
  visibility        String                 @default("public") // "public" | "private"
  // Private access + bans (applies to public catalogs too): { ips, emails,
  // accounts:[{type,id}], bans:{ ips, emails, accounts } }. Mirrors the repo sandbox
  // shape; matched against the server-resolved identity (see resolveIdentity).
  access            Json?
  /// Optional download password, argon2 hash. Null / empty = no password — the same
  /// contract as ServerRepo.syncPasswordHash, deliberately: BMM sends `X-Repo-Password`
  /// (or `?password=`) and reads a 401 as "this needs a password". Reusing the repo
  /// contract means the client needed no new vocabulary for catalogs.
  ///
  /// Hashed rather than stored in clear because it is a user-chosen secret. The gate
  /// keeps a short-lived verification cache so argon2 is paid once per client per
  /// window, not once per request.
  syncPasswordHash  String?
  shareKey          String?                @unique // owner's private direct link (?k=…)
  listed            Boolean                @default(true) // in the public browser (never true if private)
  featuredUntil     DateTime? // paid promotion
  freePlan          Boolean                @default(false) // provisioned via the $0 free catalog plan
  group             HostingGroup?          @relation(fields: [groupId], references: [id])
  groupId           String?
  team              Team?                  @relation(fields: [teamId], references: [id])
  teamId            String?
  contactEmail      String?
  contactPhone      String?
  storageQuotaBytes BigInt                 @default(0) // dedicated alloc when not in a pool
  storageUsedBytes  BigInt                 @default(0)
  views             Int                    @default(0)
  downloads         Int                    @default(0)
  deleteAt          DateTime? // 72h grace, e.g. after a failed payment
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  items             CommunityCatalogItem[]
  favorites         CatalogFavorite[]
  domain            CustomDomain?
  changes           ChangeEvent[]
  accessEvents      CatalogAccessEvent[]

  @@index([ownerId])
  @@index([status, listed])
  @@index([deleteAt])
  /// Declared late. The 20260814380000_catalog_project migration created this index in raw
  /// SQL without adding it here, so the schema and the migration history disagreed — and
  /// the next `migrate diff` proposed DROPPING it, because a diff believes the schema. It
  /// backs the `?app=` filter on the catalogue feeds, which is the query it was added for.
  @@index([projectId])
}

// Consumer-side access to a community catalog, the exact counterpart of RepoAccessEvent:
// a feed fetch (kind='connect' — a BMM client connected/synced) or an item download
// (kind='download'). It exists because a catalog only ever kept two lifetime counters
// (views/downloads), and a counter cannot answer "who is pulling this right now" — which
// is the question the repo traffic view answers and the one being asked of catalogs.
//
// Deliberately NOT a copy of RepoAccessEvent's `accessKey` column. A repo's ?key= is a
// sandbox access key the owner hands out and wants to see in their own dashboard; a
// catalog's ?k= is its PRIVATE SHARE LINK — a bearer secret whose whole value is that it
// was never written down anywhere readable (CWE-532). So the only thing kept about it is
// whether one was used at all, decided with safeEqual, never stored and never returned.
//
// `path` is a stored relative path ('catalog.json', or an item slug), never a request URL:
// a URL carries the query string, and the query string is the secret.
// One row per mail the platform tried to send: the "see every e-mail sent" screen.
//
// Written by lib/mail.mjs sendMail (through lib/mail-log.mjs), the one function every mail
// goes through, whether it was delivered, refused by the transport, or skipped because
// mail is switched off. Fire-and-forget: a failed log write never fails a mail.
//
// NO BODY IS STORED, on purpose. Bodies carry the secrets a mail exists to deliver (a
// verification link, a password-reset token, a gift code, a data export). What is kept is
// the template id (`mailId`, the gallery's key), the subject with anything link- or
// token-shaped replaced, and the transport's error text redacted the same way.
//
// `to` is the full address: the list masks it, and only a reader holding manage_users (who
// can already read every account's address) is sent it whole. `userId` is set when the
// address belonged to an account at send time, so account erasure removes the rows.
// Retention: 90 days AND at most 20 000 rows, pruned opportunistically (lib/mail-log.mjs).
model MailLog {
  id          String   @id @default(cuid())
  to          String
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mailId      String   @default("")
  subject     String   @default("")
  status      String // sent | failed | disabled
  error       String?
  attachments Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([mailId, createdAt])
  @@index([userId])
}

model CatalogAccessEvent {
  id        String           @id @default(cuid())
  catalog   CommunityCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  catalogId String
  ip        String
  keyed     Boolean          @default(false) // the client presented the valid private share key
  userId    String? // resolved via X-Creator-ID -> CreatorLink (or the browser session), if linked
  discordId String? // that same account's DiscordLink, if any
  path      String
  kind      String // connect | download
  createdAt DateTime         @default(now())

  @@index([catalogId, createdAt])
  // The global/pool views ask "everything in the last 15 minutes" across many catalogs, so
  // they filter on createdAt with no catalogId — which the composite index above cannot
  // serve. RepoAccessEvent has the same query and lacks this; see the traffic lib's note.
  @@index([createdAt])
}

// One item in a "managed" community catalog (payloads on our storage). Raw catalogs
// don't use this — their entries live inline in CommunityCatalog.rawJson.
model CommunityCatalogItem {
  id          String           @id @default(cuid())
  catalog     CommunityCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  catalogId   String
  kind        CatalogKind
  name        String
  slug        String // unique within its catalog
  version     String           @default("1.0.0")
  description String           @default("")
  tags        String[]         @default([])
  payloadKey  String? // object-storage key
  payloadSize Int              @default(0)
  downloads   Int              @default(0)
  meta        Json             @default("{}")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([catalogId, slug])
  @@index([catalogId])
}

model Submission {
  id         String              @id @default(cuid())
  item       CatalogItem         @relation(fields: [itemId], references: [id])
  itemId     String
  owner      User                @relation(fields: [ownerId], references: [id])
  ownerId    String
  type       SubmissionType      @default(NEW)
  status     ItemStatus          @default(PENDING)
  reviewerId String?
  reason     String? // rejection reason -> sent to the user
  tags       String[]            @default([]) // mod-only triage tags (e.g. "priority", "needs-rework") — never shown to the submitter
  comments   SubmissionComment[]
  createdAt  DateTime            @default(now())
}

// Mod-only internal note on a submission (max 200 chars, enforced in catalog.mjs) —
// a quick heads-up between moderators during review, never shown to the submitter.
model SubmissionComment {
  id           String     @id @default(cuid())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId String
  author       User       @relation(fields: [authorId], references: [id])
  authorId     String
  body         String
  createdAt    DateTime   @default(now())

  @@index([submissionId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  kind      String
  // English body. The same convention as SiteReview below: one row carries both
  // languages and the client shows the one matching the active locale.
  body      String
  // French body. Null for the notifications written from a single string (billing,
  // moderation); the client falls back to `body`, which is what it always showed.
  //
  // Added because the event broadcast had no way to express a per-user language and
  // shipped ONE row reading "Bientôt / Upcoming: …" to everybody — the only surface in
  // the app that did that.
  bodyFr    String?
  // Where clicking it goes. An in-app path ("/dashboard#transfers"), never an absolute URL:
  // a notification is written by the server and rendered as a link, so allowing an arbitrary
  // origin here would make any code path that can notify a user also able to send them
  // anywhere. The renderer refuses anything that does not start with a single "/".
  //
  // Null for the notifications that are genuinely just a statement ("your password changed").
  // Most were not: "you have been offered a transfer — accept or decline it in your profile"
  // named a destination in prose and made the reader go and find it.
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

// Admin-curated testimonials/reviews shown on the landing page. The admin provides the
// list from the dashboard; each carries an English AND a French body (the client shows
// the one matching the active locale), and can be individually disabled. The whole
// section can also be turned off via the `reviews.enabled` admin setting.
model Review {
  id        String   @id @default(cuid())
  author    String
  role      String   @default("") // subtitle: role / handle / "BMM user"
  body      String // English
  bodyFr    String   @default("") // French (falls back to `body` when empty)
  rating    Int? // optional 1..5 stars
  avatar    Json? // { variant, seed, colors } Boring-avatar, or { image }
  enabled   Boolean  @default(true)
  order     Int      @default(0)
  /// M11: set when a member posted it (null = written by staff in the admin). One per account;
  /// deleting the account deletes the review.
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// approved (shown when enabled) | pending (a member's, waiting for a moderator) | rejected.
  /// Staff-written rows are approved, which is what every existing row becomes.
  status    String   @default("approved")
  /// The language the member wrote in; the admin can add the other translation on approval.
  lang      String   @default("en")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, order])
  @@index([status])
}

// Site-wide banner announcements. Publishing one also broadcasts a Notification to
// every user (see announcements.mjs) — the banner is the persistent/dismissible
// form, the notification is the "you have something new" ping in the bell menu.
model Announcement {
  id         String    @id @default(cuid())
  title      String
  body       String
  tone       String    @default("info") // info | warning | success
  active     Boolean   @default(true)
  // Every active announcement always sends a Notification (bell). This controls
  // ONLY the dismissible top-of-site banner — off for a "quiet" announcement that
  // should just land in people's notifications without also plastering the site.
  showBanner Boolean   @default(true)
  // Where the banner navigates on click — an internal path (e.g. "/blog/my-post")
  // or a full external URL. Null/empty = banner isn't clickable, just the dismiss X.
  linkUrl    String?
  createdBy  String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?

  @@index([active])
}

model HostingPlan {
  id                   String         @id @default(cuid())
  name                 String
  // GB, stored as a float so a plan (or an admin service cap) can be set below 1 GB — the
  // Hosting-settings UI lets an admin enter MB / GB / TB and converts to this canonical GB
  // value, so the unit choice is never itself stored. Was Int, which silently could not hold
  // the sub-GB "custom"/renewal plans that repos.mjs and stripe-webhook.mjs already create.
  storageGB            Float
  uploadLimitKbps      Int
  cpuShare             Float          @default(0.25)
  priceMonthlyCents    Int
  active               Boolean        @default(true)
  // A price change that has been ANNOUNCED but is not in force yet.
  //
  // The Payments policy promises advance notice and "the new price applies from your
  // next renewal, never to a period already paid for". Editing priceMonthlyCents
  // directly cannot keep that promise: it changes the price the instant Save is pressed,
  // with nobody told. So an increase is staged here, subscribers are emailed at the
  // moment it is scheduled, and the sweeper swaps it in on the day.
  pendingPriceCents    Int?
  pendingPriceAt       DateTime?
  // When the announcement went out, and to how many — so the same change is never
  // announced twice, and so the record of "we did give notice" outlives the mailbox.
  pendingNoticeAt      DateTime?
  pendingNoticeCount   Int            @default(0)
  // Does the announced change touch people who are ALREADY subscribed?
  //
  // false (the default, and what happens today whether anyone intended it or not): each
  // Stripe subscription is pinned to its own ad-hoc Price created at checkout, so a new
  // plan price only ever reaches NEW buyers. Existing subscribers are grandfathered by
  // the payment model itself, not by a decision.
  //
  // true: on the effective date their Stripe subscription item is moved onto a new Price
  // with proration_behavior 'none', so the new amount starts at their next renewal and
  // nobody is charged mid-term. That is the same promise the notice email makes.
  pendingApplyExisting Boolean        @default(false)
  subscriptions        Subscription[]

  @@index([pendingPriceAt])
  /// Boosts that come WITH the plan: `boostsPerPeriod` credits granted every
  /// `boostPeriodMonths` months, each worth `boostDays` days of being featured. Zero (the
  /// default) means the plan includes none, which is what every existing plan had before
  /// this column existed -- so the default has to be the no-op.
  boostsPerPeriod   Int      @default(0)
  boostPeriodMonths Int      @default(1)
  boostDays         Int      @default(7)
}

model ServerRepo {
  id                String            @id @default(cuid())
  owner             User              @relation(fields: [ownerId], references: [id])
  ownerId           String
  name              String
  hosted            Boolean           @default(false)
  // TRUE only when provisioned through the actual $0 Free plan (the FreeTierClaim
  // checkout path). Admin-provisioned and promo-granted repos stay false — they must
  // NOT count against the Free-plan pool cap (the "70/10 GB while empty" bug).
  freePlan          Boolean           @default(false)
  status            RepoStatus        @default(OFFLINE)
  publicUrl         String?
  region            String?
  storageQuotaBytes BigInt            @default(0)
  storageUsedBytes  BigInt            @default(0)
  uploadLimitKbps   Int               @default(0) // OUR limit (overrides the author's) when hosted
  cpuShare          Float             @default(0.25)
  seed              String?
  // Public listing + content verification.
  description       String            @default("")
  tags              String[]          @default([])
  links             Json? // { discord, website, changelog } shown on the listing
  repoUrl           String? // source URL for a non-hosted, listed repo
  sha               String? // current content SHA (integrity of last verified content)
  // Listed by default — you opt OUT. The common case is a repo made for people to use;
  // the old opt-in meant it stayed invisible until the owner found a menu item they had no
  // reason to look for. repos.json still also requires `verified`, so a moderator check is
  // unchanged. Existing rows keep whatever they had (see the migration).
  listed            Boolean           @default(true)
  verified          Boolean           @default(false) // content checked by a mod/admin
  pendingReview     Boolean           @default(false) // a change is awaiting verification
  // Unlisted-share link: when set, anyone with /r/<id>?k=<shareKey> can see the repo's
  // public page even though it isn't in the browse list (mirrors CommunityCatalog.shareKey).
  shareKey          String            @default("")
  /// Optional download password, argon2 hash. Null / empty = no password, matching BMM's
  /// own mini-server, which treats a blank password as "not required".
  ///
  /// The CLIENT contract is fixed and predates this column: BMM sends `X-Repo-Password` on
  /// EVERY file request (there is no token exchange), and accepts `?password=` too because
  /// a browser cannot set a header. See repo_server.rs in the BMM repo — matching it means
  /// a password-protected repo hosted here needs no client change at all.
  ///
  /// Stored hashed rather than in clear because it is a user-chosen secret. Verifying
  /// argon2 on every file of a sync would be crippling, so the hot path is a short-lived
  /// in-memory verification cache (see hosting-content.mjs); the slow hash is paid once
  /// per client per window.
  syncPasswordHash  String?
  // Admin-set classification for the public browser: "community" (default),
  // "official" (maintained by the BMM team — green badge) or "partner" (trusted
  // community members — blue badge). Official/partner float to the top of the list.
  category          String            @default("community")
  featuredUntil     DateTime? // paid promotion expiry (listing boost)
  // Hosted-content publishing (for repos we host): admin validates → repo.json served.
  hostPath          String?           @unique // "<ownerSlug>/<repoSlug>" for the public URL
  published         Boolean           @default(false)
  repoJson          Json? // parsed manifest of the uploaded repo.json
  // Sandboxed, owner-managed settings: bans, whitelist, requested upload limit.
  // Requested values are always clamped to the hard sandbox caps on this row.
  settings          Json? // { access:{whitelistEnabled,ips,keys}, bans:{ips,keys}, requestedUploadKbps }
  // Dedicated dashboard access control. The owner (or an ADMIN) always has access.
  // Others get in either by being a logged-in user whose email is in accessEmails,
  // or by entering dashPassword (login-less, mints a short-lived per-repo cookie).
  accessEmails      String[]          @default([]) // authorized collaborator emails
  dashPassword      String? // argon2 hash of the dashboard password (null = disabled)
  group             HostingGroup?     @relation(fields: [groupId], references: [id])
  groupId           String?
  // A team manages it alongside the owner (see routes/teams.mjs). Contact details for a
  // repo served from the owner's own server: the e-mail is required there, the phone is not.
  team              Team?             @relation(fields: [teamId], references: [id])
  teamId            String?
  contactEmail      String?
  contactPhone      String?
  deleteAt          DateTime? // scheduled hard-deletion (72h grace, e.g. after a failed payment)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  subscription      Subscription?
  files             RepoFile[]
  auditLogs         RepoAuditLog[]
  accessEvents      RepoAccessEvent[]
  favorites         RepoFavorite[]
  agent             RepoAgent?
  domain            CustomDomain?
  changes           ChangeEvent[]

  @@index([groupId])
  @@index([deleteAt])
  // Public list (/repos): the exact filter + sort of the community repo browser, so it
  // doesn't seq-scan every repo to find the listed + verified ones.
  @@index([listed, verified, pendingReview, createdAt])
}

/// A server the OWNER runs, allowed to talk to us on this repo's behalf.
///
/// The ask was "let me manage a repo on another server from BCWEB", and the obvious shape
/// for that is an SSH key. We do not take one. A private key that opens a shell on somebody
/// else's machine is the worst possible thing to hold: a breach here would stop costing
/// accounts and start costing our users their servers, and it puts us inside every incident
/// they ever have.
///
/// So the direction is reversed. Their machine holds a credential for US, not the other way
/// round: a bearer token, hashed here exactly like an ApiKey, that lets their box say "I am
/// alive, here is what I am serving" and pick up a job the owner queued from the dashboard.
/// Nothing here can reach into their server; revoking is one row.
///
/// Deliberately ONE per repo (repoId is unique). Rotating replaces it, which is the whole
/// vocabulary an owner needs — a list of five tokens for one machine is a list of four
/// things nobody remembers issuing.
model RepoAgent {
  id           String     @id @default(cuid())
  repo         ServerRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)
  repoId       String     @unique
  /// The owner's name for the machine. Cosmetic.
  label        String     @default("")
  /// First characters of the secret, in clear, so the owner can recognise it in the panel
  /// without it being usable. Same trick as ApiKey.prefix.
  prefix       String
  hash         String     @unique
  createdAt    DateTime   @default(now())
  revokedAt    DateTime?
  /// What the agent last told us about itself. All self-reported: it is the owner's own
  /// machine describing itself, so it is displayed and never trusted for a decision.
  lastSeenAt   DateTime?
  lastIp       String?
  agentVersion String?
  hostLabel    String?
  /// A ONE-SLOT job queue. The owner presses "resync"; the agent picks it up on its next
  /// call and reports back. One slot rather than a real queue because pressing the button
  /// four times means "do it", not "do it four times".
  pendingCmd   String?
  pendingAt    DateTime?
  /// The last report. Counts only -- we do not hold the files, and saying otherwise on a
  /// repo we do not host would be the panel lying about where the content is.
  reportedAt   DateTime?
  reportOk     Boolean    @default(false)
  reportError  String?
  fileCount    Int?
  totalBytes   BigInt?
  manifestSha  String?
}

/// A hostname the owner controls, served by us.
///
/// This is a certificate-issuance decision before it is a routing one: the edge asks us
/// whether a host is allowed before obtaining a certificate for it, so a row here is
/// permission to spend a real resource on somebody else's name. Hence: proof of control
/// (a TXT record) before `verifiedAt` is set, and a paid pool as the product gate — both
/// re-checked at the point of USE, because a pool that lapses must stop being a reason to
/// keep renewing a certificate.
///
/// Exactly one of repoId / catalogId is set. Two nullable unique columns rather than a
/// polymorphic (type, id) pair, because the database can then enforce "one domain per repo"
/// and "one domain per catalogue" itself instead of trusting every writer to.
model CustomDomain {
  id            String            @id @default(cuid())
  /// Lowercased, no trailing dot, no port -- normaliseHost() in lib/domain.mjs is the one
  /// place that decides what this string looks like.
  host          String            @unique
  owner         User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId       String
  repo          ServerRepo?       @relation(fields: [repoId], references: [id], onDelete: Cascade)
  repoId        String?           @unique
  catalog       CommunityCatalog? @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  catalogId     String?           @unique
  /// The value the owner publishes at _bcw-verify.<host>. Per domain, so removing one does
  /// not invalidate a record already published for another.
  verifyToken   String
  verifiedAt    DateTime?
  lastCheckedAt DateTime?
  /// Why the last check failed, for the panel. Never a raw resolver error object.
  lastError     String?
  createdAt     DateTime          @default(now())

  @@index([ownerId])
}

/// One entry in the history of a repo, a catalogue or a storage pool.
///
/// There was already a per-repo audit log, and it had the weakness every audit log has: a
/// free-text `detail`, so the most common row on the platform read "sandbox settings updated".
/// True, useless, and unanswerable -- the person reading it wants to know WHICH setting and
/// what it was before. That difference is what `changes` holds: [{ field, from, to }], built
/// by diffFields() in lib/changelog.mjs, which is also the one place that decides what must
/// never appear in it.
///
/// Deliberately not file-content versioning. Keeping every version of every uploaded file is a
/// different product with a storage bill; this records THAT a file changed, with its size and
/// checksum, which is what lets somebody find when something moved.
model ChangeEvent {
  id         String            @id @default(cuid())
  /// Exactly one subject. Three nullable columns rather than a (type, id) pair so the foreign
  /// keys are real and a deleted repo takes its history with it.
  repo       ServerRepo?       @relation(fields: [repoId], references: [id], onDelete: Cascade)
  repoId     String?
  catalog    CommunityCatalog? @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  catalogId  String?
  group      HostingGroup?     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId    String?
  /// Who. The id for linking, and the LABEL frozen at write time -- joining the name on read
  /// would rename people retroactively through the whole history the day they change it, and
  /// a history that rewrites itself is not one.
  actorId    String?
  actorLabel String            @default("")
  action     String
  summary    String            @default("")
  changes    Json?
  createdAt  DateTime          @default(now())

  @@index([repoId, createdAt])
  @@index([catalogId, createdAt])
  @@index([groupId, createdAt])
}

/// One included boost, granted by a plan and not yet spent.
///
/// A ledger rather than a counter on the subscription, because "you have 2 boosts" answers
/// nothing when somebody asks where they went: each row says which period granted it, when it
/// expires, and what it was spent on. A counter would have to be adjusted by every writer and
/// would drift the first time one of them failed halfway.
///
/// Spendable on a REPO or a CATALOGUE. Both already sort their public listing by
/// featuredUntil, so a boost on either has always worked -- what did not exist was any way to
/// apply one to a catalogue.
model BoostCredit {
  id             String        @id @default(cuid())
  owner          User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId        String
  /// Which subscription granted it. Null for a credit an admin handed out by hand.
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  subscriptionId String?
  planId         String?
  days           Int           @default(7)
  /// The period this was granted FOR, and its index within that period. Unique together with
  /// the subscription, which is what makes granting idempotent: a sweeper that runs twice, or
  /// two containers running it at once, cannot mint the same credit twice.
  periodStart    DateTime
  seq            Int           @default(0)
  /// Use it or lose it, at the next grant. A credit that never expires turns a monthly perk
  /// into a savings account, and a year of them arriving at once is not what was sold.
  expiresAt      DateTime?
  usedAt         DateTime?
  usedRepoId     String?
  usedCatalogId  String?
  createdAt      DateTime      @default(now())

  @@unique([subscriptionId, periodStart, seq])
  @@index([ownerId, usedAt])
}

// A user starring a Server-Repo on the public list — purely social (visibility
// into how liked a repo is), not an access grant of any kind.
model RepoFavorite {
  id           String     @id @default(cuid())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  repo         ServerRepo @relation(fields: [serverRepoId], references: [id], onDelete: Cascade)
  serverRepoId String
  createdAt    DateTime   @default(now())

  @@unique([userId, serverRepoId])
  @@index([serverRepoId])
}

// The same, for a community catalog. Mirrors RepoFavorite exactly (same shape, same
// semantics: purely social, never an access grant) so the two can be listed together on the
// member's Favourites tab without special-casing either.
model CatalogFavorite {
  id        String           @id @default(cuid())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  catalog   CommunityCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  catalogId String
  createdAt DateTime         @default(now())

  @@unique([userId, catalogId])
  @@index([catalogId])
}

// A file uploaded to a hosted Server-Repo (counted against the storage quota).
// Stored in object storage; NEVER executed — only listed/served as bytes.
model RepoFile {
  id           String     @id @default(cuid())
  repo         ServerRepo @relation(fields: [serverRepoId], references: [id], onDelete: Cascade)
  serverRepoId String
  path         String // logical path within the repo (e.g. "repo.json", "mods/x.zip")
  key          String // object-storage key
  size         BigInt     @default(0)
  contentType  String     @default("application/octet-stream")
  sha256       String? // content checksum (computed at upload) — shown in the manager
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([serverRepoId, path])
}

// Per-repo activity log for the dedicated dashboard: who did what (uploads, deletes,
// publish/offline, settings + access changes). Actor is a display label (owner name,
// collaborator email, or "password access") — no auth material is stored.
model RepoAuditLog {
  id           String     @id @default(cuid())
  repo         ServerRepo @relation(fields: [serverRepoId], references: [id], onDelete: Cascade)
  serverRepoId String
  actor        String
  action       String // upload | delete | publish | unpublish | settings | access | ban | unban
  detail       String     @default("")
  createdAt    DateTime   @default(now())

  @@index([serverRepoId, createdAt])
}

// Consumer-side access to a published repo (BMM clients syncing it): a manifest fetch
// (kind='connect' — an import/connect) or a file fetch (kind='download'). Powers the
// dashboard's Users/Traffic view + who's connected, so the owner can ban IPs/keys.
model RepoAccessEvent {
  id           String     @id @default(cuid())
  repo         ServerRepo @relation(fields: [serverRepoId], references: [id], onDelete: Cascade)
  serverRepoId String
  ip           String
  accessKey    String? // the ?key= the client sent (sandbox access key), if any
  userId       String? // resolved via the X-Creator-ID header -> CreatorLink, if linked
  discordId    String? // resolved via that same account's DiscordLink, if linked
  path         String
  kind         String // connect | download
  createdAt    DateTime   @default(now())

  @@index([serverRepoId, createdAt])
  // Added with the pool/global traffic views. The composite index above is useless to a
  // query that asks for "everything in the last 15 minutes" without naming a repo — which
  // is what /admin/repos/traffic has always done, and what the pool views now do too.
  @@index([createdAt])
}

// A single, admin-managed access policy applied identically to EVERY hosted repo, on
// top of (never instead of) each repo's own per-repo settings.access/settings.bans:
// bans here block a client everywhere; the whitelist here is unioned with a repo's own
// whitelist when either the repo or `whitelistOnly` (site-wide) requires one. Entries
// in the account lists are { type: "bcweb"|"discord", id, label }. Singleton row
// (id is always "global") — read/written via GET/PUT /admin/access-policy.
// What the platform costs to run, so revenue can be read against something.
//
// The admin screen showed MRR and nothing else, which answers "how much comes in" and leaves
// the only question that matters — whether it covers the bills — to a spreadsheet somebody
// keeps elsewhere and forgets to update.
//
// Amounts are integer CENTS, like every other money column here. Floats and money do not mix:
// 0.1 + 0.2 is not 0.3, and a rounding error in a total is the kind of bug nobody reports
// because everybody assumes they misread it.
model Expense {
  id          String    @id @default(cuid())
  label       String
  /// hosting · domain · service · software · hardware · fees · tax · other
  category    String    @default("other")
  amountCents Int
  /// ISO 4217. Stored per row rather than converted on the way in: converting at entry
  /// bakes in that day's rate and loses what was actually paid.
  currency    String    @default("CHF")
  /// none · monthly · yearly. A recurring cost is counted every month it applies to, not
  /// only in the month it was entered.
  recurring   String    @default("none")
  /// When it applies from. For a recurring cost this is the start, not a single date.
  incurredAt  DateTime  @default(now())
  /// Set on a recurring cost that has stopped, so history stays intact rather than being
  /// deleted — last month's numbers must not change because a subscription ended today.
  endedAt     DateTime?
  note        String    @default("")
  createdById String?
  createdBy   User?     @relation("ExpenseAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([incurredAt])
  @@index([category])
}

// A published, frozen copy of one legal document.
//
// This exists because `User.termsAcceptedAt` records WHEN somebody accepted and never WHAT.
// While the text lived in the source that was survivable — git held the history. Now that it
// is editable from the dashboard, a timestamp pointing at a mutable document proves nothing:
// in a dispute you could not produce the text the person actually agreed to.
//
// So publishing snapshots the whole document into `sections` and hands it a number. The
// number is what gets recorded against an acceptance, and the snapshot is what gets shown
// when somebody asks what they agreed to. Nothing here is ever edited — a correction is a
// new version, which is the entire point.
model LegalVersion {
  id                 String   @id @default(cuid())
  /// privacy · terms · cookies · about · refunds
  doc                String
  /// 1, 2, 3 … per document. Human-quotable, unlike a cuid.
  version            Int
  /// The full document at publish time: [{ title, titleFr, body, bodyFr }]. Denormalised on
  /// purpose — a snapshot that joins to live rows is not a snapshot.
  sections           Json
  /// Why this version exists, for the reader, not for staff. Shown in the archive.
  note               String   @default("")
  /// Whether this change is one people must agree to again. Separate from merely notifying
  /// them: demanding agreement interrupts everybody, so it is only right when the change
  /// actually alters what they agreed to.
  requiresAcceptance Boolean  @default(false)
  publishedAt        DateTime @default(now())
  publishedById      String?
  publishedBy        User?    @relation("LegalPublisher", fields: [publishedById], references: [id], onDelete: SetNull)

  @@unique([doc, version])
  @@index([doc, publishedAt])
}

// One section of one legal document, editable from the admin dashboard.
//
// The built-in LEGAL constant in legal.jsx stays the DEFAULT and is what a fresh install
// serves: no rows here means the page renders exactly as it always has. Rows are created by
// importing those defaults from the dashboard, and from then on the database wins for that
// document. A half-migrated state is therefore impossible — it is per document, all or
// nothing, because a policy assembled from two sources is a policy nobody can diff.
//
// `body` is markdown with the same block directives as the docs and blog (md.jsx), so a
// legal page can use callouts and steps without a second renderer being written for it.
/// A heading in the legal index. "BetterModsManager", "BetterSoundMaker", "The platform" —
/// whatever this deployment needs. Optional: a page with no category is listed on its own.
model LegalCategory {
  id        String      @id @default(cuid())
  /// A slug, so a category can be linked to: /legal#bmm
  key       String      @unique
  label     String
  labelFr   String?
  order     Int         @default(0)
  createdAt DateTime    @default(now())
  pages     LegalPage[]

  @@index([order])
}

/// One legal document. Five ship with the app; the rest are created here.
///
/// `key` is the URL segment AND the value of `LegalSection.doc`. That join is by key and not
/// by foreign key on purpose — every section written before this table existed already holds
/// one, and a constraint would mean either rewriting live rows or refusing to migrate.
model LegalPage {
  id         String         @id @default(cuid())
  key        String         @unique
  label      String
  labelFr    String?
  summary    String         @default("")
  summaryFr  String         @default("")
  /// Any name IconGlyph resolves. Empty falls back to the built-in document icon.
  icon       String         @default("")
  order      Int            @default(0)
  /// The five that ship in the web bundle. Renameable, recategorisable, reorderable — not
  /// deletable: their text has a compiled-in fallback, so removing the row would leave the
  /// page rendering that fallback with no menu entry pointing at it.
  builtIn    Boolean        @default(false)
  /// Hidden without being deleted. A policy that does not apply yet is not one that never
  /// existed, and the archive still has to resolve its versions.
  published  Boolean        @default(true)
  categoryId String?
  category   LegalCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([categoryId, order])
}

model LegalSection {
  id          String   @id @default(cuid())
  /// A LegalPage.key — privacy · terms · cookies · about · refunds, and whatever else has
  /// been created since.
  doc         String
  title       String
  titleFr     String?
  body        String   @default("")
  bodyFr      String?
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([doc, order])
}

// An address that may not be listed again.
//
// The Terms promise this in "Listings that point somewhere else": when an item is only a
// LINK, taking the listing down is most of what we can do, and the rest is stopping the same
// address being posted straight back. Matching lives in lib/urlblock.mjs and is deliberately
// dull — an exact address, or a host and everything under it. No wildcards: somebody refused
// a link is owed a rule they can read.
model BlockedUrl {
  id          String          @id @default(cuid())
  /// 'domain' — the host and every subdomain · 'url' — that exact address, path and query
  scope       String          @default("domain")
  /// An EXCEPTION rather than a rule: an allow entry beats every block entry, whichever is
  /// more specific. Deliberately not a specificity contest — an allowed address is allowed,
  /// which is a sentence somebody can hold while deciding whether to add one.
  allow       Boolean         @default(false)
  /// Stored normalised (lowercase, no www., no trailing slash) so a duplicate cannot be
  /// added in a different spelling and read as a second, different rule.
  pattern     String
  /// Shown to staff, never to the person refused: it can name a complainant.
  reason      String          @default("")
  /// The notice this came from, when it came from one. Nullable because an admin may block
  /// something they found themselves, and SetNull so deleting a message never deletes the
  /// protection that message caused.
  noticeId    String?
  notice      ContactMessage? @relation(fields: [noticeId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  /// How often it actually caught something. A rule with zero hits after a year is a rule to
  /// re-read, and a rule with thousands is worth telling somebody about.
  hits        Int             @default(0)
  lastHitAt   DateTime?
  createdAt   DateTime        @default(now())

  @@unique([scope, pattern])
  @@index([createdAt])
}

model GlobalAccessPolicy {
  id                String   @id @default("global")
  whitelistOnly     Boolean  @default(false) // forces whitelist-only mode on ALL repos
  whitelistIps      String[] @default([])
  whitelistKeys     String[] @default([])
  whitelistAccounts Json     @default("[]")
  bannedIps         String[] @default([])
  bannedKeys        String[] @default([])
  bannedAccounts    Json     @default("[]")
  updatedAt         DateTime @updatedAt
}

// Same shape as GlobalAccessPolicy, but owner-managed and scoped to only THAT
// owner's own hosted repos (one row per user, on top of both the repo's own
// settings AND the site-wide GlobalAccessPolicy — see hosting-content.mjs).
model UserAccessPolicy {
  userId            String   @id
  whitelistOnly     Boolean  @default(false)
  whitelistIps      String[] @default([])
  whitelistKeys     String[] @default([])
  whitelistAccounts Json     @default("[]")
  bannedIps         String[] @default([])
  bannedKeys        String[] @default([])
  bannedAccounts    Json     @default("[]")
  updatedAt         DateTime @updatedAt
}

// Every login attempt against /auth/login, success or failure — powers the admin
// security log (login attempts, IPs hitting the panel) and basic abuse review.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  success   Boolean
  reason    String? // "bad_password" | "2fa_required" | "2fa_invalid" | "ok"
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([ip, createdAt])
}

// A general admin/staff action audit trail — wired into the highest-value mutation
// points (role changes, access-policy edits, server-control actions), not every
// single endpoint (that would be a much larger retrofit for marginal benefit).
model AuditLogEntry {
  id        String   @id @default(cuid())
  actor     User     @relation(fields: [actorId], references: [id])
  actorId   String
  action    String
  detail    String   @default("")
  ip        String   @default("")
  createdAt DateTime @default(now())
  // Tamper-evidence: each entry is HMAC-signed (server secret) over its own fields +
  // the previous entry's hash, forming a chain. Editing any field breaks that row's
  // HMAC; deleting/inserting a row breaks the next row's `prevHash` linkage. A
  // compromised staff account therefore can't silently rewrite history. Verified via
  // GET /admin/security/audit/verify. ("" on legacy rows written before this landed.)
  prevHash  String   @default("")
  hash      String   @default("")

  @@index([createdAt])
}

// A periodic sample of this host's own resource usage (see server-monitor.mjs's
// sweeper tick) — builds the history behind the perf dashboard's graphs/uptime.
model ServerMetricSample {
  id        String   @id @default(cuid())
  cpuPct    Float
  memPct    Float
  diskPct   Float
  loadAvg1  Float
  uptimeSec Int
  latencyMs Int?
  netRxKbps Int? // avg download throughput over the tick (kbit/s)
  netTxKbps Int? // avg upload throughput over the tick (kbit/s)
  // WHO wrote this sample (os.hostname()). Every metric here is "the host as this process
  // sees it" — and two processes on different machines sharing one database (a dev machine
  // pointed at the prod DB, an old container beside a new one) interleave into a single
  // series. The dashboard then draws a sawtooth alternating between two real machines, which
  // reads as a haunted server. Default '' so three weeks of pre-column history stays valid.
  host      String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// A fired threshold alert (CPU/RAM/disk/service-down) — the persistent form of
// what also gets pushed to Discord + surfaced live in the admin dashboard.
/// One moderation decision, with a reference you can quote.
///
/// Before this, a sanction was a handful of columns on User (status/moderationUntil/
/// moderationReason) — which meant only ONE could exist, nothing could be said about a repo
/// or a catalog item, and a person told "your account was suspended" had no number to put in
/// a reply. A record with a `code` is what turns moderation into something you can appeal
/// against: both sides are talking about the same decision.
///
/// The account columns on User stay: they are the fast path every request reads. This is the
/// history and the paperwork, not the lock itself.
model Sanction {
  id    String @id @default(cuid())
  /// SNC-XXXX-XXXX. Quoted in the e-mail, searchable in the admin, given by the user when
  /// they contest. Unique so it can be looked up directly.
  code  String @unique
  /// warning · suspension · ban · closure · takedown
  kind  String
  /// account · content — what the decision is really about, which decides what lifting it does.
  scope String @default("account")

  /// The person answerable for it, ALWAYS set — including for a content sanction, because a
  /// repo cannot read its e-mail.
  user   User   @relation("SanctionTarget", fields: [userId], references: [id], onDelete: Cascade)
  userId String

  /// For a content sanction: repo · catalog · item, its id, and its name at the time.
  /// The name is denormalised on purpose — the row may be deleted, the record must survive it.
  targetType String?
  targetId   String?
  targetName String?
  /// Other content caught by the same decision (ids), so one takedown can name several items
  /// instead of becoming five unrelated records.
  relatedIds String[] @default([])

  reason         String
  /// What the person is being asked to do about it, if anything. A warning with no request
  /// is just an insult with a reference number.
  request        String?
  requiresAction Boolean @default(false)

  issuedBy   User?     @relation("SanctionIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  issuedById String?
  issuedAt   DateTime  @default(now())
  expiresAt  DateTime?

  /// active · lifted · expired
  status     String    @default("active")
  liftedAt   DateTime?
  liftedById String?
  liftReason String?

  /// The contest. An admin closure cannot be cancelled by the person it lands on — but it can
  /// be argued with, and an argument nobody can file is not a right.
  contestedAt         DateTime?
  contestBody         String?
  /// upheld · overturned
  contestOutcome      String?
  contestAnswer       String?
  contestAnsweredAt   DateTime?
  contestAnsweredById String?

  /// The report this came out of, when it came out of one. A decision with no cause recorded
  /// is a decision nobody can review later — and without it the next moderator re-reads a
  /// case that was already handled.
  report   Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  reportId String?

  /// STAFF ONLY. Never sent, never quoted, never shown to the person it is about.
  ///
  /// `reason` is the opposite: it goes in the e-mail and comes back in any contest, so it has
  /// to be something you are willing to defend to the person reading it. That left nowhere to
  /// put "third account from this IP, see SNC-4821" — context the next moderator needs and the
  /// subject must not read. Without a field for it, that context either goes in `reason`
  /// (where it is disclosed) or nowhere (where it is lost).
  ///
  /// It is still a record about a person: it appears in a data-access request as staff-held
  /// data, and it is covered by the same edit history as the rest.
  internalNote String?

  /// Whatever the decision needs to remember — chiefly the subscriptions it cancelled, so the
  /// offer to take them out again can name them when the suspension ends.
  meta Json?

  /// Filed away, not deleted. A sanction is a record of a decision about a person, so it must
  /// never be removable — but a moderation list that shows every settled case from three years
  /// ago is a list nobody reads, and an unread list is how an open contest gets missed.
  /// Archiving hides a row from the default view and changes nothing else. An ACTIVE sanction
  /// cannot be archived: that would take a decision still in force out of sight.
  archivedAt   DateTime?
  archivedById String?

  /// Every edit, oldest first: { at, byId, field, from, to }. A sanction's reason is quoted in
  /// the e-mail the person received and in any contest they file, so changing it silently
  /// would leave them holding a document that no longer matches the record. Editable, but not
  /// quietly.
  edits Json?

  attachments SanctionAttachment[]

  @@index([userId, issuedAt])
  @@index([status, expiresAt])
  @@index([targetType, targetId])
  @@index([reportId])
  @@index([archivedAt])
}

/// Evidence attached to a sanction: a screenshot, a recording, a link, a file.
///
/// A separate table rather than a Json array on Sanction, because these are uploaded objects
/// with a lifetime — deleting one has to delete the stored blob, and a row makes that an
/// ordinary cascade instead of something the application has to remember.
///
/// Staff-only. Nothing here is served to the person the sanction is about: a report's evidence
/// routinely names the account that filed it, and handing that over on request would make
/// reporting unsafe. Whether a redacted subset should reach a contest is a policy question, and
/// the honest default is to answer it deliberately rather than by leaving the field public.
model SanctionAttachment {
  id         String   @id @default(cuid())
  sanction   Sanction @relation(fields: [sanctionId], references: [id], onDelete: Cascade)
  sanctionId String

  /// image · video · file · link
  kind       String
  /// For an uploaded object: its key in storage. Null for a link.
  storageKey String?
  /// For a link: the address. Null for an upload.
  url        String?
  /// Original filename, or the label a moderator gave the link.
  name       String
  mime       String?
  bytes      Int     @default(0)
  /// Why this is here. Evidence with no note is evidence the next moderator has to re-derive.
  note       String?

  addedBy   User?    @relation("SanctionAttachmentAuthor", fields: [addedById], references: [id], onDelete: SetNull)
  addedById String?
  createdAt DateTime @default(now())

  @@index([sanctionId, createdAt])
}

/// A row somebody has dealt with, or does not want to look at, in the "Needs attention" list.
///
/// It hides the row from THAT list and nothing else. The queue counts stay truthful, because
/// the work still exists: a submission that is still PENDING is still pending whether or not
/// a moderator ticked it off here. A dismissal that silently decremented the count would turn
/// the one number staff trust into a to-do list anybody could edit.
///
/// Shared, not per-person: two moderators working the same list should not each have to
/// dismiss the same handled item. Who did it is recorded so the other one can ask.
model PendingDismissal {
  id     String   @id @default(cuid())
  queue  String
  itemId String
  /// handled · archived — the difference is only what the person meant, and it is worth
  /// keeping: "I dealt with this" and "I am not going to" are different admissions.
  mode   String   @default("handled")
  by     User?    @relation(fields: [byId], references: [id], onDelete: SetNull)
  byId   String?
  at     DateTime @default(now())

  @@unique([queue, itemId])
  @@index([at])
}

/// An address to tell when something happens, so a developer stops asking.
///
/// Every integration built against this API so far has to poll: ask /v1/catalogs every
/// minute in case an item was published. That is wasted on both sides and always late by up
/// to a minute. A webhook inverts it — we call them.
model WebhookEndpoint {
  id             String    @id @default(cuid())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  url            String
  /// Which events this address wants. Empty means none — the same rule as scopes on a key:
  /// a subscription to nothing is silence, not a wildcard.
  events         String[]  @default([])
  /// Shared with the receiver once, at creation. Every delivery is signed with it, so the
  /// receiver can tell our call from anybody who learned the URL.
  secret         String
  enabled        Boolean   @default(true)
  label          String    @default("")
  /// Consecutive failures. A dead address is disabled rather than retried for ever, and the
  /// owner is told — an endpoint quietly retried for a month is a bill nobody agreed to.
  failures       Int       @default(0)
  disabledReason String?
  lastAt         DateTime?
  lastStatus     Int?
  createdAt      DateTime  @default(now())

  deliveries WebhookDelivery[]

  @@index([userId])
  @@index([enabled])
}

/// One attempt to deliver one event. Kept so "you never called me" has an answer, and so a
/// failed delivery can be replayed once the receiver is fixed.
model WebhookDelivery {
  id          String          @id @default(cuid())
  endpoint    WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  endpointId  String
  event       String
  payload     Json
  /// pending · ok · failed
  status      String          @default("pending")
  httpStatus  Int?
  error       String?
  attempts    Int             @default(0)
  /// When the next attempt is due. Null once it succeeded or was given up on.
  nextAt      DateTime?
  createdAt   DateTime        @default(now())
  deliveredAt DateTime?

  @@index([endpointId, createdAt])
  @@index([status, nextAt])
}

model ServerAlertLog {
  id        String    @id @default(cuid())
  kind      String
  message   String
  announced Boolean   @default(false) // has the Discord bot posted this one yet?
  // Acknowledgement is what turns a log into a queue: the "Server perf" tab badges the
  // count of alerts nobody has looked at yet. Without it the badge would show a 30-day
  // history for ever and be ignored within a week.
  ackAt     DateTime?
  ackById   String?
  // How bad, decided where the alert is RAISED rather than by the colour of a badge in the
  // admin screen. "Disk is 94 % full" and "a third of page loads were slow" were the same
  // red triangle, so the list had no order beyond "recent", and the one row that needed
  // somebody tonight was somewhere in the middle of forty that did not.
  //   critical  something is failing now, or will within hours
  //   warning   a threshold was crossed, it is not on fire
  //   info      worth knowing, no action implied
  severity  String    @default("warning")
  // The CONDITION, as opposed to this particular sighting of it: `cpu`, `disk`,
  // `service_down:db`. It is what makes "still happening" answerable — the monitor closes
  // every open alert whose key is not among the conditions true on the current tick.
  key       String?
  // Null while the condition is still true. An alert list where a two-week-old incident that
  // fixed itself looks exactly like the outage happening right now is a list nobody can act
  // on, and acknowledging is not the same thing: `ackAt` says a human saw it, `resolvedAt`
  // says the machine is fine again.
  resolvedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@index([ackAt])
  @@index([key, resolvedAt])
}

/// One row per period a dependency was unreachable — opened the first tick it fails and
/// closed the first tick it answers again. The alert log says "storage is unreachable"
/// once per debounce window; this says *for how long*, which is the question actually
/// asked after the fact. `cause` keeps the message that opened it, so an outage carries
/// its reason rather than just its shape.
model ServiceOutage {
  id        String         @id @default(cuid())
  dep       String
  cause     String?
  startedAt DateTime       @default(now())
  endedAt   DateTime?
  notes     IncidentNote[]

  @@index([dep, startedAt])
  @@index([endedAt])
}

model Subscription {
  id               String        @id @default(cuid())
  user             User          @relation(fields: [userId], references: [id])
  userId           String
  // A hosting subscription anchors to EITHER a single repo (legacy single-repo hosting)
  // OR a whole storage pool (the current model: you buy a pool and fill it with repos
  // and/or catalogs). Exactly one is set. Pool subs let a purchase exist with no repo at
  // all (e.g. a catalog-only pool).
  serverRepo       ServerRepo?   @relation(fields: [serverRepoId], references: [id])
  serverRepoId     String?       @unique
  // A pool can hold MULTIPLE subscriptions once pools are merged (each keeps billing
  // separately); poolContribBytes is the storage THIS sub adds to the pool. A pool's
  // effective poolBytes = sum of its ACTIVE subs' poolContribBytes.
  hostingGroup     HostingGroup? @relation(fields: [hostingGroupId], references: [id])
  hostingGroupId   String?
  poolContribBytes BigInt        @default(0)
  plan             HostingPlan   @relation(fields: [planId], references: [id])
  planId           String
  stripeSubId      String?       @unique
  status           String        @default("active")
  currentPeriodEnd DateTime?
  warnedAt         DateTime? // set when the 72h-before-expiry warning was sent (once per term)
  /// When this subscription began. Absent until now, which is why the included-boost
  /// grant had nothing to anchor a period to -- and anchoring to the calendar would hand
  /// somebody who bought on the 28th a second month of boosts three days later.
  createdAt        DateTime      @default(now())

  @@index([hostingGroupId])
  boostCredits      BoostCredit[]
}

// Recurring "featured" boost — a Stripe subscription that re-extends a repo's
// featuredUntil every `days`. Separate from Subscription (which is @unique per
// repo for hosting), so a repo can be both hosted AND boosted. No relations, on
// purpose (like Payment), to keep ServerRepo/User untouched — looked up by
// serverRepoId / stripeSubId in the webhook.
model FeatureSubscription {
  id               String    @id @default(cuid())
  userId           String
  serverRepoId     String
  stripeSubId      String    @unique
  days             Int
  status           String    @default("active")
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())

  @@index([serverRepoId])
}

// Password reset tokens (single-use, short-lived). The raw token is never stored.
/// A social sign-in that landed on an e-mail some account already owns. The callback no
/// longer attaches the provider on the strength of the address alone: the person proves the
/// account is theirs (its password, or the code mailed to the address), and only then is the
/// provider linked and the session issued. Short-lived; one use.
model OAuthLinkProposal {
  id                String    @id @default(cuid())
  tokenHash         String    @unique // sha256 of the token carried in the /auth?link= URL
  userId            String
  provider          String
  providerAccountId String
  username          String?
  avatar            String?
  codeHash          String? // sha256 of the 6-digit code e-mailed to the account's address
  expiresAt         DateTime
  usedAt            DateTime?
  createdAt         DateTime  @default(now())

  @@index([userId])
}

/// Feedback & crash centre: one row per submission an app posted to `/feedback/<project>`.
/// Loose ids on purpose (no relation to User): a report must survive its sender leaving, and
/// an anonymous one has no sender at all. `attachments` = [{ key, name, type, size }] in
/// object storage, served only to staff. `reportId` = the dashboard thread opened for a
/// linked sender.
model Feedback {
  id          String   @id
  projectKey  String
  kind        String // feedback | bug | crash
  title       String   @default("")
  body        String   @default("")
  appVersion  String   @default("")
  os          String   @default("")
  meta        Json?
  attachments Json     @default("[]")
  fingerprint String   @default("")
  count       Int      @default(1)
  status      String   @default("new") // new | triaged | resolved | ignored
  userId      String?
  email       String   @default("")
  creatorId   String   @default("")
  ipHash      String   @default("")
  reportId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectKey, status])
  @@index([fingerprint])
  @@index([userId])
  @@index([createdAt])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // sha256 of the emailed token
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Email-confirmation token, emailed on sign-up (and re-sendable). Same shape as
// PasswordReset — sha256 of the token, single-use, expiring.
model EmailVerification {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Global, admin-editable settings: total hosting capacity, reserved free margin,
// price/GB, price/upload, price/cpu, feature flags, etc. (key -> JSON value).
// Admin-generated promo code. Three kinds:
//  - 'discount'     : % off (and/or first N months free) applied at hosting/boost checkout
//  - 'free_hosting' : redeeming provisions a free hosted repo (storage/upload/duration)
//  - 'free_boost'   : redeeming boosts one of the user's repos for boostDays
model PromoCode {
  id              String            @id @default(cuid())
  code            String            @unique
  kind            String
  percentOff      Int? // discount: 1..100
  freeMonths      Int? // discount: first N months free (100% off, repeating)
  minMonths       Int? // discount: only applies at checkout when the chosen prepaid term is >= this (e.g. Ko-fi's reward is 12mo+ only)
  /// Minimum cart subtotal, in cents, for the code to apply.
  ///
  /// When BOTH this and minMonths are set, EITHER one satisfies the code — "a long term or
  /// a big enough basket". That is deliberately an OR, and it is written once, in
  /// promoMeetsMinimum(); the two checkout paths call it rather than each testing the
  /// fields, because this rule existed twice before and would have diverged the moment a
  /// second condition appeared.
  minAmountCents  Int?
  storageGB       Int? // free_hosting
  uploadMbps      Int? // free_hosting
  hostMonths      Int? // free_hosting: grant duration (0/none = no auto-expiry)
  boostDays       Int? // free_boost
  maxRedemptions  Int? // null = unlimited
  redeemedCount   Int               @default(0)
  perUserLimit    Int               @default(1)
  notBefore       DateTime? // if set, the code is NOT valid before this (e.g. an event-only code)
  expiresAt       DateTime?
  active          Boolean           @default(true)
  stackable       Boolean           @default(false) // may be combined with OTHER stackable codes in one cart
  assignedUserIds String[]          @default([]) // if non-empty, ONLY these users may redeem it (gift codes)
  assignedTokens  String[]          @default([]) // typed identifiers that may redeem (no linked account required): "email:x" | "discord:x" | "creator:x" | "bcid:x"; matched to the redeeming user at redeem time
  note            String            @default("")
  createdAt       DateTime          @default(now())
  redemptions     PromoRedemption[]
}

model PromoRedemption {
  id        String    @id @default(cuid())
  promo     PromoCode @relation(fields: [promoId], references: [id], onDelete: Cascade)
  promoId   String
  userId    String
  detail    String    @default("")
  createdAt DateTime  @default(now())

  @@index([promoId])
  @@index([userId])
}

// A site-wide, time-boxed promo CAMPAIGN (Black Friday, New Year sale, a random flash
// sale…). Unlike PromoCode (the user types a code), a campaign AUTO-applies its discount
// to purchases during its window and shows an announcement badge across the whole site.
// A campaign may also be owned by an Event (Phase 2) — eventId links them.
model PromoCampaign {
  id             String   @id @default(cuid())
  name           String // internal label, e.g. "Black Friday 2026"
  kind           String   @default("custom") // "custom" | "black_friday" | "new_year" | "flash"
  percentOff     Int // 1..100, applied site-wide to purchases in-window
  appliesTo      String   @default("all") // "all" | "hosting" | "boost"
  startsAt       DateTime
  endsAt         DateTime
  active         Boolean  @default(true) // master switch (must ALSO be within [startsAt,endsAt])
  badgeEnabled   Boolean  @default(true) // show the site-wide announcement badge
  badgeMessageEn String   @default("") // custom announcement (EN); blank → sensible default
  badgeMessageFr String   @default("") // custom announcement (FR)
  badgeColor     String   @default("") // optional accent hex (validated); blank → brand color
  badgeLink      String   @default("") // optional click target: internal "/blog/x" or "https://…" (validated)
  // The Stripe coupon that carries this campaign onto SUBSCRIPTION checkouts.
  //
  // A one-time charge can simply be multiplied; a subscription cannot — a discounted
  // unit_amount would bill the sale price every month for as long as the item is hosted.
  // Stripe's coupon with `duration: 'once'` is the mechanism that ends when the sale does.
  // Created lazily on the first subscription checkout during the campaign and reused after.
  stripeCouponId String?
  // DEAD. Declared, never read, never written — anywhere. An event that mints a code
  // records it on Event.eventCode and finds it back by `note`, and campaign teardown goes
  // through Event.campaignId. Kept as a column rather than dropped so no deployed database
  // needs a destructive migration for a field that has only ever held NULL; do not start
  // writing to it — add the relation properly if that is ever wanted.
  promoCodeId    String?
  eventId        String?  @unique // set when the campaign belongs to an Event (Phase 2)
  createdAt      DateTime @default(now())

  @@index([active, startsAt, endsAt])
}

// A site EVENT (New Year, a national holiday…). One event is live at a time. While
// live it plays a full-screen effect (fireworks; for a national holiday the burst
// forms the country's flag) and shows a custom announcement. An event may own a promo
// (a PromoCampaign via campaignId) and an event-only code (eventCode, valid only for
// its window). Notifications fire `notifyDaysBefore` days ahead and again at start.
model Event {
  id               String    @id @default(cuid())
  name             String // internal label
  kind             String    @default("custom") // "custom" | "national_holiday" | "new_year"
  countryCode      String    @default("") // ISO-3166 alpha-2 (national_holiday → which flag)
  startsAt         DateTime
  endsAt           DateTime
  active           Boolean   @default(true) // master switch (must ALSO be within the window)
  effect           String    @default("fireworks") // the effect kind (same everywhere = fireworks)
  fxDensity        Int       @default(5) // 1..10 — how many fireworks (rocket rate)
  fxSize           Int       @default(5) // 1..10 — particle size
  fxFlagDrops      Int       @default(2) // how many times the flag forms (random time/place)
  badgeIcon        String    @default("sparkles") // announcement icon (named lucide icon, NOT an emoji)
  linkUrl          String? // where the announcement badge links (internal path or full URL)
  titleEn          String    @default("")
  titleFr          String    @default("")
  messageEn        String    @default("")
  messageFr        String    @default("")
  notifyDaysBefore Int       @default(0) // X days before → notify users currently on the site
  preNotifiedAt    DateTime? // set once the pre-event notification fired (idempotent)
  startNotifiedAt  DateTime? // set once the at-activation notification fired
  promoPercent     Int       @default(0) // event discount % (0 = no promo); drives the linked campaign + code
  campaignId       String?   @unique // linked PromoCampaign (the event's discount + badge)
  eventCode        String    @default("") // event-only promo code (valid only during the window)
  createdAt        DateTime  @default(now())

  @@index([active, startsAt, endsAt])
}

// ── OpenID Connect provider (BCWEB as an SSO identity provider for other services) ──
// RSA signing key. The public half is served at /.well-known/jwks.json; the private
// PEM is server-only and NEVER leaves the API. Generated once on first use.
model OidcKey {
  id         String   @id // kid
  alg        String   @default("RS256")
  publicJwk  Json // JWK (public) for JWKS
  privatePem String // PKCS8 PEM — secret, never exposed
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model OAuthClient {
  id           String   @id @default(cuid()) // client_id
  name         String
  secretHash   String   @default("") // sha256(client_secret); empty for public clients
  confidential Boolean  @default(true) // false = public client (PKCE required, no secret)
  redirectUris String[] @default([])
  scopes       String[] @default(["openid", "profile", "email"])
  active       Boolean  @default(true)
  // 'public'  → `sub` is the BetterCommunity user id, the same value every client sees.
  // 'pairwise'→ `sub` is an opaque id unique to THIS client, so two clients comparing
  //             notes cannot tell they are looking at the same person.
  //
  // Default stays 'public' because changing an existing client's subject type silently
  // re-identifies every one of its users as a stranger — accounts get orphaned, not
  // merged. It is a choice made when a client is created, not a switch to flip later.
  subjectType  String   @default("public")
  // Self-service registration. Null = created by staff, which is what every client was
  // before the developer page existed.
  owner        User?    @relation("OAuthClientOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId      String?
  // Reviewed by staff. An unverified client works exactly the same — refusing to sign
  // people in until a human looks would make registration pointless — but the consent
  // screen says so, because "which app is this, really" is the one question a consent
  // screen exists to answer and anyone can type any name.
  verified     Boolean  @default(false)
  description  String   @default("")
  homepageUrl  String?
  createdAt    DateTime @default(now())

  @@index([ownerId])
}

// The stored mapping behind a pairwise `sub`.
//
// Stored rather than derived. A computed sub (hash of client + user + a server salt) needs
// nothing persisted right up until the salt is rotated or the algorithm changed, at which
// point every user of every pairwise client becomes a brand-new person with an empty
// account and no way back. A row is boring and cannot drift.
// Handing a repository or a catalog item to somebody else.
//
// A request, never an act: the recipient inherits storage they will be billed for, content
// they become answerable for, and abuse reports that follow the object rather than the
// person. Pushing that onto an account without asking is how you make somebody the owner
// of a problem they have never seen.
//
// The row survives its own resolution — an accepted transfer is the record of who used to
// own something, which is exactly the question asked after a takedown.
// Why somebody left, or why they stayed.
//
// Deliberately its own table rather than a column on User: the answer must outlive the
// anonymisation it describes, and it is about the DECISION, not the person — so it holds
// no identity beyond the fact that some account gave it.
model AccountClosureSurvey {
  id        String   @id @default(cuid())
  // Kept so a support conversation can be matched to an answer while the account still
  // exists; it points at a row that will have been scrubbed by the time most of these are
  // read, which is the intended amount of identifiability.
  userId    String
  // 'closed' = they went through with it. 'cancelled' = they came back.
  outcome   String
  reason    String   @default("")
  comment   String   @default("")
  createdAt DateTime @default(now())

  @@index([outcome, createdAt])
}

model OwnershipTransfer {
  id          String    @id @default(cuid())
  kind        String // 'repo' | 'catalog'
  targetId    String // ServerRepo.id or CatalogItem.id
  targetName  String // snapshot: the object may be renamed or gone by the time this is read
  fromUserId  String
  toUserId    String
  // pending → accepted | declined | cancelled | expired
  status      String    @default("pending")
  message     String    @default("")
  // What the recipient said when they turned it down. Optional, and only ever set on a
  // decline: "no" with no reason leaves the sender guessing whether to ask again, and the
  // guess is usually to ask again.
  reason      String    @default("")
  createdAt   DateTime  @default(now())
  respondedAt DateTime?
  // Requests do not hang around forever: an unanswered one becomes noise in both
  // inboxes, and consent that old is not consent to today's object.
  expiresAt   DateTime

  @@index([toUserId, status])
  @@index([fromUserId, status])
  @@index([kind, targetId, status])
}

model OAuthPairwiseSub {
  sub       String   @id
  userId    String
  clientId  String
  createdAt DateTime @default(now())

  @@unique([userId, clientId])
  @@index([clientId])
}

model OAuthCode {
  code          String    @id // authorization code (random, single-use)
  clientId      String
  userId        String
  redirectUri   String
  scope         String
  nonce         String    @default("")
  codeChallenge String    @default("") // PKCE S256 challenge
  // When the user authenticated, as unix seconds — carried from /authorize so the ID
  // token minted at /token can state auth_time. Without it, a client that sent max_age
  // gets a token with nothing to check that claim against and rejects it.
  authTime      Int?
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([expiresAt])
}

model OAuthConsent {
  id        String   @id @default(cuid())
  userId    String
  clientId  String
  scope     String
  createdAt DateTime @default(now())

  @@unique([userId, clientId])
}

model OAuthRefreshToken {
  token     String    @id // sha256 of the refresh token
  clientId  String
  userId    String
  scope     String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// A Discord giveaway managed from the admin bot dashboard. The bot posts a message
// with an "Enter" button, collects entrant Discord ids, and at `endsAt` draws random
// winners, announces them, and (if `giftConfig` is set) DMs each winner a promo code.
model Giveaway {
  id            String   @id @default(cuid())
  prize         String
  channelId     String? // Discord channel for the Enter button; null for a site-only giveaway
  messageId     String? // the Discord message carrying the Enter button (set once posted)
  endsAt        DateTime
  winnersCount  Int      @default(1)
  status        String   @default("active") // active | ended
  entries       String[] @default([]) // entrant Discord ids
  siteEntrants  String[] @default([]) // BCWEB userIds who entered via the site (audience site/both)
  winnerIds     String[] @default([]) // drawn winner Discord ids
  giftConfig    Json? // optional promo gift for each winner ({ kind, percentOff, … })
  requirements  Json? // optional entry gate: { linked?: bool (Discord⇄BCWEB account), creator?: bool (linked BMM creator id) }
  winnerMessage String? // customizable winner DM template; bot substitutes {user}/{prize}/{code}
  createdBy     String?
  createdAt     DateTime @default(now())
  // Who made it and where it can be entered. `kind=admin` is staff-created (dashboard/site);
  // `kind=user` is a member's own giveaway from the bot's /giveaway (Discord-only). `audience`
  // gates the entry surfaces. A user giveaway is capped at 5 active per guild.
  kind          String   @default("admin") // "admin" | "user"
  audience      String   @default("discord") // "discord" | "site" | "both"
  guildId       String? // the Discord guild (user giveaways: for the 5/guild cap)
  hostDiscordId String? // user giveaways: the member who created it
  // The prize. `promo` mints a code on reveal (from giftConfig); `custom` reveals prizeContent
  // (a code/link/text the creator typed); `none` is bragging rights only. A win lands in the
  // winner's inventory (an EconomyPurchase kind="giveaway") and is revealed there.
  prizeKind     String   @default("promo") // "promo" | "custom" | "none"
  prizeContent  String? // prizeKind=custom: the content revealed to the winner

  @@index([status])
  @@index([guildId, status])
}

// A hosting shopping-cart checkout, persisted while the user is at Stripe. The
// resolved line items (hosting plan ids / boost repo+days) + promo codes are stored
// here and consumed by the checkout.session.completed webhook (metadata carries only
// the cart id, since a full cart won't fit in Stripe's metadata limits).
model PendingCart {
  id        String   @id @default(cuid())
  userId    String
  payload   Json // { items: [...], promoCodes: [...] }
  createdAt DateTime @default(now())

  @@index([userId])
}

model AdminSetting {
  key   String @id
  value Json
}

// A snapshot of a project page's config at a given version — powers the version-history
// modal (open a project page "as it was" in a past version, with that version's info +
// downloads). `target` is the built-in project key ("bmm") or a showcase ("sc:<id>"). A
// snapshot is (re)written whenever an admin saves that project's config while its version
// field is set, so each distinct version keeps its final config.
// Edit history for a project page's config blob (same idea as BlogRevision/DocRevision).
//
// The config lives in an AdminSetting row, which keeps only the CURRENT value — so an
// edit that broke a page left nothing to compare against and nobody to ask. A snapshot is
// written on every save: the whole config, who saved it, and when.
//
// Distinct from ProjectVersion, which is keyed by the config's own `version` STRING and
// exists to show visitors what shipped in each release. Two saves inside one version
// overwrite that row; here they are two entries, because "what changed at 14:02" is a
// different question from "what does 1.2.0 look like".
/// One encryption key per user — the erasure mechanism for backups.
///
/// Row backups are git-committed JSON, and git is append-only: a user deleted from the live
/// tables stays in every snapshot taken before that. Rewriting git history invalidates every
/// hash and breaks every restore that referenced one, so instead each user's backups are
/// encrypted with their own key and erasure is deleting the key. One person becomes
/// unreadable; everybody else stays restorable.
///
/// Minted lazily on the first backup that needs it — a key for an account that never had one
/// taken is a secret stored for nothing.
model UserDataKey {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @id
  /// 32 random bytes. Never leaves the server, and never appears in an API response.
  key       Bytes
  createdAt DateTime @default(now())
}

model ProjectConfigRevision {
  id        String   @id @default(cuid())
  // 'bmm' | 'bsm' | … for a fixed project, or 'sc:<id>' for a showcase project — the
  // same target convention ProjectVersion already uses.
  target    String
  config    Json
  editorId  String?
  createdAt DateTime @default(now())

  @@index([target, createdAt])
}

model ProjectVersion {
  id        String   @id @default(cuid())
  target    String
  version   String
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([target, version])
  @@index([target])
}

// What a release SAID, beside the page snapshot above (G2, PLAN-SEPT23). ProjectVersion holds
// the page config as it was; this holds the release itself: channel, date, highlights, notes,
// breaking changes, the files with their size and checksum, and where it was announced.
//
// A separate table on purpose. A snapshot can be "put live" from the admin; a release entry
// imported from GitHub has no page behind it, and filing one as an empty config would make that
// button wipe the page. Joined to ProjectVersion by (target, version) when both exist.
//
// `target` is the project key, or `sc:<showcaseId>` for an Other project, exactly as in
// ProjectVersion. `content` is per language: { en: { title, highlights[], notes, breaking[] },
// fr: {...}, <runtime locale>: {...} }, English being the fallback.
model ProjectRelease {
  id          String   @id @default(cuid())
  target      String
  version     String
  /// stable | beta | alpha | rc | nightly
  channel     String   @default("stable")
  date        DateTime @default(now())
  content     Json     @default("{}")
  /// [{ label, url, size (bytes), checksum ("sha256:…"), platform }]
  assets      Json     @default("[]")
  /// { blog: "/blog/<slug>" | https URL, github: https URL }
  links       Json     @default("{}")
  published   Boolean  @default(true)
  /// "github" when imported from GitHub releases, null when written here.
  source      String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([target, version])
  @@index([target, date])
}

// A project's OWN docs and legal pages (G3, PLAN-SEPT23), written by the project's editors.
//
// Deliberately NOT DocPage / LegalSection: those are the SITE's docs and the SITE's legal
// pages, gated on manage_docs / manage_legal. A project editor holds neither and must never
// reach them (pentest R10), so project pages live in their own table behind their own routes,
// and nothing here can name a site row. `kind` is "doc" or "legal", nothing else.
//
// `content` is per language: { en: { title, category, body }, fr: {...}, ... }. `category` is
// the site docs' "Top / Sub" path. Bodies are B.MD, stored as written and rendered through the
// same sanitising renderer as the blog and the site docs.
model ProjectDoc {
  id          String   @id @default(cuid())
  target      String
  kind        String
  slug        String
  icon        String?
  order       Int      @default(0)
  published   Boolean  @default(true)
  content     Json     @default("{}")
  /// { url, importedAt } when the page came from a repository's markdown.
  source      Json?
  /// Optimistic-concurrency counter, like DocPage.version.
  version     Int      @default(1)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([target, kind, slug])
  @@index([target, kind])
}

// Platform-hosted assets served at stable public URLs (/api/assets/<key>): app download
// files (BMM/BSM/BI installers), auto-update manifests, and JSON configs (links.json,
// contributors.json). A `file` asset lives in object storage (storageKey); a `json` asset
// stores its content inline so admins can edit it in the dashboard. `key` is the stable
// public slug. `channel`/`version` let one logical download (e.g. bmm-installer) advertise
// a version + release channel to the auto-updater.
model PlatformAsset {
  id          String   @id @default(cuid())
  key         String   @unique
  kind        String   @default("file") // "file" | "json"
  label       String   @default("")
  // file assets
  filename    String?
  contentType String?
  size        BigInt   @default(0)
  storageKey  String?
  version     String?
  channel     String   @default("stable")
  // json assets
  json        Json?
  /// Count views and downloads on this one. OFF by default and asked for per asset: counting
  /// means a write on every public GET, and the assets this table was built for are fetched
  /// by an application on a timer — where a counter measures polling, not interest.
  countStats  Boolean  @default(false)
  /// Two numbers, not one. A VIEW is the file rendered in place (an <img>, a <video>, the
  /// dashboard viewer); a DOWNLOAD is the bytes taken away. The caller says which by asking
  /// for `?inline=1` or not, rather than the server guessing from a header.
  views       Int      @default(0)
  downloads   Int      @default(0)
  /// image · video · audio · document · archive · other — derived from the content type at
  /// upload. Stored so a listing does not parse a MIME string per row.
  media       String   @default("")
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([media, updatedAt])
}

// One row per Ko-fi webhook event — lets the public funding-goal widget show a
// real running total + tip count, not just the one-time discount-grant flag on
// User. messageId dedupes Ko-fi's at-least-once webhook retries.
model KofiDonation {
  id             String   @id @default(cuid())
  messageId      String   @unique
  fromName       String
  email          String?
  amount         Float
  currency       String
  isSubscription Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

// Admin-curated "Other projects" showcase. Each has a name, a short tag (3-4 chars),
// and a flexible config (tabs, links, overview media, progress source, release-notes
// source, community, legal cards) rendered by a BMM/BSM-style project page.
/// Somebody asking for their project to appear in "Other projects".
///
/// The showcase was admin-only: the grid existed and there was no way in from outside, so
/// the answer to "can my project be listed" was an e-mail, if the person thought to send one.
///
/// A request is ALWAYS reviewed, including a paid one. Paying buys a place in the queue and
/// nothing else — a listing that appears because money arrived is an advert, and the grid
/// stops meaning anything the moment it holds one.
model ShowcaseRequest {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  /// What the applicant proposes. The slug is a suggestion — staff can change it on approval,
  /// and it is not unique here because two pending requests may well ask for the same one.
  slug        String
  name        String
  short       String
  url         String   @default("")
  icon        String   @default("")
  description String   @default("")
  /// Why it belongs in the grid, in the applicant's words. Read by whoever reviews it.
  pitch       String   @default("")
  /// pending · approved · rejected
  status      String   @default("pending")
  /// Paid requests are marked here by the Stripe webhook. Kept even after approval so a
  /// refund question years later has an answer.
  paid        Boolean  @default(false)
  paidCents   Int      @default(0)
  currency    String   @default("usd")
  /// What staff said, shown to the applicant. A rejection with no reason is one that gets
  /// resubmitted unchanged.
  reviewNote  String   @default("")
  reviewedAt  DateTime?
  reviewerId  String?
  /// The page it became, once approved.
  projectId   String?
  /// ── Submission metadata (the applicant must declare these) ──
  /// Open-source projects are accepted from anyone; closed-source only from the rights-holder.
  isOpenSource Boolean @default(true)
  /// The licence, when open-source (SPDX id or free text). Empty for closed-source.
  license      String  @default("")
  /// "owner" = the applicant is the rights-holder; "fan" = a project they like but do not own
  /// (only allowed for open-source — a closed-source listing must come from the owner).
  ownership    String  @default("owner")
  /// Proof of rights for a CLOSED-SOURCE listing: a PRIVATE object key (uploads/<uid>/…), NOT
  /// public. Served only to the applicant + staff via a guarded route. Empty otherwise.
  proofKey     String  @default("")
  proofName    String  @default("")
  /// When the applicant accepted the Submission Terms (+ the non-refundable notice on a paid
  /// request). A submission cannot be created without it.
  tosAcceptedAt DateTime?
  /// The Report thread opened for this submission — the dashboard "Reports & contact" chat box
  /// where staff can ask for more detail. Null until the thread is created (on submit).
  contactReportId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model ShowcaseProject {
  id             String     @id @default(cuid())
  slug           String     @unique
  name           String
  short          String // 3-4 char label shown in the nav/cards
  // Logo/icon URL for this project — shown as the tag icon and used as the blog
  // thumbnail fallback for posts in this project's blog when they have no cover.
  icon           String?
  config         Json       @default("{}")
  published      Boolean    @default(true)
  order          Int        @default(0)
  // Per-blog toggle: do this custom page's posts also surface in the home page's
  // unified "Latest news"? They always show on /blog regardless of this flag.
  showOnHomeNews Boolean    @default(true)
  // Opt-in "Blog" tab on this page, showing only this page's own posts.
  showBlogTab    Boolean    @default(false)
  posts          BlogPost[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Who can view this page: public (anyone), private (nobody but admins), unlisted
  // (viewable with the direct link, just hidden from /projects and the topbar),
  // whitelist (gated by visibilityWhitelist — see pageAccountEntrySchema in lib.mjs).
  visibility          String  @default("public")
  visibilityWhitelist Json    @default("[]")
  // Shows this page as its own topbar pill (next to BMM/BSM/etc.) instead of only
  // being reachable through the /projects grid.
  pinTopbar           Boolean @default(false)

  // ── Project announcement (a "coming soon" teaser instead of the real page) ──
  // While announceEnabled and now < announceRevealAt, GET /showcase/:slug serves
  // the teaser (logo + markdown + countdown) regardless of `visibility`. Once the
  // countdown passes, the teaser stops and normal `visibility` rules take over —
  // there's nothing to sweep/cron, it's computed at read time (see showcase.mjs).
  announceEnabled     Boolean   @default(false)
  announceTitle       String    @default("")
  announceLogo        String?
  announceMarkdown    String    @default("")
  announceRevealAt    DateTime?
  // When true, the countdown does NOT take over the page — instead the real page
  // renders normally with an extra "Countdown" FIRST tab. When false (default) the
  // countdown is the only thing shown until it ends.
  announceShowPage    Boolean   @default(false)
  // Optional call-to-action on the countdown (teaser or first-tab): a button that
  // can point anywhere — an external URL, or an in-site /blog/… or /docs/… article.
  announceButtonLabel String    @default("")
  announceButtonUrl   String    @default("")

  // ── Scheduled content update: stage a future edit, swapped in automatically at
  // scheduledAt (old info fully replaced by "next") — computed + lazily persisted
  // on first read past scheduledAt (see showcase.mjs). ──
  scheduledAt   DateTime?
  scheduledNext Json?

  @@index([published, order])
}

// Contact-form submissions. Shown in the Admin dashboard and (if a webhook is
// configured) forwarded to Discord. No account required to send.
// A user report against another user / repo / catalog / catalog item, OR a general
// support thread. Works like a GitHub PR conversation: the reporter opens it with a
// message, staff and the reporter exchange messages (optionally with image attachments),
// and it moves open → archived (auto after inactivity, or manual) → deleted (after a
// further delay). A reporter may have at most one OPEN report per target at a time.
model Report {
  id             String              @id @default(cuid())
  targetType     String // "user" | "repo" | "catalog" | "item" | "general"
  targetId       String              @default("") // the reported entity's id ("" for general)
  targetLabel    String              @default("") // denormalized name for the admin list
  /// NULLABLE so a report can outlive the person who filed it.
  ///
  /// A report is about somebody ELSE'S content. When its author asks to be erased, deleting
  /// the report would remove moderation history about other people because the reporter left,
  /// and keeping the link would leave a pointer to an account that was told it was gone.
  /// Anonymising is the only option that costs neither: the decision and its thread survive,
  /// and nothing points back.
  ///
  /// Every read already tolerates it — canAccessReport compares ids, and the archive mail is
  /// guarded by `r.reporter?.email` — so this changes what CAN happen, not what does.
  reporter       User?               @relation("ReportReporter", fields: [reporterId], references: [id])
  reporterId     String?
  reason         String              @default("") // short category chosen by the reporter
  status         String              @default("open") // open | archived | closed
  staffUnread    Boolean             @default(true) // a new reporter message staff hasn't seen
  userUnread     Boolean             @default(false) // a new staff message the reporter hasn't seen
  lastActivityAt DateTime            @default(now())
  archivedAt     DateTime? // when it was archived (starts the delete countdown)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  messages       ReportMessage[]
  participants   ReportParticipant[]
  invites        ReportInvite[]
  sanctions      Sanction[]

  @@index([reporterId])
  @@index([status])
  @@index([targetType, targetId])
  @@index([lastActivityAt])
  @@index([archivedAt])
}

// Extra people added to a report thread beyond the reporter: other staff, or invited
// users. A participant can read + post in the thread (like the reporter).
model ReportParticipant {
  id        String   @id @default(cuid())
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      String   @default("invited") // "staff" | "invited"
  addedById String? // who added them (staff id), or null for a self-join via invite
  createdAt DateTime @default(now())

  @@unique([reportId, userId])
  @@index([reportId])
  @@index([userId])
}

// A shareable invite link to join a report thread. Optionally capped by number of uses and
// constrained to a specific account / email / BMM creator id.
model ReportInvite {
  id          String    @id @default(cuid())
  report      Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId    String
  token       String    @unique
  maxUses     Int       @default(1) // 0 = unlimited
  uses        Int       @default(0)
  targetType  String    @default("any") // any | user | email | creator
  targetValue String    @default("") // the account id / email / creator id it's locked to
  expiresAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([reportId])
}

model ReportMessage {
  id        String   @id @default(cuid())
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId  String
  author    User?    @relation(fields: [authorId], references: [id])
  authorId  String? // null = system note
  staff     Boolean  @default(false) // authored by a staff member (admin/mod)
  body      String   @default("")
  images    String[] @default([]) // uploaded attachment URLs (via the media presign)
  createdAt DateTime @default(now())

  @@index([reportId])
}

// A social account a user has linked to SHOW on their public profile (YouTube, Twitch,
// GitHub, Steam). Separate from OAuthAccount/DiscordLink (which are for signing in). Each
// provider is only offered if its credentials are configured server-side (.env).
model SocialConnection {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  provider   String // youtube | twitch | github | steam
  handle     String // display name / username
  url        String // public profile URL
  externalId String? // provider account id
  createdAt  DateTime @default(now())

  @@unique([userId, provider])
  @@index([userId])
}

model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  body      String
  // Set when the sender was logged in — links the message to their account so
  // support can see who's asking without them having to repeat it. Never required.
  user      User?     @relation(fields: [userId], references: [id])
  userId    String?
  /// What the sender says this is about.
  ///
  /// other · data_export · data_delete · bug · billing · appeal
  ///
  /// It exists because two of those are legal deadlines, not support tickets. A request to
  /// export or erase personal data has a clock on it, and until now it arrived as free text
  /// in the same list as "the download button is grey" — findable only by whoever happened
  /// to read it. A kind makes it countable, and a countable thing can be surfaced and
  /// chased. Sender-declared, so it is a routing hint and never a decision: staff can
  /// re-file one, and the body is still what gets read.
  kind      String    @default("other")
  ip        String    @default("") // for the daily anonymous rate limit + abuse review
  status    String    @default("new") // new | read
  readAt    DateTime?
  createdAt DateTime  @default(now())

  /// Blocks that exist because of this notice. SetNull on the other side, so deleting a
  /// message never quietly removes the protection it caused.
  blocks BlockedUrl[]

  // Declared here because the DB already has it: 20260815040000_contact_kind created it and
  // the model never named it, so every drift check wanted to DROP an index the admin queue
  // filters on. Keeping the index and declaring it is the correct half of that disagreement.
  @@index([kind, status])
  @@index([createdAt])
}

enum PaymentKind {
  FEATURE
  HOSTING
  MYO_CONSULTATION // "Make Your Own" consultation fee (opens the advice conversation)
  MYO_PRODUCT // "Make Your Own" quote payment (starts the actual product build)
  /// Paying to have a project reviewed for the "Other projects" grid. Appended last so
  /// existing rows keep their ordinal. It buys a REVIEW, not a listing — which is why a
  /// refund question can arise on this kind and does not on the others.
  SHOWCASE_LISTING
  /// One more team than the admin's limit allows — a one-off payment, appended last.
  TEAM_SLOT
}

// Billing history / invoices (one-time feature promotions, hosting charges…).
model Payment {
  id              String      @id @default(cuid())
  user            User        @relation(fields: [userId], references: [id])
  userId          String
  serverRepoId    String? // legacy single-repo hosting payment
  hostingGroupId  String? // storage-pool hosting payment (the current model)
  kind            PaymentKind
  description     String
  amountCents     Int
  currency        String      @default("usd")
  days            Int? // promotion duration, when applicable
  stripeSessionId String?
  status          String      @default("paid")
  createdAt       DateTime    @default(now())

  @@index([userId])
}

// ── "Make Your Own" (MYO) — a paid consultation + commission service ─────────────
// A visitor pays a small CONSULTATION fee to open a conversation about a product they
// want built (a Discord bot, an app, a website, a custom job, a security audit…). In the
// conversation they get advice + a real QUOTE; paying the quote starts the actual build;
// the finished product is delivered back into the same conversation. Two clearly-separate
// payments: the consultation fee (this is an *avis*/advice — not the product) and, later,
// the quote (the product itself). Managed under the `manage_myo` capability.

// Admin-curated catalog card shown on the public /myo page (the 3 base options —
// discord_bot / app / website — plus custom / audit). Prices here are display-only "from"
// signals; the binding price is always the admin's per-request MyoQuote.
model MyoProduct {
  id             String       @id @default(cuid())
  kind           String // discord_bot | app | website | custom | audit | …
  name           String
  tagline        String       @default("")
  description    String       @default("")
  icon           String? // lucide name / brand icon / image URL
  basePriceCents Int          @default(0) // shown as "from $X" (0 = "quote only")
  options        Json         @default("[]") // [{ label, priceCents, note }] shown on the card
  includesSource Boolean      @default(true) // whether this kind usually ships with source
  active         Boolean      @default(true)
  featured       Boolean      @default(false)
  order          Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  requests       MyoRequest[]

  @@index([active, order])
}

// One user's commission request — the paid consultation conversation.
model MyoRequest {
  id                String           @id @default(cuid())
  user              User             @relation(fields: [userId], references: [id])
  userId            String
  product           MyoProduct?      @relation(fields: [productId], references: [id])
  productId         String?
  productKind       String           @default("custom") // snapshot of the chosen kind
  // ── Intake (collected before the consultation payment) ──
  name              String // the product's name
  logo              String? // optional logo URL
  objective         String           @default("") // what it's for, in one line
  target            String           @default("personal") // personal|friends|community|nonprofit|commercial|other
  description       String           @default("") // ≤ 2000 chars (enforced in the route)
  lang              String           @default("en") // conversation language: en | fr
  urgent            Boolean          @default(false) // higher consultation fee, flagged to staff
  // ── Consultation payment (gate to open the conversation) ──
  consultationPaid  Boolean          @default(false)
  consultationCents Int              @default(0)
  stripeSessionId   String?
  // pending_payment → open (paid, advice stage) → quoted → in_production (quote paid) →
  // delivered → closed (reopenable) / cancelled.
  status            String           @default("pending_payment")
  staffUnread       Boolean          @default(true) // a user message staff hasn't seen
  userUnread        Boolean          @default(false) // a staff message the user hasn't seen
  // Who on the team owns this one. A queue where everybody sees everything is a queue
  // where two people answer the same request and nobody answers the next.
  assignedTo        User?            @relation("MyoAssignee", fields: [assignedToId], references: [id])
  assignedToId      String?
  assignedAt        DateTime?
  // Archived = handled, out of the working queue, still on file. Distinct from `closed`:
  // a request can be closed and still need invoicing, and a cancelled one still counts as
  // history. Nothing is ever deleted here — there is money attached to these rows.
  archivedAt        DateTime?
  lastActivityAt    DateTime         @default(now())
  closedAt          DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  messages          MyoMessage[]
  quotes            MyoQuote[]
  deliverables      MyoDeliverable[]

  @@index([userId])
  @@index([status])
  @@index([lastActivityAt])
  @@index([assignedToId])
  @@index([archivedAt])
}

// A message in a request's conversation (mirrors ReportMessage). Both the user and staff
// post here; `staff` marks the author side; `images` are uploaded attachment URLs.
model MyoMessage {
  id        String     @id @default(cuid())
  request   MyoRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String
  author    User?      @relation(fields: [authorId], references: [id])
  authorId  String? // null = system note
  staff     Boolean    @default(false)
  body      String     @default("")
  images    String[]   @default([]) // uploaded attachment URLs (media presign)
  createdAt DateTime   @default(now())

  @@index([requestId])
}

// A priced quote (devis) an admin builds inside a conversation. The user pays it to move
// the request into production. Line items are shown itemised; `includesSource` is surfaced
// as a badge (some products ship with source, some without).
model MyoQuote {
  id              String     @id @default(cuid())
  request         MyoRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId       String
  title           String     @default("")
  note            String     @default("")
  lineItems       Json       @default("[]") // [{ label, priceCents }]
  totalCents      Int        @default(0)
  currency        String     @default("usd")
  includesSource  Boolean    @default(false)
  validUntil      DateTime?
  status          String     @default("sent") // sent | paid | rejected | withdrawn
  stripeSessionId String?
  createdBy       String // admin userId
  createdAt       DateTime   @default(now())
  paidAt          DateTime?

  @@index([requestId])
}

// A finished-product delivery an admin posts into the conversation: an uploaded file
// and/or an external link (repo / hosted site), flagged whether it includes source code.
model MyoDeliverable {
  id             String     @id @default(cuid())
  request        MyoRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId      String
  title          String     @default("")
  note           String     @default("")
  fileUrl        String? // uploaded artifact (served via the media proxy)
  fileName       String?
  linkUrl        String? // external link / repo / hosted URL
  includesSource Boolean    @default(false)
  createdBy      String // admin userId
  createdAt      DateTime   @default(now())

  @@index([requestId])
}

// First-party, cookie-consent-gated page analytics (no third party, minimal data).
// `visitor` is a DAILY-rotating salted hash (ip+ua+date) — approximates unique
// visitors/sessions without a persistent cookie or storing any PII.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  path      String
  ref       String?
  visitor   String? // daily anonymous hash
  device    String? // mobile | tablet | desktop
  browser   String? // Chrome | Firefox | Safari | Edge | …
  os        String? // Windows | macOS | Ubuntu | Fedora | Kali | ChromeOS | Android | iOS | …
  country   String? // ISO-3166 alpha-2 (from the CDN's country header, when present)
  region    String? // subdivision (state/province) name, when geo resolves it
  city      String? // city name, when geo resolves it
  lat       Float? // approximate latitude from the IP (geoip `ll`), for the globe map
  lng       Float? // approximate longitude
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([visitor])
  @@index([country])
}

// Daily pre-aggregation of AnalyticsEvent so the dashboard's day-granularity series is a
// small primary-key range read instead of two full-window GROUP BY scans. Populated by the
// sweeper (rollupAnalyticsDaily). Rows persist beyond raw-event retention, so they also
// double as long-term history. `day` is the UTC date. (The hourly zoom still reads raw.)
model AnalyticsDaily {
  day       DateTime @id @db.Date
  views     Int      @default(0)
  visitors  Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Real-user Web Vitals (Core Web Vitals + FCP/TTFB), one row per metric sample, tied to
// the page path it was measured on. Percentiles (p50/p75/p90/p99) are computed per path
// in the admin panel. Values are milliseconds except CLS (unitless float).
model WebVital {
  id        String   @id @default(cuid())
  path      String
  metric    String // LCP | CLS | INP | FCP | TTFB
  value     Float
  rating    String? // good | needs-improvement | poor (as reported by web-vitals)
  // INP only: the element the slowest interaction landed on ("button: Save"). Identity,
  // never a field's value — this table is read by staff, and an INP number with nothing to
  // point at is something you can watch and cannot fix.
  label     String?
  visitor   String?
  device    String? // mobile | tablet | desktop
  browser   String? // Chrome | Firefox | Safari | Edge | … (for per-page breakdowns)
  os        String? // Windows | macOS | Android | iOS | …
  country   String? // ISO-3166 alpha-2 (from the CDN's country header, when present)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([metric])
}

// First-party in-page interaction events (clicks, copies, field edits, form submits,
// modal open/close). Same trust/consent model as AnalyticsEvent (daily anonymous
// visitor hash, no PII, no cookie) but kept in a SEPARATE table so it never pollutes
// pageview aggregates. Merged back into each visitor's session timeline in the admin
// Sessions feed (which button / which modal, à la a session-replay timeline) — without
// any heavyweight recording. `label` is a short human tag (button text / field name /
// modal title), never a field VALUE.
model InteractionEvent {
  id        String   @id @default(cuid())
  visitor   String? // daily anonymous hash (matches AnalyticsEvent.visitor)
  path      String // page path where it happened
  kind      String // click | copy | input | submit | modal_open | modal_close | nav
  label     String? // button text / field name / modal title (never a value)
  device    String? // mobile | tablet | desktop
  createdAt DateTime @default(now())

  @@index([visitor, createdAt])
  @@index([createdAt])
}

// Client-side errors captured in the wild (uncaught errors + unhandled rejections). Same
// consent model as the other analytics (daily anonymous visitor, no PII). Grouped by
// message in the admin error view (occurrences + distinct sessions + latest sample).
model ErrorEvent {
  id        String   @id @default(cuid())
  message   String // error message (bounded, client-clipped)
  stack     String? // stack trace (bounded)
  path      String // page path where it fired (or the request URL, for a server error)
  // "client" = reported by the browser (uncaught JS, consent-gated); "server" = a 5xx the
  // API's error handler caught. Server errors used to only reach stdout, so an admin
  // reading this page had no idea the API was failing.
  source    String   @default("client")
  visitor   String? // daily anonymous hash
  userId    String? // the signed-in account that hit it, if any (admin-only; resolved to a BC id)
  device    String?
  browser   String?
  os        String?
  country   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([message])
  @@index([source, createdAt])
}

// 404-page mini-game high scores. One best score per user per game (leaderboard). `userId`
// is a plain reference (no FK/cascade) so the leaderboard survives an account delete and the
// User model stays untouched; display name/avatar are resolved at read time.
model GameScore {
  id        String   @id @default(cuid())
  userId    String
  game      String   @default("orbfall")
  score     Int
  /// The month this score belongs to, as "YYYY-MM" (UTC). The leaderboard resets every
  /// month, and it resets by asking for the current season rather than by DELETING: a
  /// deleted board cannot award anything afterwards, and the winners are decided once the
  /// month is already over.
  season    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, game, season])
  @@index([game, season, score])
}

/// A finished month's podium, and the code it earned.
///
/// One row per (game, season, rank), which is what makes awarding idempotent: the sweeper
/// runs on every boot and every hour, and the second run must not mint a second code. The
/// row is also the only durable answer to "who won March" once a season scrolls off the
/// board.
model GameAward {
  id         String   @id @default(cuid())
  game       String   @default("orbfall")
  season     String
  rank       Int
  userId     String
  score      Int
  /// The code minted for this winner. Kept as the code string rather than a relation so
  /// deleting a spent code never erases the record of who won.
  code       String
  percentOff Int
  createdAt  DateTime @default(now())

  @@unique([game, season, rank])
  @@index([userId])
}

// FAQ — admin/editor-curated questions & answers, grouped by category. Answers use the
// BetterCommunity doc-block markdown (rendered with the same md.jsx pipeline as blog/docs).
model FaqItem {
  id         String   @id @default(cuid())
  question   String
  // The question and the category are TITLES — they are what a French reader sees first, and
  // they had no translation while the answer did. Nullable: an entry with no French title
  // falls back to the English one rather than showing an empty heading.
  questionFr String?
  answer     String   @default("") // markdown (doc-block system), EN base
  answerFr   String? // optional French translation
  category   String   @default("General")
  categoryFr String?
  order      Int      @default(0)
  published  Boolean  @default(true)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@index([category])
}

// Admin-defined conversion goals, evaluated against the analytics streams. A goal matches
// a pageview (path) or an interaction (kind + optional label), both filtered by an optional
// path pattern. Completions + unique-visitor conversion rate are computed on demand.
model AnalyticsGoal {
  id        String   @id @default(cuid())
  name      String
  kind      String   @default("pageview") // pageview | click | submit | input | copy
  path      String? // path pattern (case-insensitive contains), optional
  label     String? // event label pattern (contains), optional — for click/submit/input
  // Optional numeric target (e.g. "reach 1000 pageviews / 200 signups this window"). When
  // set, the goal shows progress toward it in addition to the conversion rate.
  target    Int?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Blog newsletter subscribers. Double opt-in (GDPR): a signup starts `pending` and only
// becomes `active` once the confirm link is clicked. Every email carries a one-click,
// no-login unsubscribe link (unsubToken). We store only the email + status + timestamps
// + preferred locale — no other PII. Unsubscribing is always honoured.
model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  status         String    @default("pending") // pending | active | unsubscribed
  locale         String    @default("en") // preferred email language (en | fr)
  confirmToken   String?   @unique // consumed when the confirm link is clicked
  unsubToken     String    @unique // stable; embedded in every email
  createdAt      DateTime  @default(now())
  confirmedAt    DateTime?
  unsubscribedAt DateTime?

  @@index([status])
}

// A profile badge shown Twitch-chat-style next to a user's name (verified, developer,
// moderator, YouTuber, Twitch, certified, …). Admin-created & configurable.
model Badge {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String      @default("")
  // Visual: a lucide icon name, a simple-icons brand slug, or an uploaded image.
  iconType    String      @default("lucide") // "lucide" | "brand" | "image"
  icon        String      @default("BadgeCheck") // lucide/brand name, or an image URL / data URI
  color       String      @default("#f59e0b")
  // How it's earned: staff grant, the footer easter-egg, or an automatic rule.
  grant       String      @default("manual") // "manual" | "easter_egg" | "auto"
  trigger     String? // for easter_egg: the trigger key (e.g. "footer5x")
  // For grant="auto": the rule that auto-grants it, e.g.
  //   { type:"signup_nth", every:100 }  → every 100th signup (100th, 200th, …)
  //   { type:"signup_before", date:"2026-08-01" } → everyone who signed up before a date
  //   { type:"kofi_donation" } → anyone whose Ko-fi donation is matched to their account
  rule        Json?
  earnMessage String      @default("") // shown when earned (e.g. the footer 5x-click modal body)
  priority    Int         @default(0) // display order next to the name (higher = first)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  holders     UserBadge[]

  @@index([trigger])
}

model UserBadge {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  badgeId   String
  grantedAt DateTime @default(now())
  grantedBy String? // staff user id, or "system" for auto/easter-egg grants

  @@unique([userId, badgeId])
  @@index([userId])
}

// ─── Public API ──────────────────────────────────────────────────────────────

// One API key. Several per account, each named, each scoped, each revocable on its
// own — so a script that only reads a catalog cannot be replayed against the account
// it was minted from.
//
// The secret is NEVER stored. `hash` is its SHA-256 and the key is shown exactly once,
// at creation; losing it means minting another. The old `User.apiToken` sat in the
// database in clear and was re-readable from the profile page forever, which made
// "revoke" the only remedy for a leak nobody could detect (CWE-256, CWE-312).
model ApiKey {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  // What the key is for, in the owner's words. Shown in the list; never sent to callers.
  label      String    @default("")
  // First few characters of the secret, kept in clear on purpose: it is what the list
  // shows so the owner can tell two keys apart without being able to use either.
  prefix     String
  hash       String    @unique
  // Empty means "nothing" — a key with no scope authenticates and is allowed nothing.
  scopes     String[]  @default([])
  lastUsedAt DateTime?
  lastUsedIp String?
  // A test key: every write it makes is simulated, with no header to remember.
  //
  // The sandbox header works and is documented, but it is opt-in per request, which means the
  // one time you forget it you have written to your real account. A key that cannot write is
  // the same protection made structural — you choose it once, when you create the key,
  // instead of correctly every time.
  testMode   Boolean   @default(false)
  // Optional lifetime. A key past its date fails closed, it is not swept.
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  usageDays ApiUsageDay[]
  requests  ApiRequest[]

  @@index([userId, createdAt])
}

// How much a key was used, per day. The count, and nothing else.
//
// Separate from ApiRequest below because the two answer different questions and only one
// of them can be answered by a sample. "Did this key make 12 calls or 12 000?" has to be
// exact and has to stay true for months; "what did call number 300 look like?" is a
// forensic question with a short shelf life. One row per key per day stays small enough to
// keep indefinitely, which is what makes a usage graph honest.
model ApiUsageDay {
  id      String   @id @default(cuid())
  key     ApiKey?  @relation(fields: [keyId], references: [id], onDelete: SetNull)
  keyId   String?
  // Denormalised so the history survives the key: an admin looking at last quarter's usage
  // should not lose it because somebody tidied up a token.
  userId  String
  day     DateTime @db.Date
  count   Int      @default(0)
  errors  Int      @default(0)
  // Sandbox calls are counted here but never added to `count`: the daily figure answers
  // "how much is this key really being used", and a console click is not use. Kept so the
  // usage chart can show exploration as its own band rather than as nothing at all —
  // "nobody is calling us" and "three people are learning the API" look identical otherwise.
  sandbox Int      @default(0)

  @@unique([keyId, day])
  @@index([userId, day])
  @@index([day])
}

// A SAMPLE of individual API calls — method, path, status, duration.
//
// Sampled and short-lived on purpose. Every call kept forever would be a second, unbounded
// copy of the access log inside the primary database, and the value of an individual line
// decays in days. Retention and sample rate are admin settings (api.sampleRate,
// api.retentionDays); the sweeper prunes.
//
// The path is stored WITHOUT its query string. Private share links carry their secret in
// the query (?k=…), and a table of URLs an admin can read is exactly where that must not
// end up (CWE-532).
model ApiRequest {
  id      String   @id @default(cuid())
  key     ApiKey?  @relation(fields: [keyId], references: [id], onDelete: SetNull)
  keyId   String?
  userId  String?
  method  String
  path    String
  status  Int
  ms      Int      @default(0)
  ip      String?
  // A call made from the developer console's sandbox: authenticated and scope-checked, but
  // it wrote nothing. Kept apart from real traffic so somebody exploring the API does not
  // appear in the usage figures as a customer hammering it.
  sandbox Boolean  @default(false)
  at      DateTime @default(now())

  @@index([at])
  @@index([userId, at])
  @@index([keyId, at])
}

// Polls — a question, some options, and an honest count.
//
// `audience` decides who may answer: 'users' (signed in, one vote each, exact) or 'all'
// (anybody, deduplicated by a device fingerprint). Both are offered because both are
// wanted, and the difference between them is a difference in what the number MEANS: the
// signed-in tally is exact, the open one is an estimate that both over- and under-counts
// (two people behind one router look like one; the same person on a phone looks like two).
// Every count is therefore stored and reported split by `wasLoggedIn`, never merged into a
// single reassuring total.
model Poll {
  id          String    @id @default(cuid())
  question    String
  description String    @default("")
  // 'users' | 'all'
  audience    String    @default("users")
  // More than one option allowed? maxChoices caps it (0 = no cap).
  multiple    Boolean   @default(false)
  maxChoices  Int       @default(0)
  // 'draft' | 'open' | 'closed'. Draft is invisible; closed keeps its results.
  status      String    @default("draft")
  opensAt     DateTime?
  closesAt    DateTime?
  // 'always' | 'after_vote' | 'staff' — when a voter may see the tally. after_vote is the
  // default because showing a running total before someone answers steers the answer.
  results     String    @default("after_vote")
  // Shown on the site's poll page, and pinned to the home page when true.
  pinned      Boolean   @default(false)
  // WHERE it can be found — a different question from `audience`, which is who may answer.
  // A poll can be answerable by anyone and still not be listed anywhere.
  //
  //   'public'   listed on /polls, and on the home page when pinned
  //   'unlisted' reachable only at /polls/<id>?k=<shareKey> — not in any list, not in search
  //   'private'  staff only; the link does nothing for anybody else
  //
  // Default 'public' because that is what every existing poll already is: they are all listed
  // today, and a default of anything else would make them vanish on migration.
  visibility  String    @default("public")
  // The secret in an unlisted poll's URL. Empty until the poll is made unlisted, and it is
  // NOT returned to people who cannot already see the poll — otherwise the list endpoint
  // would hand out the keys to everything it is hiding.
  shareKey    String    @default("")
  createdBy   User?     @relation("PollAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  options   PollOption[]
  votes     PollVote[]
  // Multi-question shape. `question` above becomes the TITLE; a single-question poll is one
  // PollQuestion, which is what the backfill turns every existing poll into.
  questions PollQuestion[]
  answers   PollAnswer[]

  @@index([status, pinned])
}

// One question of a poll. `config` carries only what genuinely varies per kind — a scale's
// bounds, whether a choice question allows several answers — and is never aggregated, which is
// why it can be Json while the ANSWER's value cannot.
model PollQuestion {
  id       String       @id @default(cuid())
  poll     Poll         @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollId   String
  // 'choice' | 'text' | 'scale' | 'date' | 'number'. Five, not fifteen: each earns a typed
  // value column below and an aggregate that means something.
  kind     String       @default("choice")
  label    String
  help     String       @default("")
  required Boolean      @default(false)
  sort     Int          @default(0)
  config   Json?
  // One condition on one earlier answer: { questionId, equals: choiceId }. Full branching is
  // where form builders become unmaintainable; widening a Json column later is easy, narrowing
  // a branching engine is not.
  showIf   Json?
  choices  PollChoice[]
  answers  PollAnswer[]

  @@index([pollId, sort])
}

model PollChoice {
  id         String       @id @default(cuid())
  question   PollQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String
  label      String
  sort       Int          @default(0)
  answers    PollAnswer[]

  @@index([questionId, sort])
}

// One row per (voter, question, answer). Four TYPED value columns rather than one Json: a Json
// value would make every question kind free and every aggregate a full table scan, because
// "average rating" over Json cannot use an index — and the statistics are the reason this
// feature exists.
//
// Exactly one value column is non-null per row — with `choiceId` playing two roles depending
// on the question's kind, which is worth stating rather than discovering:
//
//   choice   choiceId IS the value. Nothing else is set.
//   ranking  choiceId says WHICH item, `number` says what rank it was given. Both, on purpose:
//            the answer is a pairing, and splitting it across two rows would make "rank 2" a
//            fact with nothing attached to it.
//
// Everything else sets exactly one of text / number / date and leaves choiceId null. Refining
// the rule this way keeps the aggregates indexable, which is the whole reason the columns are
// typed at all.
model PollAnswer {
  id          String       @id @default(cuid())
  poll        Poll         @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollId      String
  question    PollQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId  String
  choice      PollChoice?  @relation(fields: [choiceId], references: [id], onDelete: Cascade)
  choiceId    String?
  text        String?
  number      Float?
  date        DateTime?
  // WHICH sub-item of the question this row answers. 0 for every kind that has only one thing
  // to answer, and the row index for a grid — where one voter legitimately picks the SAME
  // column for two rows ("Speed: good, Docs: good") and the unique below would otherwise call
  // the second one a duplicate of the first. NOT NULL on purpose: a nullable discriminator is
  // no discriminator at all in Postgres, where every NULL is distinct from every other.
  slot        Int          @default(0)
  user        User?        @relation("PollAnswerer", fields: [userId], references: [id], onDelete: SetNull)
  userId      String?
  voterKey    String?
  // Same reason as PollVote.wasLoggedIn: a closed account must not move its answer into the
  // anonymous column and change a published result.
  wasLoggedIn Boolean      @default(false)
  createdAt   DateTime     @default(now())

  // The uniqueness moves with the data: one answer per (question, voter) for a single-choice
  // question, per (question, voter, choice) when several are allowed. NULLs are distinct in
  // Postgres, so the signed-in and anonymous forms coexist exactly as they do for PollVote.
  // `slot` is in the key so a grid can repeat a column across rows; it is 0 everywhere else,
  // which leaves the constraint exactly as strict as it was for every other kind.
  @@unique([questionId, userId, choiceId, slot])
  @@unique([questionId, voterKey, choiceId, slot])
  @@index([pollId, createdAt])
  @@index([questionId])
  @@index([userId])
}

model PollOption {
  id     String     @id @default(cuid())
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollId String
  label  String
  sort   Int        @default(0)
  votes  PollVote[]

  @@index([pollId, sort])
}

// One row per (voter, option). Multi-choice polls therefore produce several rows for one
// person, which is what makes "62% of voters picked A" computable separately from "A got
// 62% of the ticks" — two different numbers that a single counter would conflate.
//
// voterKey is a per-poll device fingerprint for anonymous voters, and NOT the daily
// analytics visitor hash: that one rotates at midnight, which would quietly let everybody
// vote again every day.
model PollVote {
  id          String     @id @default(cuid())
  poll        Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollId      String
  option      PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionId    String
  user        User?      @relation("PollVoter", fields: [userId], references: [id], onDelete: SetNull)
  userId      String?
  voterKey    String?
  // Kept even after userId is cleared (account closure anonymises the user, and the answer
  // still counted). Without it a closed account would silently move its vote into the
  // anonymous column and change a published result.
  wasLoggedIn Boolean    @default(false)
  createdAt   DateTime   @default(now())

  // NULLs are distinct in Postgres, so these two constraints coexist: one bites for signed
  // -in voters, the other for anonymous ones.
  @@unique([pollId, userId, optionId])
  @@unique([pollId, voterKey, optionId])
  @@index([pollId, createdAt])
  @@index([userId])
}

// What happened to a catalog item, and when — the record the item itself cannot keep.
//
// A deleted item is really deleted: the grace period ends and sweeper.mjs drops the row,
// leaving nothing behind. Without a tombstone the change feed could only ever report
// what still exists, which is the opposite of what a consumer syncing a mirror needs to
// know. So this table outlives the row it describes: `catalogId` goes null, the slug and
// kind stay.
model CatalogAuditLog {
  id        String      @id @default(cuid())
  // Null once the item row is gone. The slug is the durable identity.
  catalogId String?
  slug      String
  kind      CatalogKind
  ownerId   String?
  // created | updated | published | rejected | hidden | restored | deleted
  action    String
  version   String?
  detail    String      @default("")
  createdAt DateTime    @default(now())

  @@index([createdAt])
  @@index([slug, createdAt])
}

/// One signed-in device. Auth itself stays stateless (a JWT in the bcw_session cookie),
/// but the token now carries this row's id as `sid`, which buys two things a bare JWT
/// cannot give: the account owner can SEE where they are signed in, and can revoke a
/// single device without rotating anything global.
///
/// `revokedAt` is checked on every authenticated request, so revocation takes effect at
/// once rather than when the 7-day token happens to expire.
///
/// The IP is kept because it is the whole point of the panel — recognising a session you
/// do not know. Geo is resolved once at sign-in and stored denormalized: it must survive
/// the GeoIP database being updated later, and re-resolving on every read would turn a
/// list into a batch of lookups.
model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip         String?
  userAgent  String?
  device     String?
  browser    String?
  os         String?
  country    String?
  region     String?
  city       String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  /// Set when the user (or a global sign-out) kills this device. Kept rather than deleted
  /// so "signed out from X at Y" stays answerable; the sweeper prunes old rows.
  revokedAt  DateTime?

  @@index([userId, revokedAt])
  @@index([lastSeenAt])
}

/// A staff note about an account, and the record of why an account was closed or erased.
///
/// Deliberately NOT a relation to User. A note explaining why somebody was removed is the note
/// you need AFTER they are gone — a foreign key would cascade it away at the exact moment it
/// starts to matter. The subject is a plain id plus what they were called at the time, so the
/// trail survives the erasure it describes.
model StaffNote {
  id           String @id @default(cuid())
  /// The account this is about. No FK on purpose — see above.
  subjectId    String
  /// Display name + address as they were when the note was written, so a closed account still
  /// reads as a person rather than as a cuid.
  subjectLabel String @default("")

  /// note · closure · ban · suspension · erasure — what produced it. A `note` is somebody
  /// writing something down; the others are stamped by the action itself.
  kind       String  @default("note")
  body       String
  /// For an action: was the reason sent to the person, and to which address.
  notified   Boolean @default(false)
  notifiedTo String?

  author      User?   @relation("StaffNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorId    String?
  /// Denormalised for the same reason as subjectLabel: the author may leave too.
  authorLabel String  @default("")

  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([subjectId, createdAt])
  @@index([kind])
}

/// One row per day, kept forever.
///
/// Raw samples are pruned at 30 days (monitor.mjs), which made "how does this month compare with
/// six months ago" unanswerable — there was nothing left to compare against. This is the summary
/// that survives the prune: ~365 rows a year, small enough to keep indefinitely, detailed enough
/// to answer the question the raw samples cannot.
///
/// Written by the same sweeper that prunes, BEFORE it prunes, and idempotent on `day` so a
/// restart or a double tick cannot double-count.
model ServerMetricDaily {
  day DateTime @id @db.Date

  cpuAvg     Float
  cpuMax     Float
  memAvg     Float
  memMax     Float
  diskAvg    Float
  diskMax    Float
  loadAvg    Float
  latencyAvg Int?
  netRxAvg   Int?
  netTxAvg   Int?

  /// How many raw samples this day is made of — a day with four is not a day with 144, and a
  /// reader comparing two of them deserves to know which they are looking at.
  samples     Int @default(0)
  /// Minutes the sampler was not running, from the gaps between consecutive samples.
  downMinutes Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A moderation action the admin asked for, waiting for the bot to carry it out.
///
/// A QUEUE, not a call. The API cannot reach into Discord — the bot polls for work and reports
/// back, which is how every other bot feature here already works (dm/pending, links/pending,
/// kofi/unannounced). Inventing a push channel for this one would be a second architecture to
/// keep alive.
///
/// It also means the outcome is recorded rather than assumed: a ban that Discord refused
/// because the bot's role sits below the target's is a normal, frequent failure, and the admin
/// has to see it instead of watching a button go green.
model BotAction {
  id          String @id @default(cuid())
  /// ban · unban · kick · timeout · untimeout
  kind        String
  discordId   String
  /// Which guild the action targets (B4). Nullable for rows created before the field existed;
  /// when set, a successful action is recorded in that guild's ModerationLog (mode permitting).
  guildId     String?
  /// Who it is about, as they were named when it was asked for — the member may leave.
  targetLabel String @default("")
  reason      String @default("")
  /// For a timeout, and for a ban that should lift itself. Null means permanent.
  minutes     Int?
  /// For role_add / role_remove: the role to give or take.
  roleId      String?

  requestedBy      User?   @relation("BotActionRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  requestedById    String?
  requestedByLabel String  @default("")

  /// pending · done · failed
  status      String    @default("pending")
  /// What Discord said when it refused. The single most useful field on this row.
  error       String?
  createdAt   DateTime  @default(now())
  attemptedAt DateTime?

  @@index([status, createdAt])
  @@index([discordId])
}

/// A warning given to a Discord member, and the reason they were given it.
///
/// Warnings are the part of moderation that is NOT an action: nothing happens to the member
/// when one is written. What makes them worth storing is the count — three of them mean
/// something the third one does not mean on its own — and the reason, because "you have been
/// warned" without one teaches nobody anything and is impossible to appeal.
///
/// Kept beside BotAction rather than inside it: an action is a thing Discord must be asked to
/// do and can refuse, and a warning is a fact we record. Merging them would give every warning
/// a pending/failed status it can never have.
///
/// A revoked warning is kept, not deleted. "This was withdrawn on the 4th" is part of the
/// record, and a count that silently drops rows makes the escalation unexplainable.
model BotWarn {
  id          String  @id @default(cuid())
  discordId   String
  /// Who it is about, as they were named at the time — the member may leave or rename.
  targetLabel String  @default("")
  reason      String
  guildId     String?

  issuedBy      User?   @relation("BotWarnIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  issuedById    String?
  issuedByLabel String  @default("")

  /// What the count triggered, if anything — recorded on the warning that crossed the line so
  /// the escalation can be explained months later.
  triggered     String?
  revokedAt     DateTime?
  revokedById   String?
  revokedReason String?
  createdAt     DateTime  @default(now())

  @@index([discordId, revokedAt])
  @@index([createdAt])
}

/// Somebody who wants to be told when a service goes down, and when it comes back.
///
/// Double opt-in for e-mail, like the newsletter: an unconfirmed row is never written to. A
/// Discord target needs no confirmation because only an admin can add one — you cannot
/// subscribe somebody else's channel from the public page.
model StatusSubscriber {
  id     String   @id @default(cuid())
  /// email · discord
  kind   String   @default("email")
  /// The address, or the Discord channel id.
  target String
  /// Which services they care about. Empty means all of them — the common case, and it must
  /// keep working when a new service is added rather than silently excluding it.
  deps   String[] @default([])

  confirmed    Boolean @default(false)
  confirmToken String? @unique
  /// Also the unsubscribe token: one link in every message, no login needed.
  token        String  @unique

  createdAt  DateTime  @default(now())
  lastSentAt DateTime?

  @@unique([kind, target])
  @@index([confirmed])
}

/// A human note attached to an outage — what happened, and what was done about it.
///
/// Separate from ServiceOutage because the outage is DETECTED (start, end, which service) while
/// this is WRITTEN afterwards. Merging them would mean an automatic row carrying empty prose,
/// and no way to tell "nobody has explained this yet" from "there was nothing to say".
model IncidentNote {
  id       String        @id @default(cuid())
  outage   ServiceOutage @relation(fields: [outageId], references: [id], onDelete: Cascade)
  outageId String

  /// investigating · identified · watching · resolved
  state      String  @default("investigating")
  body       String
  /// Shown on the public page. An admin may want to record something internal first.
  publicNote Boolean @default(true)

  authorId    String?
  authorLabel String   @default("")
  createdAt   DateTime @default(now())

  @@index([outageId, createdAt])
}

/// Something the site wants said in Discord, waiting for the bot to say it.
///
/// The same queue shape as BotAction and for the same reason: the API cannot reach Discord, the
/// bot polls. What this adds over the existing alert path is that these are EDITORIAL — an
/// event, a promotion, a commission request — so they carry their own channel choice and their
/// own urgency, and a failure to post is recorded rather than lost.
model BotAnnouncement {
  id        String  @id @default(cuid())
  /// event · promo · myo · incident · custom
  kind      String
  title     String
  body      String  @default("")
  /// Where it should end up. Optional: unset means the bot's general channel, which is the
  /// honest default — a new kind should be loud where people watch, not dropped because
  /// nobody configured a channel for it.
  channelId String?
  url       String?
  /// Shown as a colour and a mention-worthy flag. A commission that is urgent and one that is
  /// not are read by the same person at very different speeds.
  urgent    Boolean @default(false)

  /// How it is presented: embed · text · both. Chosen per announcement rather than fixed in
  /// the bot — a card and somebody talking are different registers, and an incident notice
  /// and a promotion do not want the same one.
  format    String  @default("embed")
  /// Optional accent colour (hex) and banner image. NULL keeps the per-kind colour the bot
  /// already picks, so an existing row renders exactly as it did.
  color     String?
  image     String?

  status    String    @default("pending") // pending · sent · failed
  error     String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([status, createdAt])
}

// A recorded session replay (rrweb), for the admin analytics screen.
//
// OFF by default and admin-gated, because this is the heaviest thing the site can collect: it
// reproduces what a page LOOKED like, not a count. Two guards are structural rather than
// optional — the recorder masks every input value before an event is created (so a typed
// password or address never exists client-side to be sent), and nothing records at all unless
// the visitor accepted the analytics category. Both are stated in the privacy policy, which
// was updated in the same commit that added this.
//
// `visitor` is the SAME daily-rotating anonymous hash the rest of analytics uses, so a replay
// cannot be joined to an account or followed across days.
model SessionReplay {
  id         String   @id @default(cuid())
  // The client's id for one recording, so the chunks of a single visit land in one row.
  //
  // A replay HAS to arrive in pieces: sendBeacon and a keepalive fetch are both capped at
  // about 64 KB, and five seconds of a normal page is already past that. Sending it whole at
  // the end fails silently — the browser simply refuses and there is no error to see.
  sid        String?  @unique
  visitor    String? // daily anonymous hash (matches AnalyticsEvent.visitor)
  path       String // the page the recording started on
  // The rrweb event stream. Json rather than a relation: it is one opaque artefact that is
  // only ever read whole, by a player.
  events     Json
  // Stored so the admin list can show weight and length without deserialising every stream —
  // the reason a "sessions" screen is slow is usually that it read all of them to draw a list.
  bytes      Int      @default(0)
  durationMs Int      @default(0)
  eventCount Int      @default(0)
  device     String?
  browser    String?
  country    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// ── B14 Community Charity ─────────────────────────────────────────────────────
// One pot per calendar month. BetterCommunity's own share (`orgContribCents`, computed from
// mrr − monthlyBurn and FROZEN at close so a later revenue swing never rewrites a past
// promise) and the community's voluntary gifts (`contributions`) are kept as two distinct
// numbers and summed in the UI — the spec is explicit that they must read as two things in one
// pot. The final donation is sent MANUALLY by an admin, who records the proof here.
model CharityPot {
  id              String                @id @default(cuid())
  month           String                @unique // "2026-09"
  orgContribCents Int                   @default(0)
  currency        String                @default("chf")
  pollId          String? // the association vote for this month (bare link — no Poll back-relation)
  association     String                @default("")
  status          String                @default("open") // open | closing | paid
  paidAt          DateTime?
  proofUrl        String                @default("")
  proofNote       String                @default("")
  contributions   CharityContribution[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

// A community "increase the pot" gift. `userId`/`paymentId` are bare scalars, not relations:
// a contribution can be anonymous (logged-out), and it must survive the contributor deleting
// their account — the money is already in the pot. Written by the payment webhook (Phase 2).
model CharityContribution {
  id          String     @id @default(cuid())
  potId       String
  pot         CharityPot @relation(fields: [potId], references: [id], onDelete: Cascade)
  userId      String? // null = anonymous / logged-out
  amountCents Int
  currency    String     @default("chf")
  paymentId   String? // the Payment row the rail wrote, when applicable
  // The Stripe checkout session id, so a retried webhook credits the pot exactly once.
  sessionId   String?    @unique
  source      String     @default("stripe") // stripe | kofi
  createdAt   DateTime   @default(now())

  @@index([potId])
}

// ── B9 Extra languages ────────────────────────────────────────────────────────
// A language added by an admin at RUNTIME. The compiled `en`/`fr` dictionaries live in the JS
// bundle and are NOT rows here (and are unremovable by construction — the admin API refuses
// those two codes). An added locale is a partial override layer: `strings` holds only the keys
// somebody has translated so far, and every other key falls back to English through `t()`,
// exactly as a missing translation already does. `enabled=false` lets a locale be translated
// privately before it appears in the public picker.
model SiteLocale {
  code        String   @id // BCP-47: 'ru', 'he', 'zh-Hans'
  nativeName  String // shown in the picker, e.g. 'Русский', 'עברית'
  englishName String   @default("") // admin list, e.g. 'Russian'
  rtl         Boolean  @default(false)
  enabled     Boolean  @default(true)
  order       Int      @default(0)
  strings     Json     @default("{}") // { key: value } for THIS locale, partial by design
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled])
}

// ── B-econ: per-user levelling / economy ──────────────────────────────────────
// The XP, level and points a member has earned, keyed to their BCWEB account (XP only accrues
// once a Discord is linked, so a level always maps to a real profile). The bot reports raw
// activity deltas (messages / reactions / voice seconds) to /bot/economy/accrue; the API turns
// XP into a level with the configured curve and grants points on level-up. `points` is the
// spendable balance (shop + casino). Settings (rates, currency, curve) live in bot.config.economy,
// not here — this table is the balances only.
// A Discord member who has NOT linked a BetterCommunity account still earns: messages,
// reactions and voice time accrue XP, levels and points here, keyed by Discord id. Nothing
// can be spent, given or received from this row — the shop, the casino and gifts all need a
// link — and the moment the member links, the row is merged into UserEconomy and deleted.
// Before this, an unlinked member's activity was dropped on the floor and "link to get your
// XP" was an empty promise about the past.
model DiscordEconomy {
  discordId    String   @id
  xp           Int      @default(0)
  level        Int      @default(0)
  points       Int      @default(0)
  voiceSeconds Int      @default(0)
  messages     Int      @default(0)
  reactions    Int      @default(0)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@index([level])
}

model UserEconomy {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  xp           Int      @default(0)
  level        Int      @default(0)
  points       Int      @default(0)
  voiceSeconds Int      @default(0)
  messages     Int      @default(0)
  reactions    Int      @default(0)
  // Per-user override of the global "stats public" default (null = follow the global setting).
  statsPublic  Boolean?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@index([level])
}

// What a member bought with points — the inventory. One row per purchase, whichever door it
// came through (Discord /shop or the site's Boutique). `delivery` holds what was handed over
// (a promo code, the badge's name); `status` is `delivered` for what the API fulfils itself
// and `pending` for a role / custom reward a person still has to hand out.
model EconomyPurchase {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    String
  itemName  String
  kind      String
  cost      Int
  via       String   @default("site") // "site" | "discord"
  status    String   @default("delivered") // "delivered" | "pending"
  delivery  Json?
  // A code is minted on reveal (see lib/economy-shop.mjs), and may then expire; a giftable
  // purchase can change hands, and the giver is remembered.
  revealedAt   DateTime?
  expiresAt    DateTime?
  giftedFromId String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([status])
  @@index([itemId])
}

// Every movement of points, whichever door moved them: level-up grants, staff grants,
// purchases, casino plays, gifts both ways. The histories on both dashboards read this
// table; `economy.historyDays` decides how long it is kept.
model EconomyLedger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   // levelup | grant | purchase | casino | gift_out | gift_in | gift_item_out | gift_item_in | refund
  delta     Int
  balance   Int
  ref       String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([kind, createdAt])
}

// ── Per-project marketplace (K) ─────────────────────────────────────────────
// A project sells items; a purchase is fulfilled by handing over a key (a fixed one, one from a
// pool, or one generated by an external system), some revealed content, or a Discord role.
model ProjectProduct {
  id                String   @id @default(cuid())
  projectKey        String?  // links to Project.key …
  showcaseProjectId String?  // … or a showcase project
  name              String
  description       String   @default("")
  priceCents        Int      @default(0)
  currency          String   @default("usd")
  active            Boolean  @default(true)
  // key_static | key_pool | key_license | key_external | content | file | link | role
  deliveryKind      String   @default("content")
  staticKey         String?
  content           String?
  roleId            String?
  // `file`: the object-storage KEY, never a URL — a signed link is minted per download and
  // expires, so what sits in a purchase row cannot be forwarded to somebody who did not buy.
  fileKey           String?
  fileName          String?
  // What that file WEIGHS. Stored because the alternative is asking object storage for the
  // size of every product's file to answer "how much is the marketplace using" — a listing
  // per product, on a page that draws a bar. Written on upload and cleared on removal, so it
  // is only ever wrong if a file is deleted behind the app's back.
  fileBytes         Int?
  // `link`: a plain URL, handed over as a real button rather than a paragraph of text.
  linkUrl           String?
  externalUrl       String?
  externalSecret    String?
  stock             Int?     // null = unlimited
  sold              Int      @default(0)
  // one_time | subscription. A subscription bills every `intervalMonths` through Stripe and
  // the purchase row carries an `expiresAt` the renewal pushes forward; the delivery is the
  // same one the one-off sale performs, repeated on each renewal.
  billing           String   @default("one_time")
  intervalMonths    Int?
  // The recurring Stripe price, minted on the first subscription checkout and reused after.
  // Cached because a new price per checkout makes the Stripe dashboard unreadable and breaks
  // "how many people are on this plan" for ever.
  stripePriceId     String?
  // Where the buyer USES what they bought, and what to do with it. A key with nowhere to go
  // is a string in an e-mail: this is the site to redeem it on, the app to paste it into, or
  // the doc page that explains it. Shown on the purchase for every delivery kind.
  redeemUrl         String?
  redeemNote        String?
  // The platform's margin on this product, in basis points (1000 = 10%). null = the site
  // default (`AdminSetting marketplace.feePercentBp`). SUPERADMIN-only, because it is the
  // number that decides how much of somebody else's sale we keep.
  feePercentBp      Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  keys              ProjectKey[]
  purchases         ProjectProductPurchase[]

  @@index([projectKey, active])
  @@index([showcaseProjectId, active])
}

/// Who gets paid for the sales on one page.
///
/// The marketplace could always say what a seller was OWED — feeCents and netCents, written
/// on every purchase — and had nowhere to send it. This is the missing half: a Stripe
/// Connect account, so a sale can route the seller's share at the moment it is charged
/// instead of accruing a debt on a spreadsheet.
///
/// Scoped by the SAME string the margin uses (`project:<key>` / `showcase:<id>`, see
/// feeScopeOf). Not per product, because "who gets paid for this page" is one decision;
/// not per user, because the page outlives whoever happened to connect the account.
///
/// The enabled flags are MIRRORED from Stripe's `account.updated` event and are never
/// inferred here. An account exists from the instant onboarding starts and cannot take a
/// charge until Stripe finishes its checks; treating "we created it" as "it works" is how a
/// checkout starts failing for buyers with no visible cause.
model MarketplaceSeller {
  id              String   @id @default(cuid())
  /// "project:<key>" or "showcase:<id>" — the same scope as the per-project margin.
  scope           String   @unique
  /// The Stripe Connect account (acct_…). Unique: one account cannot be the payee for two
  /// pages, because then a payout cannot be attributed to either of them.
  stripeAccountId String   @unique
  /// Who connected it. Audit trail — this is the field that answers "who pointed this
  /// project's revenue at that account", which is the question a theft would raise.
  connectedById   String
  /// Mirrored from Stripe. chargesEnabled is the one the checkout reads.
  chargesEnabled   Boolean @default(false)
  payoutsEnabled   Boolean @default(false)
  detailsSubmitted Boolean @default(false)
  country          String?
  /// Why Stripe has disabled it, verbatim, so the admin screen can say something true
  /// instead of "not ready".
  disabledReason   String?
  /// What Stripe is still waiting for. Shown as-is; the shape is Stripe's, not ours.
  requirements     Json?
  /// Last time the mirror above was refreshed from Stripe.
  syncedAt         DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ProjectKey {
  id          String         @id @default(cuid())
  productId   String
  product     ProjectProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  code        String
  claimedById String?
  claimedAt   DateTime?
  // HELD for one checkout that has not paid yet.
  //
  // Counting free keys at checkout and claiming one in the webhook leaves a window: the pool
  // can empty in between, and then the money is taken for something that cannot be handed
  // over. Refunding that is repair; holding the key is prevention, and a pool is the only
  // delivery kind where the resource is genuinely finite and local.
  //
  // `reservedFor` is the Stripe checkout session (or, for the moment between reserving and
  // creating it, a token this server made up). `reservedUntil` is what makes an abandoned
  // checkout give the key back on its own, so a hold can never become a leak.
  reservedFor   String?
  reservedUntil DateTime?
  createdAt   DateTime       @default(now())

  @@index([productId, claimedAt])
  // The reservation lookup: free keys for a product, by hold state.
  @@index([productId, claimedAt, reservedUntil])
  @@index([reservedFor])
}

model ProjectProductPurchase {
  id         String         @id @default(cuid())
  productId  String
  product    ProjectProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyerId    String
  buyer      User           @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  status     String         @default("paid") // paid | pending | refunded | active | ended
  priceCents Int            @default(0)
  // What the platform kept and what the seller is owed, as they were AT THE SALE. Written
  // rather than derived: the percentage can change, and a payout has to be computable from
  // what was true when the money moved, not from what the setting says today.
  feeCents   Int            @default(0)
  netCents   Int            @default(0)
  // The connected account the seller's share was routed to AT THE SALE, or null when the
  // money stayed with the platform — no payee on file, one Stripe had not enabled yet, or a
  // sale that predates any of this. Recorded rather than looked up later for the same reason
  // feeCents is: the payee can change, and what a payout report has to reconcile is where
  // the money actually went.
  sellerAccountId String?
  // Subscriptions: when the current term ends, and the Stripe subscription behind it.
  expiresAt   DateTime?
  stripeSubId String?
  delivery   Json?
  // The Stripe checkout session this purchase came from, UNIQUE so the database refuses a
  // second one. The idempotency guard used to be a read-then-write over delivery.sessionId
  // with nothing behind it: two overlapping deliveries of the same event both read "no
  // purchase yet" and both proceeded — measured, not theorised, at two purchases, two keys
  // claimed and sold incremented twice for a single payment. Null for a free claim, which
  // has no session.
  checkoutSessionId String? @unique
  // The Stripe PaymentIntent the money actually moved through, recorded on delivery. The
  // session id names the checkout; the payment_intent names the CHARGE, and a refund or a
  // reconciliation ("was this really paid?") needs the charge, not the checkout. Null for a
  // free claim (no charge) and for a subscription (the money moves through invoices).
  paymentIntentId String?
  createdAt  DateTime       @default(now())

  @@index([buyerId, createdAt])
  @@index([productId, createdAt])
  @@index([stripeSubId])
}

/// A Stripe Checkout the DB knows is in flight but has NOT yet been finished by the webhook.
///
/// One row is written the instant a checkout session is created, whatever it is for
/// (marketplace, hosting, a pool, a boost, charity, MYO, a showcase listing…). The webhook is
/// still the source of truth: when it delivers, it flips the row to `delivered`; when Stripe
/// expires the session, to `failed`. What the row buys is the crash case — the webhook never
/// ran (the API was down, the endpoint was misconfigured, the delivery timed out) — because
/// then a row sits at `pending` for ever with nobody watching. lib/stripe-reconcile.mjs walks
/// the stale ones, asks Stripe what really happened, and finishes exactly what the webhook
/// would have, replaying the same handler so there is one delivery path and not two.
model PendingCheckout {
  id        String   @id @default(cuid())
  /// The `metadata.type` the checkout carried (marketplace, cart, charity, feature, …), so a
  /// summary can group by kind and a reader can tell what a stuck row was for.
  kind      String
  /// The Stripe checkout session id. UNIQUE so a session is tracked once — a resent creation
  /// or a double-record is a no-op rather than a second stuck row.
  sessionId String   @unique
  userId    String?
  /// The checkout metadata, verbatim — enough for a human triaging a stuck row to see what it
  /// was and who it belonged to without leaving the admin screen.
  payload   Json?
  /// pending → paid (completed but the money has not cleared, e.g. a delayed bank debit) →
  /// delivered (the webhook, or the reconciler, provisioned it) | failed (expired / abandoned).
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([kind])
}

// ── Rights notices & protected works ─────────────────────────────────────────
//
// A rights-holder notice (or a DSA Art. 16 report) as a RECORD with every element the legal
// page promises to act on — who, what work, exactly where on this service, why, and the two
// statements — instead of a free-text contact message. `targets` is a JSON list of
// { type, id, label, url, files[] } so a takedown can be as narrow as the claim.
// `kind: "match"` rows are not sent by anybody: the protected-works registry produced them
// when a file or a listing matched a registered work (Swiss CopA 39d: prevent the same work
// coming back once we have been told about it).
model RightsNotice {
  id     String @id @default(cuid())
  /// NTC-XXXX-XXXX — quoted in every mail, given by the sender to follow up without an account.
  code   String @unique
  /// copyright · trademark · privacy · illegal · other · match
  kind   String @default("copyright")
  /// new · reviewing · actioned · rejected · countered · restored · closed
  status String @default("new")

  /// NULLABLE: most rights holders have no account here, and a notice outlives a deleted one.
  reporter   User?   @relation("RightsNoticeReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reporterId String?
  name       String  @default("")
  email      String  @default("")
  org        String  @default("")
  /// owner · licensee · agent
  onBehalfOf String  @default("owner")
  address    String  @default("")
  country    String  @default("")
  phone      String  @default("")

  targets     Json    @default("[]")
  work        Json    @default("{}")
  explanation String  @default("")
  goodFaith   Boolean @default(false)
  accurate    Boolean @default(false)
  signature   String  @default("")
  ip          String  @default("")

  reviewedBy   User?     @relation("RightsNoticeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedById String?
  /// What the sender is told. Goes in the mail, so it has to be defensible to the person reading it.
  decision     String    @default("")
  decisionAt   DateTime?
  /// STAFF ONLY. Never sent, never quoted.
  internalNote String    @default("")
  /// The sanctions a takedown issued, so a restore knows what to lift.
  sanctionIds  String[]  @default([])
  /// The accounts answerable for the targets — what the repeat-infringer count is taken over.
  ownerIds     String[]  @default([])
  /// A counter-notice from the person whose content was taken down: { name, email, body, at }.
  counter      Json?
  restoredAt   DateTime?

  /// For a `match`: the registered work it matched, and how.
  work_  ProtectedWork? @relation(fields: [workId], references: [id], onDelete: SetNull)
  workId String?
  /// hash · pattern · url — what fired, for a match.
  matchVia String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([reporterId])
  @@index([email])
  @@index([workId])
}

/// A work somebody has asserted rights over, with what identifies copies of it: file hashes
/// (the work itself), name patterns (a guess a human confirms) and the addresses it was taken
/// from. Matched against every file that lands and every listing that is created.
model ProtectedWork {
  id       String   @id @default(cuid())
  title    String
  owner    String   @default("")
  contact  String   @default("")
  urls     String[] @default([])
  hashes   String[] @default([])
  patterns String[] @default([])
  notes    String   @default("")
  active   Boolean  @default(true)
  hits     Int      @default(0)

  createdBy   User?   @relation("ProtectedWorkAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  notices     RightsNotice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Teams ────────────────────────────────────────────────────────────────────────────────
// A group of accounts that manage repos, catalogues and pools together, with one contact
// address for whoever needs to reach them (see routes/teams.mjs, routes/threads.mjs).
model Team {
  id           String            @id @default(cuid())
  slug         String            @unique
  name         String
  description  String            @default("")
  avatar       String?
  contactEmail String
  contactPhone String?
  website      String?
  discord      String?
  owner        User              @relation("TeamOwner", fields: [ownerId], references: [id])
  ownerId      String
  members      TeamMember[]
  repos        ServerRepo[]
  catalogs     CommunityCatalog[]
  groups       HostingGroup[]
  threads      ContactThread[]   @relation("ThreadTeam")
  invites      TeamInvite[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([ownerId])
}

model TeamMember {
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      String   @default("member") // owner | admin | member
  status    String   @default("active") // invited | active
  invitedBy String?
  createdAt DateTime @default(now())

  @@id([teamId, userId])
  @@index([userId])
}

// ── Contact threads ──────────────────────────────────────────────────────────────────────
// A conversation between whoever presses "Contact" on a repo / catalogue / profile and the
// user or team that manages it. Distinct from Report (that is staff's queue): staff only
// moderate these. An anonymous sender follows the thread by its access token, e-mailed.
model ContactThread {
  id             String                 @id @default(cuid())
  kind           String // repo | catalog | user | team
  targetId       String
  targetLabel    String                 @default("")
  ownerUser      User?                  @relation("ThreadOwner", fields: [ownerUserId], references: [id])
  ownerUserId    String?
  ownerTeam      Team?                  @relation("ThreadTeam", fields: [ownerTeamId], references: [id])
  ownerTeamId    String?
  sender         User?                  @relation("ThreadSender", fields: [senderId], references: [id])
  senderId       String?
  senderEmail    String                 @default("")
  senderName     String                 @default("")
  accessToken    String                 @unique
  subject        String                 @default("")
  status         String                 @default("open") // open | closed | blocked
  ownerUnread    Boolean                @default(true)
  senderUnread   Boolean                @default(false)
  staffFlag      String                 @default("") // "" | flagged | blocked
  ip             String                 @default("")
  lastActivityAt DateTime               @default(now())
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  messages       ContactThreadMessage[]
  /// What the conversation is about, when the target offers topics (a project's contact:
  /// a basic topic id, or one of its custom topics). "" for the kinds that have none.
  topic          String                 @default("")
  /// Files sent in it (project and team inboxes, when their hosting settings allow).
  attachments    ContactThreadAttachment[]

  @@index([ownerUserId, lastActivityAt])
  @@index([ownerTeamId, lastActivityAt])
  @@index([senderId])
  @@index([senderEmail])
  @@index([status])
  @@index([kind, targetId])
}

model ContactThreadMessage {
  id        String        @id @default(cuid())
  thread    ContactThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId  String
  author    User?         @relation("ThreadMsgAuthor", fields: [authorId], references: [id])
  authorId  String?
  side      String // sender | owner | staff
  body      String
  hidden    Boolean       @default(false) // hidden by staff
  createdAt DateTime      @default(now())

  @@index([threadId])
}

// ── Perceptual hashes of uploaded pictures (copyright / lookalike detection) ─────────
// One row per picture we hold — an uploaded image, an image inside an uploaded archive, a
// linked avatar — with its pHash (64-bit DCT hash: two rows within a small Hamming distance
// LOOK the same) and sha256 (byte-identical). Rows are created at presign time (so the owner
// is known) and hashed by the sweeper once the bytes are in storage.
model MediaHash {
  id          String      @id @default(cuid())
  /// The object-storage key, `<key>#<entry>` for an image inside an archive, or the avatar URL.
  key         String      @unique
  /// upload | archive | archive-entry | avatar | team-avatar
  kind        String
  ownerId     String?
  /// What the picture belongs to, when known: user | team | catalog | blog | proof | myo …
  refType     String?
  refId       String?
  contentType String      @default("")
  bytes       Int         @default(0)
  sha256      String?
  /// 16 hex chars; null when the bytes are not a raster image.
  phash       String?
  width       Int?
  height      Int?
  /// pending | hashed | skipped | failed
  status      String      @default("pending")
  error       String?
  hashedAt    DateTime?
  createdAt   DateTime    @default(now())
  flags       MediaFlag[] @relation("FlagSubject")
  matches     MediaFlag[] @relation("FlagMatch")

  @@index([status, createdAt])
  @@index([phash])
  @@index([sha256])
  @@index([ownerId])
}

/// A picture that looks like (or is byte-identical to) one another account uploaded earlier.
/// Staff clear it (a false positive, or the same person on two accounts) or act on it.
model MediaFlag {
  id           String    @id @default(cuid())
  hash         MediaHash @relation("FlagSubject", fields: [hashId], references: [id], onDelete: Cascade)
  hashId       String
  match        MediaHash @relation("FlagMatch", fields: [matchId], references: [id], onDelete: Cascade)
  matchId      String
  distance     Int
  /// near | exact
  reason       String    @default("near")
  /// pending | cleared | actioned
  status       String    @default("pending")
  note         String    @default("")
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@unique([hashId, matchId])
  @@index([status, createdAt])
}

// ── Files handed out by a link that stops working ─────────────────────────────────
// One row per link: a Make Your Own deliverable (a month after delivery, or a week after
// the first download — whichever comes first), a file attached to an admin mail, a
// platform asset with a shelf life. `/f/<token>` resolves it; past its date the link answers
// 410 and the sweeper removes the object. Reusable: any feature that hands out a file for a
// while creates a row here instead of a public URL.
model ExpiringFile {
  id                String    @id @default(cuid())
  token             String    @unique
  /// The object-storage key, or an http(s) URL to redirect to.
  key               String
  fileName          String    @default("")
  contentType       String    @default("")
  bytes             Int       @default(0)
  /// myo | mail | asset
  kind              String
  refId             String?
  /// Who may download: null = anyone holding the token.
  ownerId           String?
  expiresAt         DateTime?
  /// The link also dies this many days after the FIRST download (null = no such rule).
  downloadAfterDays Int?
  firstDownloadAt   DateTime?
  downloads         Int       @default(0)
  maxDownloads      Int?
  revokedAt         DateTime?
  /// Set once the sweeper has deleted the object behind an expired link.
  purgedAt          DateTime?
  createdBy         String?
  createdAt         DateTime  @default(now())

  @@index([kind, refId])
  @@index([expiresAt])
}

/// A shareable invitation link to a team: anyone signed in who opens `/teams/join/<token>`
/// joins with `role`, until the link expires, is revoked or has been used `maxUses` times.
model TeamInvite {
  id        String    @id @default(cuid())
  token     String    @unique
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  role      String    @default("member") // admin | member
  createdBy String
  expiresAt DateTime?
  maxUses   Int?
  uses      Int       @default(0)
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([teamId])
}

// ── Staff task board: teams of admins/moderators, and the work handed to them ───────────
//
// WHY THIS IS NOT THE `Team` MODEL ABOVE
//
// `Team` is customer-facing: an account owns it, it carries a contact address, it holds
// repos, catalogues and hosting pools, an account may own only three of them and buys more
// with `User.extraTeamSlots`. Hanging staff dispatch on it would mean every paying
// customer's team appears in the admin dispatcher, and that "chief" and "owner" — one a
// work role, the other a billing role — become the same column. They are different things
// that happen to share a word, so they are different tables.
//
// WHY THE USER IDS ARE BARE STRINGS
//
// `chiefId`, `assigneeId`, `creatorId`, `actorId` and `StaffTeamMember.userId` are ids
// without a relation, the same shape `ExpiringFile.ownerId` and `MediaFlag.resolvedById`
// already use. A Prisma relation needs a back-reference field on `User`, and `User` is the
// most-edited model in this schema; five more relation fields on it is five more merge
// conflicts for one screen. The cost is that a deleted account leaves rows pointing at
// nothing: the API resolves the ids it needs in one `findMany` and renders a missing one as
// an unknown account rather than failing, and closed tasks KEEP the id of whoever did the
// work, because history that rewrites itself when somebody leaves is not history.
//
// Relations BETWEEN these four models are real, with the cascades spelled out: dissolving a
// team must not delete its tasks (they go back to the unassigned pool, hence SetNull), while
// deleting a task must take its own history with it.
model StaffTeam {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String    @default("")
  /// Exactly one chief, and it is a column rather than a role on the membership row so the
  /// "exactly one" is a fact the database holds rather than an invariant three routes have
  /// to remember. The chief is also always a member row; the API writes both together.
  chiefId     String
  createdById String?
  /// Archived rather than deleted keeps a finished team's task history readable.
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members StaffTeamMember[]
  tasks   AdminTask[]

  @@index([chiefId])
}

model StaffTeamMember {
  team      StaffTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  userId    String
  addedById String?
  createdAt DateTime  @default(now())

  @@id([teamId, userId])
  @@index([userId])
}

model AdminTask {
  id         String     @id @default(cuid())
  title      String
  /// Markdown, rendered by the site's own renderer (ui/md.jsx → @bettercommunity/bmd).
  body       String     @default("")
  /// todo | in_progress | blocked | done | cancelled — see TASK_STATES in lib/tasks.mjs.
  state      String     @default("todo")
  /// low | normal | high | urgent
  priority   String     @default("normal")
  /// Null = the task belongs to no team; only an admin can dispatch it.
  team       StaffTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamId     String?
  /// Who is doing it. Empty = in the team's pool, waiting for the chief to hand it out.
  /// A list since Sept 23 2026: one piece of work often needs two people, and the old single
  /// column made the second one invisible. At most MAX_ASSIGNEES (lib/tasks.mjs).
  assigneeIds String[]  @default([])
  creatorId  String
  dueAt      DateTime?
  closedAt   DateTime?
  closedById String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  events   AdminTaskEvent[]
  linksOut AdminTaskLink[] @relation("TaskLinkFrom")
  linksIn  AdminTaskLink[] @relation("TaskLinkTo")

  @@index([state, priority, dueAt])
  @@index([teamId, state])
}

/// One edge between two tasks. `blocks` is directed (from blocks to; "blocked by" is the same
/// row read from the other end) and the API refuses any edge that would close a cycle, so the
/// blocks graph is a DAG by construction. `relates` is a plain association. Both ends cascade:
/// an edge to a task that no longer exists says nothing.
model AdminTaskLink {
  id          String    @id @default(cuid())
  from        AdminTask @relation("TaskLinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  fromId      String
  to          AdminTask @relation("TaskLinkTo", fields: [toId], references: [id], onDelete: Cascade)
  toId        String
  /// blocks | relates — see LINK_KINDS in lib/tasks.mjs.
  kind        String
  createdById String?
  createdAt   DateTime  @default(now())

  @@unique([fromId, toId, kind])
  @@index([toId])
}

/// A task the SITE proposes: an open outage, a queue waiting on staff, a server alert, an error
/// group. A draft, never a task, until an admin with the right to act on it accepts it.
///
/// `dedupKey` is what makes one incident one proposal: `status:<outageId>`,
/// `pending:<queue>`, `alert:<alertId>`, `error:<groupId>`. The scan upserts on it, so a
/// condition that stays true for a day refreshes one row instead of writing a hundred.
///
/// `title` and `body` are SCRUBBED before they are written (lib/task-suggest.mjs): no URL, no
/// path, no query string, no token-shaped string, no e-mail. The row outlives the log it came
/// from and, once accepted, is read by a whole team that may hold none of the capabilities the
/// log is behind (CWE-532). `sourceCap` is the capability that reads the source; a viewer
/// without it never sees the suggestion. Null = a public source (the status page).
model TaskSuggestion {
  id          String    @id @default(cuid())
  dedupKey    String    @unique
  /// status | pending | alert | error
  source      String
  sourceCap   String?
  title       String
  body        String    @default("")
  priority    String    @default("normal")
  /// An admin path (`/admin?s=errors`), never an external or request URL.
  href        String?
  /// How many sightings / items stand behind it, refreshed by every scan.
  count       Int       @default(1)
  /// open | accepted | dismissed
  state       String    @default("open")
  taskId      String?
  decidedById String?
  decidedAt   DateTime?
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([state, lastSeenAt])
}

/// What happened to a task, append-only. Nothing here is ever updated or deleted except
/// with the task itself: the point of the row is that it says what it said at the time.
model AdminTaskEvent {
  id        String    @id @default(cuid())
  task      AdminTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
  actorId   String?
  /// created | assigned | released | state | priority | due | team | note | reopened | link | unlink
  kind      String
  fromValue String?
  toValue   String?
  note      String    @default("")
  createdAt DateTime  @default(now())

  @@index([taskId, createdAt])
}

// ── The contact inbox: what staff DID with a contact message ─────────────────────────
//
// `ContactMessage` is what the sender wrote, and it is never rewritten. Everything a staff
// member adds afterwards lives here, in two sidecar models rather than in new columns, for
// one reason: the message row is the evidence. A data-export request and a rights notice
// both carry a legal clock, and "when did it arrive" must not share a row with "who is on
// it now", which changes several times a day.
//
// The STATE is the exception and stays on the message, in the `status` column that already
// existed, because it is the one thing every list query filters and sorts by. Its vocabulary
// is now five values instead of two:
//
//   new       nobody has looked at it. The default a message is created with.
//   open      a human has taken it. Legacy rows say `read`, which reads as `open`.
//   waiting   answered, the ball is with the sender. Not on us, not finished.
//   resolved  done. Out of the inbox, still countable.
//   spam      junk. Out of every default view, kept so the sender stays blockable.
//
// Neither model carries a Prisma relation to User or to ContactMessage. `assigneeId` is an
// id we look up when we need a name, exactly like AdminTask.assigneeId above: a relation
// would mean adding a back-reference field to User, and this file is appended to by several
// people at once.
model ContactTicket {
  id String @id @default(cuid())
  /// The ContactMessage this is about. One ticket per message, created the first time
  /// somebody acts on it — an untouched message has no row, which is what `new` means.
  messageId    String    @unique
  assigneeId   String?
  /// low | normal | high. Orthogonal to the kind: a billing question can be urgent and a
  /// security report can be a duplicate somebody already fixed.
  priority     String    @default("normal")
  /// When the first REPLY went out, not the first time it was opened. It is the number the
  /// sender experienced, so it is the only one worth keeping.
  firstReplyAt DateTime?
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([assigneeId])
  @@index([priority])
}

/// One thing a staff member wrote about a message: an answer that was e-mailed to the
/// sender, or a note nobody outside the dashboard ever sees.
///
/// `kind` is the whole security surface of this model. A `note` never leaves; a `reply` is
/// sent as mail. Neither one ever quotes the original body — see composeReplyMail in
/// misc.mjs for why that matters for a security report.
model ContactReply {
  id        String   @id @default(cuid())
  messageId String
  authorId  String?
  /// The author's display name AT THE TIME. Denormalised on purpose: a reply that survives
  /// the account that wrote it should still say who wrote it.
  authorName String  @default("")
  /// reply | note
  kind      String   @default("reply")
  /// Markdown, the same dialect the rest of the site writes. Rendered with B.MD in the
  /// dashboard and with mdToEmailHtml on its way out.
  body      String
  /// Whether the mail actually went. False for a note, and false for a reply written while
  /// e-mail is switched off for this deployment.
  delivered Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([messageId, createdAt])
}

/// Whether a member accepts conversations other members open with them.
///
/// Its own table rather than a column on User, for the same append-only reason as above, and
/// because it is read on exactly one path (opening a `user`-kind ContactThread) rather than
/// on every /me.
///
/// The precedence is the point, and it is written once, in threads.mjs `directMessaging()`:
/// the site switch is a CEILING and this is a FLOOR. A member can refuse conversations the
/// site allows; a member cannot grant conversations the site has switched off. A row only
/// ever subtracts.
model UserMessagingPref {
  /// The member. No relation field: see the note above ContactTicket.
  userId        String   @id
  /// false = nobody may open a new conversation with them, and the ones already open are
  /// frozen rather than deleted. Default true, so an account that never visits the setting
  /// behaves exactly as it did before this existed.
  acceptsDirect Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  @@index([acceptsDirect])
}

/// One "your account was signed in to" notice that was actually raised.
///
/// It exists to answer "have we already told them this?", which is the entire difference
/// between an alert worth reading and a mail every time a phone changes cell tower. The key is
/// (user, reason, fingerprint): the same browser on the same OS does not produce a second
/// notice within the day, and a genuinely different one produces its own immediately.
///
/// The fingerprint is browser|os|device, lowercased — deliberately NOT the IP. An IP changes
/// several times a day on a mobile network without anybody going anywhere, so keying on it
/// would teach people to ignore the one alert that mattered.
///
/// `sessionId` carries no foreign key on purpose: the session sweeper prunes device rows long
/// before these are pruned, and a cascade would delete the record of the warning at exactly
/// the moment somebody goes looking for what happened.
///
/// Never read by an admin surface. This is the account holder's own trail, like /me/sessions.
model LoginAlert {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  /// new_device | new_country | after_failures
  reason      String
  /// browser|os|device, lowercased.
  fingerprint String
  country     String?
  ip          String?
  sessionId   String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, reason, fingerprint, createdAt])
}

/// Read receipts, "like WhatsApp", for every kind of conversation on the site.
///
/// One row per (conversation, SIDE), not per message and not per person. A message's state
/// is derived from the recipient side's two timestamps: read when `readAt >= createdAt`,
/// delivered when `deliveredAt >= createdAt`, otherwise sent. That is two writes per visit
/// rather than one per message, and it is exactly the WhatsApp rule (ticks are monotonic:
/// reading the latest message reads everything before it).
///
/// A SIDE, because the far end is often a group: a team's inbox, the staff queue. "Read" then
/// means somebody on that side opened it, which is what the sender needs to know.
///
///   kind   thread (ContactThread) | report (Report) | myo (MyoRequest)
///   side   thread: sender | owner · report: reporter | staff · myo: user | staff
///
/// `mailDueAt` / `mailedAt` are the debounce for the "you have N unread messages" mail an
/// anonymous sender receives: a burst of replies sets `mailDueAt` once, and one mail leaves
/// when it falls due, counting what is still unread then. Reading the conversation first
/// makes the count zero and the mail is never sent.
///
/// No relation fields: the three conversation tables are unrelated models, and this file is
/// appended to by several people at once.
model ConversationCursor {
  id             String    @id @default(cuid())
  kind           String
  conversationId String
  side           String
  deliveredAt    DateTime?
  readAt         DateTime?
  mailDueAt      DateTime?
  mailedAt       DateTime?
  updatedAt      DateTime  @updatedAt

  @@unique([kind, conversationId, side])
  @@index([mailDueAt])
}

/// A project's contact inbox: whether it takes messages, what about, and who reads them.
///
/// Keyed by the project REF (lib/project-ref.mjs: `bmm` for an official project,
/// `sc:<slug>` for another one), so one table serves both kinds. No row = the defaults:
/// open, the five basic topics, readable by the project's managers and its editors.
///
/// Who reads the inbox is the per-project permission system, reused rather than copied
/// (lib/project-contact.mjs `inboxAccess`):
///   · the managers of that kind of project (manage_projects / manage_showcase);
///   · its editors (ProjectPermission, and scoped roles with the `pages` right), unless
///     `editorsSeeInbox` is off for this project;
///   · anybody holding a scoped CustomRole with the `inbox` right on it;
///   · and the accounts listed in `inboxUserIds`, for the one-off "this person answers
///     the Discord bot's mail" case a role is too heavy for.
model ProjectContactSettings {
  ref             String   @id
  enabled         Boolean  @default(true)
  /// The basic topics this project offers, by id (see BASIC_TOPICS). Unknown ids are ignored.
  basicTopics     String[] @default(["question", "bug", "translation", "suggestion", "other"])
  /// Its own topics: [{ id, label, labelFr }], at most twelve.
  customTopics    Json     @default("[]")
  editorsSeeInbox Boolean  @default(true)
  inboxUserIds    String[] @default([])
  updatedAt       DateTime @updatedAt
  updatedBy       String?
}

/// Hosting settings for ONE thing instead of for the whole site: a blog, a project's contact
/// inbox, a team's contact inbox. One mechanism for all three (lib/entity-hosting.mjs), so a
/// fourth is a new `kind`, not a new table.
///
///   kind   blog | project-contact | team-contact
///   ref    blog, project-contact: the project ref (lib/project-ref.mjs) · team-contact: Team.id
///
///   mode   inherit    the site-wide setting, exactly as before this existed (no row = this)
///          custom     its own caps: maxItems (count) and maxKB (size), 0 = no cap on that axis
///          unlimited  no cap at all
///          pool       no allowance of its own ("0 limit"): its storage is `quotaBytes`
///                     RESERVED from the HostingGroup `poolId`, counted against that pool like
///                     a repo's quota, so the same bytes cannot be handed out twice
///
///   attachments (contact kinds only): inherit | off | always | pool_only — whether a message
///   may carry files: never, always (on the site's storage), or only once a pool pays for it.
///
/// No relation fields, on purpose: `ref` names rows in three different tables, and this file
/// is appended to by several people at once.
model EntityHostingSettings {
  id              String   @id @default(cuid())
  kind            String
  ref             String
  mode            String   @default("inherit")
  maxItems        Int      @default(0)
  maxKB           Int      @default(0)
  poolId          String?
  quotaBytes      BigInt   @default(0)
  attachments     String   @default("inherit")
  maxAttachmentMB Int      @default(0)
  updatedBy       String?
  updatedAt       DateTime @updatedAt

  @@unique([kind, ref])
  @@index([poolId])
}

/// A file sent in a contact conversation. Stored under `contact/<threadId>/`, which the
/// public media proxy never serves: it is read only through the participant routes in
/// threads.mjs, like a proof-of-rights document. Whether a message may carry files at all,
/// and how big, is the target's hosting settings (lib/entity-hosting.mjs attachmentPolicy);
/// the bytes are counted against the target's own cap or its pool reservation.
model ContactThreadAttachment {
  id        String        @id @default(cuid())
  thread    ContactThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId  String
  messageId String?
  key       String
  name      String
  mime      String
  size      Int
  createdAt DateTime      @default(now())

  @@index([threadId])
  @@index([messageId])
}

/// A team's contact inbox: who in the team answers it, and how many conversations it keeps
/// open. No row = the defaults: every active member answers, no cap.
///
///   answerRoles     the team roles that read AND answer the team's conversations (those
///                   addressed to the team, and those about its repos and catalogues)
///   maxOpenMembers  open conversations started by signed-in members, 0 = no cap
///   maxOpenAnon     open conversations started by anonymous senders, 0 = no cap
///
/// Storage and files are EntityHostingSettings kind 'team-contact', ref = the team id.
model TeamContactSettings {
  teamId         String   @id
  answerRoles    String[] @default(["owner", "admin", "member"])
  maxOpenMembers Int      @default(0)
  maxOpenAnon    Int      @default(0)
  updatedAt      DateTime @updatedAt
}
