// BetterCommunity Web — data model. `npx prisma migrate dev` to apply.
generator client {
  provider      = "prisma-client-js"
  // native = local dev; musl target = the alpine containers.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Runtime queries go through `url` (which can point at PgBouncer in transaction
  // pooling mode, `?pgbouncer=true`), while migrations / `db push` use `directUrl`
  // (a direct Postgres connection — PgBouncer transaction mode can't run them).
  // By default both are the same direct connection, so nothing changes until you
  // actually enable the pgbouncer compose profile.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Role {
  USER
  MOD
  ADMIN
  SUPERADMIN // implicitly satisfies every requireRole()/Protected role check — see lib.mjs
}

enum ProjectKey {
  community
  bmm
  bsm
  installer
  // The developer blog. A ProjectKey rather than a new "category" concept: a blog space
  // already carries everything this needs — its own page, a home-news toggle, per-space
  // permissions, the visibility gate — and a parallel taxonomy would have to grow all of
  // that again, differently.
  developers
}

enum CatalogKind {
  APP
  PLUGIN
  THEME
  PRESET
}

enum ItemStatus {
  PENDING
  PUBLISHED
  REJECTED
  HIDDEN
  SUSPENDED // admin-locked: not public, and the owner CANNOT resubmit (unlike REJECTED)
}

enum SubmissionType {
  NEW
  UPDATE
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum RepoStatus {
  PROVISIONING
  ONLINE
  SUSPENDED
  OFFLINE
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  // Null for accounts created purely via OAuth (GitHub/Discord) that never set a
  // password — /auth/login rejects those with a clear "use <provider> to sign in"
  // error instead of crashing on argon2.verify(null, ...).
  passwordHash      String?
  displayName       String
  role              Role      @default(USER)
  // Fine-grained capability grants layered ON TOP of the role (e.g. a MOD/USER granted
  // "manage_repos"). ADMIN/SUPERADMIN implicitly have every capability; see CAPABILITIES
  // in lib/lib.mjs. Empty for most accounts.
  permissions       String[]  @default([])
  // Custom, SUPERADMIN-authored roles (CustomRole) assigned to this user. Each expands
  // into a bundle of capabilities that are UNION-ed with `permissions` to form the
  // user's effective caps (see currentUser() in lib/lib.mjs). A user may hold several.
  // Denormalized id list (matches the codebase's String[] idiom); dangling ids left by a
  // deleted role are simply ignored at resolution time.
  customRoleIds     String[]  @default([])
  emailVerified     Boolean   @default(false)
  bio               String    @default("")
  avatar            Json? // { variant, seed } for the Boring Avatar
  termsAcceptedAt   DateTime? // last time the user accepted the Terms + Payments policy at checkout
  stripeCustomerId  String?   @unique
  apiKeys           ApiKey[]
  polls             Poll[]     @relation("PollAuthor")
  oauthClients      OAuthClient[] @relation("OAuthClientOwner")
  pollVotes         PollVote[] @relation("PollVoter")
  pollAnswers       PollAnswer[] @relation("PollAnswerer")
  sessions          Session[]
  createdAt         DateTime  @default(now())

  // ── 2FA (TOTP) — see totp.mjs. Recovery codes are argon2 hashes, one-time use. ──
  totpSecret        String?
  totpEnabled       Boolean   @default(false)
  totpRecoveryCodes String[]  @default([])
  // Extra, SUPERADMIN-grantable permission (orthogonal to the role hierarchy)
  // required — together with a step-up 2FA challenge — to reach the server-control
  // tools (perf dashboard actions, Docker, terminal, power). See lib.mjs's
  // requireElevated() and server-control.mjs.
  canControlServer  Boolean   @default(false)
  // Admin-tier grant to view the BMM telemetry dashboard. Enforced at the Caddy
  // edge via forward_auth → GET /api/telemetry/authorize (telemetry.mjs), so the
  // separate telemetry app itself is never touched. SUPERADMIN is always allowed.
  canViewTelemetry  Boolean   @default(false)
  // Bumped on logout — invalidates any outstanding telemetry SSO token / tele_session
  // cookie so a signed-out user immediately loses BMM-telemetry access (telemetry.mjs
  // bakes this epoch into the token + host cookie and rejects on mismatch).
  telemetryEpoch    Int       @default(0)
  // Set once, the first time a Ko-fi donation webhook matches this account's
  // email — gates the one-time 25% hosting discount grant so repeat donations
  // (or webhook retries) don't mint duplicate codes.
  kofiDonorAt       DateTime?

  // ── Account moderation (admin suspend / ban) ──────────────────────────────────
  // `status` gates login AND live sessions (enforced via a short-TTL cache in lib.mjs
  // so a JWT session dies within ~15s of a ban). `suspended` is a lighter temporary
  // lock; `banned` is the harsher one — same mechanics, different label + messaging.
  // Both carry a reason (shown to the user + emailed) and an optional lift date
  // (`moderationUntil` null = permanent). Expired locks read as active and are cleared
  // lazily at next login.
  status           String    @default("active") // active | suspended | banned
  moderationUntil  DateTime? // when a temp lock lifts; null = permanent
  moderationReason String? // reason shown to the user + emailed
  moderatedAt      DateTime?
  moderatedById    String?

  // ── Public profile ──────────────────────────────────────────────────────────
  // A shareable /u/<id> page shows only the pseudo, avatar, badges, join date, role,
  // and PUBLIC repos/catalogs — no email or other PII. The owner controls visibility.
  // ── Account closure ──────────────────────────────────────────────────────
  // Closing is a REQUEST with a month of grace, not an act. What finally happens is
  // anonymisation, never a row delete: twenty-nine tables point at a user, and the ones
  // that matter most — payments, the audit chain — are exactly the ones that must survive
  // for as long as the law says. So the row stays and everything personal is scrubbed off
  // it, which keeps every invoice attached to something without keeping a person.
  closureRequestedAt  DateTime?
  closureScheduledFor DateTime?
  // The cancel link. Random, and usable for as long as the closure is pending — someone
  // changing their mind may be doing it from an email on a device they are not signed in
  // on, and "log in first to stop your account being deleted" is a trap.
  closureToken        String?   @unique
  closedAt            DateTime?
  // Set when STAFF scheduled the closure rather than the account holder. Both fields are
  // null on a self-request, which is how the two are told apart everywhere else.
  closureReason       String?
  closureBy           String?
  // Can the account holder call this off? True for anything they asked for themselves.
  // Staff choose: a closure meant as a sanction that the target can undo with one click is
  // not a sanction, and one they CANNOT undo needs to be a deliberate choice rather than a
  // side effect of who pressed the button. When false no cancel token is minted at all —
  // an unusable link in an email is worse than no link.
  closureCancellable  Boolean   @default(true)
  // What everything this account owns looked like BEFORE the closure suspended it.
  //
  // During the grace period nothing is deleted — repos, catalogs and items are suspended, so
  // the account stops serving content while it is on its way out but nothing is lost if it
  // changes its mind. Restoring then has to put each one back where it WAS: a repo that was
  // OFFLINE must return to OFFLINE, not to ONLINE. That is only possible if the previous
  // state was written down, so it is, here, as { repos: {id: status}, catalogs: {id: {...}},
  // items: {id: status} }.
  closureSuspendState Json?
  // The same snapshot, for a MODERATION suspension. Separate from the closure one because
  // the two can overlap — an account can be suspended and then closed — and one field would
  // let the second event overwrite the first's memory of the original state.
  moderationSuspendState Json?
  // Which notification CATEGORIES this account has switched off, as { category: false }.
  //
  // Absent means enabled, so a new category starts on for everybody and nobody has to opt
  // in to being told about their own things. Stored as JSON rather than a table because it
  // is a handful of booleans read on every notify() — one row read instead of a join.
  notifPrefs        Json?
  // SHA-256 of the email the account had before anonymisation.
  //
  // Closing erases the address, which is the point — but it also erases the only link
  // between a closed account and the person who comes back. Without this, someone banned
  // for cause could close, re-register with the same address, and arrive with a clean
  // record; and someone returning in good faith would lose the history they earned. The
  // hash matches without storing the address: it can confirm "this is the same mailbox",
  // and it cannot be read back into one.
  closedEmailHash     String?
  // The closed account this one was recognised as coming back to.
  priorUser           User?     @relation("AccountReturn", fields: [priorUserId], references: [id], onDelete: SetNull)
  priorUserId         String?
  returnedAccounts    User[]    @relation("AccountReturn")
  profilePublic    Boolean   @default(true) // false = only the owner + staff (mod+) can view
  // Which linked connections to surface on the profile, e.g. ["github","discord","website"].
  // Empty = show none. The owner opts each in explicitly.
  showConnections  String[]  @default([])
  website          String? // optional public link the user chooses to show

  badges             UserBadge[]

  items              CatalogItem[]
  communityCatalogs  CommunityCatalog[]
  submissions        Submission[]
  notifications      Notification[]
  serverRepos        ServerRepo[]
  subscriptions      Subscription[]
  posts              BlogPost[]
  payments           Payment[]
  hostingGroups      HostingGroup[]
  creatorLinks       CreatorLink[]
  discordLinks       DiscordLink[]
  blogPermissions    BlogPermission[]
  projectPermissions ProjectPermission[]
  myoRequests        MyoRequest[]
  myoAssigned        MyoRequest[]        @relation("MyoAssignee")
  myoMessages        MyoMessage[]
  submissionComments SubmissionComment[]
  contactMessages    ContactMessage[]
  reportsMade         Report[]            @relation("ReportReporter")
  reportMessages      ReportMessage[]
  reportParticipations ReportParticipant[]
  socialConnections   SocialConnection[]
  loginAttempts      LoginAttempt[]
  auditLogEntries    AuditLogEntry[]
  repoFavorites      RepoFavorite[]
  catalogFavorites   CatalogFavorite[]
  oauthAccounts      OAuthAccount[]
  blogComments       BlogComment[]
  docComments        DocComment[]

  @@index([status])
  @@index([closedEmailHash])
  @@index([priorUserId])
  // Moderation paperwork. `sanctions` is what landed ON them; `sanctionsIssued` is what
  // they handed out as staff — two different questions, and conflating them in one
  // relation would make both unanswerable.
  sanctions        Sanction[] @relation("SanctionTarget")
  sanctionsIssued  Sanction[] @relation("SanctionIssuer")
  staffNotes       StaffNote[] @relation("StaffNoteAuthor")
  sanctionEvidence SanctionAttachment[] @relation("SanctionAttachmentAuthor")
  pendingDismissals PendingDismissal[]
  webhooks         WebhookEndpoint[]
}

// A GitHub/Discord identity linked to a website account — powers "Continue with
// GitHub/Discord" login AND signup (see oauth.mjs). Distinct from DiscordLink,
// which is a BMM/bot-gated pairing, not an auth method.
model OAuthAccount {
  id                String   @id @default(cuid())
  user              User     @relation(fields: [userId], references: [id])
  userId            String
  provider          String // 'github' | 'discord'
  providerAccountId String
  username          String?
  linkedAt          DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// A Discord account linked to a website account. One Discord id ↔ one account.
// Enables gated channel access (BMM + Discord + BCWEB) and telemetry enrichment.
model DiscordLink {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  discordId   String   @unique
  username    String?
  linkedAt    DateTime @default(now())
  // Set when a link is created/refreshed (e.g. via Discord OAuth sign-in) so the bot's
  // buffer poll (/bot/links/pending) can pick it up and refresh the member's roles.
  pendingSync Boolean  @default(false)

  @@index([userId])
  @@index([pendingSync])
}

// Discord activity reported by the bot, keyed by Discord id — surfaced in the BMM
// telemetry dashboard alongside the linked creator id (join date, last message, last
// voice join/create, avatar/username).
model DiscordActivity {
  discordId         String    @id
  username          String?
  avatar            String? // full CDN avatar URL
  guildJoinedAt     DateTime?
  lastMessageAt     DateTime?
  lastVoiceJoinAt   DateTime?
  lastVoiceCreateAt DateTime?
  updatedAt         DateTime  @updatedAt

  // The storage-cap sweeper evicts oldest-updated rows first (`orderBy updatedAt asc take N`);
  // without this it full-sorts the table on every prune — worst exactly when it's at its cap.
  @@index([updatedAt])
}

// Short-lived pairing code the bot issues (via /link) so a website account can claim
// the Discord id by entering the code on BCWEB. Redeeming creates a DiscordLink.
model DiscordLinkCode {
  id        String   @id @default(cuid())
  code      String   @unique
  discordId String
  username  String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// A short-lived pairing code BMM requests (local-first) so a website account can
// claim the creator id by entering the code. Redeeming it creates a CreatorLink.
model LinkCode {
  id          String   @id @default(cuid())
  code        String   @unique
  creatorId   String
  displayName String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([expiresAt])
}

// A BMM creator id linked to an account. One creator id ↔ one account (unique),
// but an account may link several. Locked from unlinking until unlinkableAt.
model CreatorLink {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id])
  userId       String
  creatorId    String   @unique
  displayName  String? // the creator's display name as reported by BMM
  linkedAt     DateTime @default(now())
  unlinkableAt DateTime // linkedAt + 14 days (2-week lock)

  @@index([userId])
}

// Permanent record that a creator id (or, absent one, an account) has already
// claimed its ONE free hosted repo / free catalog upload. Deliberately never
// deleted — unlike CreatorLink, which a user CAN delete by unlinking — so
// unlink-then-relink-elsewhere can't be used to claim a second free item on the
// same creator id.
model FreeTierClaim {
  id        String   @id @default(cuid())
  kind      String // "REPO" | "CATALOG"
  creatorId String? // set when the claim is tied to a creator id
  userId    String // the account that made the claim (informational)
  createdAt DateTime @default(now())

  @@unique([kind, creatorId])
  @@index([userId])
}

// A storage pool for "multi-repo" hosting: the user divides poolBytes across
// several repos. Single-repo hosting doesn't use a group (each repo owns its quota).
model HostingGroup {
  id              String             @id @default(cuid())
  owner           User               @relation(fields: [ownerId], references: [id])
  ownerId         String
  name            String
  // Same provenance flag as ServerRepo.freePlan — a pool provisioned via the $0 Free
  // plan. The Free-pool gauge counts a free pool by its poolBytes (not per-repo), so
  // splitting the pool across repos can't inflate the count.
  freePlan        Boolean            @default(false)
  poolBytes       BigInt             @default(0) // total storage the user can distribute
  color           String             @default("") // owner-chosen accent colour for the dashboard card
  uploadLimitKbps Int                @default(8192) // sandbox upload cap applied to every repo
  cpuShare        Float              @default(0.5)
  createdAt       DateTime           @default(now())
  repos           ServerRepo[]
  catalogs        CommunityCatalog[]
  subscriptions   Subscription[] // the pool's hosting subscriptions (>1 once pools are merged)

  @@index([ownerId])
}

model Project {
  id             String        @id @default(cuid())
  key            ProjectKey    @unique
  name           String
  // Per-blog toggle: do this project's posts also surface in the home page's
  // unified "Latest news"? They always show on /blog regardless of this flag.
  showOnHomeNews Boolean       @default(true)
  // Opt-in "Blog" tab on the project's own page, showing only this project's posts.
  showBlogTab    Boolean       @default(false)
  posts          BlogPost[]
  items          CatalogItem[]
  catalogs       CommunityCatalog[]

  // Same visibility gate as ShowcaseProject (see there for the full comment) —
  // applies to every fixed project EXCEPT 'community', which is always public
  // (enforced in projects.mjs, not here, since Prisma can't express a per-row
  // enum exception).
  visibility          String @default("public")
  visibilityWhitelist Json   @default("[]")

  // Same staged-edit mechanism as ShowcaseProject.scheduledNext, but the payload
  // is just `{ config }` — a fixed project's name/key never change.
  scheduledAt   DateTime?
  scheduledNext Json?
}

model BlogPost {
  id                String           @id @default(cuid())
  // A post belongs to exactly one blog "space" — a fixed Project (bmm/bsm/community/
  // installer) OR an admin-created ShowcaseProject ("custom" page). Exactly one of
  // project/showcaseProject is set; enforced in blog.mjs (Prisma can't express an
  // either-or FK constraint directly).
  project           Project?         @relation(fields: [projectId], references: [id])
  projectId         String?
  showcaseProject   ShowcaseProject? @relation(fields: [showcaseProjectId], references: [id])
  showcaseProjectId String?
  author            User             @relation(fields: [authorId], references: [id])
  authorId          String
  title             String
  slug              String           @unique
  excerpt           String           @default("")
  cover             String? // cover image URL
  coverInBody       Boolean          @default(true) // also show the cover at the top of the article body
  body              String // markdown (supports images, embeds, links)
  // Optional French translation. When absent, readers see the base (EN) marked "not translated".
  titleFr           String?
  excerptFr         String?
  bodyFr            String?
  status            PostStatus       @default(DRAFT)
  publishedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Author-configured reactions: on/off + up to 3 reaction types (emoji). The
  // reactions themselves live in BlogReaction (one per user per post).
  reactionsEnabled Boolean        @default(false)
  reactionTypes    String[]       @default([])
  reactions        BlogReaction[]
  // Auto table-of-contents (a "sommaire") rendered from the post's headings.
  showToc          Boolean        @default(false)
  tocTitle         String?
  // Collaborative authoring: extra author user ids beyond `authorId`. Their avatars
  // render at the bottom of the post next to the main author's.
  coAuthorIds      String[]       @default([])
  // Optimistic-concurrency counter — bumped on every content save. A PATCH carrying a
  // stale baseVersion means someone else saved in the meantime → the client 3-way
  // merges (see merge3.js) instead of clobbering.
  version          Int            @default(1)
  revisions        BlogRevision[]
  // Editor-collaboration comments (threaded). `commentsPublic` = readers can also SEE
  // them on the published article (they still can't post — comments are an editor tool).
  comments         BlogComment[]
  commentsPublic   Boolean        @default(false)
  // Set the first time this post is announced to newsletter subscribers, so editing a
  // published post later never re-blasts everyone (see notifyNewsletterOfPost).
  newsletterSentAt DateTime?

  @@index([showcaseProjectId])
}

// A threaded comment on a blog post — an editor-collaboration tool (like a PR review
// comment). Any editor of the post (author / co-author / staff) can read, add, resolve,
// and EDIT any comment (collaborative). `anchor` optionally pins it to a section/line
// label. When the post is `commentsPublic`, readers see them read-only.
model BlogComment {
  id        String   @id @default(cuid())
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  parentId  String? // null = top-level thread; else a reply to this comment id
  anchor    String? // freeform pin label (e.g. a heading or "line 42"); null = general
  body      String
  resolved  Boolean  @default(false)
  // Everyone who has EDITED this comment (collaborative) — their pfps show on it.
  editorIds String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
}

// A snapshot of a blog post's content, captured BEFORE each content save — the edit
// history. Nothing is lost: reverting is just re-saving an old snapshot (which itself
// snapshots the then-current state). Pruned to the most recent N per post.
model BlogRevision {
  id        String   @id @default(cuid())
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  version   Int // the version number this snapshot represents
  title     String
  body      String
  bodyFr    String?
  editorId  String? // who authored this snapshot (may be deleted later)
  createdAt DateTime @default(now())

  @@index([postId, version])
}

// GitBook-style documentation: a flat set of pages grouped into named categories,
// rendered with the doc-block markdown system (md.jsx). Only ADMIN/SUPERADMIN can
// create/edit/reorder/delete pages (the "special role"); everyone can read published
// ones. `order` sorts within a category; categories sort by their pages' min order.
model DocPage {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  // The sidebar entry and the page heading. The body had bodyFr while the TITLE did not, so
  // a fully translated page still appeared under an English name in the French sidebar.
  titleFr        String?
  category       String        @default("General")
  categoryFr     String?
  icon           String? // lucide icon name (see md.jsx ICONS) shown in the sidebar
  body           String        @default("") // markdown w/ doc blocks (EN base)
  bodyFr         String? // optional French translation
  order          Int           @default(0)
  published      Boolean       @default(true)
  // "Was this helpful?" tallies (3-face rating, one vote per browser).
  helpfulYes     Int           @default(0) // 🙂 good
  helpfulOk      Int           @default(0) // 😐 ok
  helpfulNo      Int           @default(0) // 🙁 bad
  updatedAt      DateTime      @updatedAt
  createdAt      DateTime      @default(now())
  // Optimistic-concurrency counter for git-style concurrent editing (see BlogPost.version).
  version        Int           @default(1)
  revisions      DocRevision[]
  // Threaded editor-collaboration comments (see BlogComment). `commentsPublic` lets
  // readers see them read-only on the published page.
  comments       DocComment[]
  commentsPublic Boolean       @default(false)

  @@index([category])
}

// Per-comment edit history (blog + doc comments, polymorphic via `kind`). One row is
// written when a comment is created (v1) and on every body edit, so the full timeline of
// a comment's content — who wrote each version and when — is preserved (nothing lost,
// git-like). Pruned/cascaded manually when the parent comment is deleted.
model CommentRevision {
  id        String   @id @default(cuid())
  commentId String
  kind      String // 'blog' | 'doc'
  body      String
  editorId  String? // who wrote this version
  createdAt DateTime @default(now())

  @@index([commentId])
}

// Threaded comment on a doc page — the same editor-collaboration tool as BlogComment.
// Any docs editor (ADMIN/SUPERADMIN) can read, add, reply, resolve and edit any comment.
model DocComment {
  id        String   @id @default(cuid())
  page      DocPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId    String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  parentId  String?
  anchor    String?
  body      String
  resolved  Boolean  @default(false)
  editorIds String[] @default([]) // everyone who edited this comment — pfps show on it
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId])
}

// Edit-history snapshot of a doc page (see BlogRevision).
model DocRevision {
  id        String   @id @default(cuid())
  page      DocPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId    String
  version   Int
  title     String
  body      String
  bodyFr    String?
  editorId  String?
  createdAt DateTime @default(now())

  @@index([pageId, version])
}

// One reaction per user per post; `type` is one of the post's reactionTypes (emoji).
model BlogReaction {
  id        String   @id @default(cuid())
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  userId    String
  type      String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

// Lets an ADMIN/SUPERADMIN grant a regular USER permission to author blog posts,
// either globally (projectKey and showcaseProjectId both null) or scoped to one
// blog (a fixed Project OR a custom ShowcaseProject page). MOD/ADMIN/SUPERADMIN
// never need a row here — they already pass requireRole('MOD','ADMIN') everywhere
// blog.mjs checks it; this table is purely for extending that ability to USER role.
model BlogPermission {
  id                String      @id @default(cuid())
  user              User        @relation(fields: [userId], references: [id])
  userId            String
  projectKey        ProjectKey?
  showcaseProjectId String?
  grantedBy         String // admin userId — audit trail only, no relation needed
  createdAt         DateTime    @default(now())

  @@unique([userId, projectKey, showcaseProjectId])
  @@index([userId])
}

// A SUPERADMIN-authored, reusable named bundle of capabilities. Assigning one (or
// several) to a user via User.customRoleIds grants that user every capability in the
// bundle, on top of their built-in role tier and any individual `permissions`. Purely
// additive — a custom role can never REMOVE what the tier already grants. `capabilities`
// holds capability slugs from CAPABILITIES (lib/lib.mjs); unknown slugs are ignored.
model CustomRole {
  id           String   @id @default(cuid())
  name         String   @unique
  // Badge tone shown in the UI: one of the Badge component's tones (primary/amber/green/
  // red/…) — cosmetic only.
  color        String   @default("primary")
  capabilities String[] @default([])
  createdBy    String // SUPERADMIN userId — audit trail only
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Per-project EDIT grant, mirroring BlogPermission but for a project's own content/config
// rather than its blog. Exactly one scope is set:
//   • showcaseProjectId → edit that one "other project" (ShowcaseProject)
//   • projectKey        → edit that one fixed Project (bmm/bsm/community/installer)
//   • allShowcase=true  → edit EVERY other project (blanket grant)
// A grantee edits content + config but NOT the reserved controls (pinTopbar, visibility,
// announcement, publish/order) — those require the manage_showcase capability or an
// admin-tier role. Enforced field-by-field in showcase.mjs / projects.mjs.
model ProjectPermission {
  id                String      @id @default(cuid())
  user              User        @relation(fields: [userId], references: [id])
  userId            String
  showcaseProjectId String?
  projectKey        ProjectKey?
  allShowcase       Boolean     @default(false)
  grantedBy         String // admin userId — audit trail only
  createdAt         DateTime    @default(now())

  @@unique([userId, showcaseProjectId, projectKey, allShowcase])
  @@index([userId])
}

model CatalogItem {
  id             String       @id @default(cuid())
  project        Project      @relation(fields: [projectId], references: [id])
  projectId      String
  kind           CatalogKind
  owner          User         @relation(fields: [ownerId], references: [id])
  ownerId        String
  name           String
  slug           String       @unique
  // Unguessable key for the item's PRIVATE direct link (?k=…). Mirrors Server-Repos:
  // an item that isn't PUBLISHED stays reachable via its own link (owner-shared) but is
  // never in the public list/feed. Public listing requires admin validation (PUBLISHED).
  shareKey       String?      @unique
  description    String       @default("")
  tags           String[]     @default([])
  version        String       @default("1.0.0")
  status         ItemStatus   @default(PENDING)
  payloadKey     String? // object-storage key (the uploaded file/bundle)
  payloadSize    Int          @default(0) // uploaded payload bytes (≤500MB cap fits Int) — counted against the temp submissions margin
  meta           Json         @default("{}") // preset JSON / plugin manifest / etc.
  views          Int          @default(0) // all-time views (1 per item .json fetch)
  downloads      Int          @default(0) // all-time downloads
  deleteAt       DateTime? // scheduled hard-deletion (72h grace); cancellable until then
  // When a rejected submission's payload file is purged to reclaim temp storage. Set on
  // reject (now + hosting.rejectedRetentionDays), cleared if the owner resubmits within
  // the grace (item flips back to PENDING). The sweeper deletes the object + clears
  // payloadKey/Size when this elapses; the REJECTED row itself stays (owner still sees it).
  payloadPurgeAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  submissions    Submission[]

  @@index([deleteAt])
  @@index([payloadPurgeAt])
  // Hot-path indexes for the public browse (/catalog: filter by status, sort by the
  // chosen column) and the BMM-native feed (/catalog.json: status+project+kind, sort
  // by downloads). Without these, both do a seq-scan + in-memory sort as the catalog grows.
  @@index([status, updatedAt])
  @@index([status, downloads])
  @@index([status, views])
  @@index([projectId, kind, status])
}

// Time-stamped catalog events for windowed popularity (e.g. "popular this month").
model CatalogEvent {
  id        String   @id @default(cuid())
  itemId    String
  kind      String // "view" | "download"
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
  @@index([itemId])
}

// A community-hosted catalog — its OWN catalog (unlike the implicit official catalog
// of CatalogItem rows). Two modes: "raw" (owner uploads a BMM-native catalog.json,
// downloads stay self-hosted → ~free) or "managed" (items + payloads on our storage,
// counted against a HostingGroup pool). Storage is fungible with repos via `group`.
// visibility "private" gates the feed + downloads to an access list; bans (in `access`)
// apply even when public. status SUSPENDED (admin) / HIDDEN (unpaid) hide it from all.
model CommunityCatalog {
  id                String                 @id @default(cuid())
  owner             User                   @relation(fields: [ownerId], references: [id])
  ownerId           String
  name              String
  slug              String                 @unique
  description       String                 @default("")
  kinds             String[]               @default([]) // app/plugin/theme/preset sub-feeds exposed
  // Which Better* app this catalog is for. Same optional Project relation CatalogItem
  // uses, rather than a free-text key: a client that must ignore catalogs meant for
  // another app needs an answer it can trust, and a typed relation cannot drift into
  // "BMM" / "bmm" / "Bmm" the way a string column does.
  // Nullable: catalogs created before this existed have no answer, and guessing one
  // would be worse than saying so — the feed omits the app rather than inventing it.
  project           Project?               @relation(fields: [projectId], references: [id])
  projectId         String?
  mode              String                 @default("managed") // "managed" | "raw"
  rawJson           Json? // mode raw: the uploaded BMM-native feed (validated on save)
  status            String                 @default("ACTIVE") // ACTIVE | SUSPENDED (admin) | HIDDEN (unpaid)
  visibility        String                 @default("public") // "public" | "private"
  // Private access + bans (applies to public catalogs too): { ips, emails,
  // accounts:[{type,id}], bans:{ ips, emails, accounts } }. Mirrors the repo sandbox
  // shape; matched against the server-resolved identity (see resolveIdentity).
  access            Json?
  shareKey          String?                @unique // owner's private direct link (?k=…)
  listed            Boolean                @default(true) // in the public browser (never true if private)
  featuredUntil     DateTime? // paid promotion
  freePlan          Boolean                @default(false) // provisioned via the $0 free catalog plan
  group             HostingGroup?          @relation(fields: [groupId], references: [id])
  groupId           String?
  storageQuotaBytes BigInt                 @default(0) // dedicated alloc when not in a pool
  storageUsedBytes  BigInt                 @default(0)
  views             Int                    @default(0)
  downloads         Int                    @default(0)
  deleteAt          DateTime? // 72h grace, e.g. after a failed payment
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  items             CommunityCatalogItem[]
  favorites         CatalogFavorite[]

  @@index([ownerId])
  @@index([status, listed])
  @@index([deleteAt])
  /// Declared late. The 20260814380000_catalog_project migration created this index in raw
  /// SQL without adding it here, so the schema and the migration history disagreed — and
  /// the next `migrate diff` proposed DROPPING it, because a diff believes the schema. It
  /// backs the `?app=` filter on the catalogue feeds, which is the query it was added for.
  @@index([projectId])
}

// One item in a "managed" community catalog (payloads on our storage). Raw catalogs
// don't use this — their entries live inline in CommunityCatalog.rawJson.
model CommunityCatalogItem {
  id          String           @id @default(cuid())
  catalog     CommunityCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  catalogId   String
  kind        CatalogKind
  name        String
  slug        String // unique within its catalog
  version     String           @default("1.0.0")
  description String           @default("")
  tags        String[]         @default([])
  payloadKey  String? // object-storage key
  payloadSize Int              @default(0)
  downloads   Int              @default(0)
  meta        Json             @default("{}")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([catalogId, slug])
  @@index([catalogId])
}

model Submission {
  id         String              @id @default(cuid())
  item       CatalogItem         @relation(fields: [itemId], references: [id])
  itemId     String
  owner      User                @relation(fields: [ownerId], references: [id])
  ownerId    String
  type       SubmissionType      @default(NEW)
  status     ItemStatus          @default(PENDING)
  reviewerId String?
  reason     String? // rejection reason -> sent to the user
  tags       String[]            @default([]) // mod-only triage tags (e.g. "priority", "needs-rework") — never shown to the submitter
  comments   SubmissionComment[]
  createdAt  DateTime            @default(now())
}

// Mod-only internal note on a submission (max 200 chars, enforced in catalog.mjs) —
// a quick heads-up between moderators during review, never shown to the submitter.
model SubmissionComment {
  id           String     @id @default(cuid())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId String
  author       User       @relation(fields: [authorId], references: [id])
  authorId     String
  body         String
  createdAt    DateTime   @default(now())

  @@index([submissionId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  kind      String
  // English body. The same convention as SiteReview below: one row carries both
  // languages and the client shows the one matching the active locale.
  body      String
  // French body. Null for the notifications written from a single string (billing,
  // moderation); the client falls back to `body`, which is what it always showed.
  //
  // Added because the event broadcast had no way to express a per-user language and
  // shipped ONE row reading "Bientôt / Upcoming: …" to everybody — the only surface in
  // the app that did that.
  bodyFr    String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

// Admin-curated testimonials/reviews shown on the landing page. The admin provides the
// list from the dashboard; each carries an English AND a French body (the client shows
// the one matching the active locale), and can be individually disabled. The whole
// section can also be turned off via the `reviews.enabled` admin setting.
model Review {
  id        String   @id @default(cuid())
  author    String
  role      String   @default("") // subtitle: role / handle / "BMM user"
  body      String // English
  bodyFr    String   @default("") // French (falls back to `body` when empty)
  rating    Int? // optional 1..5 stars
  avatar    Json? // { variant, seed, colors } Boring-avatar, or { image }
  enabled   Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, order])
}

// Site-wide banner announcements. Publishing one also broadcasts a Notification to
// every user (see announcements.mjs) — the banner is the persistent/dismissible
// form, the notification is the "you have something new" ping in the bell menu.
model Announcement {
  id         String    @id @default(cuid())
  title      String
  body       String
  tone       String    @default("info") // info | warning | success
  active     Boolean   @default(true)
  // Every active announcement always sends a Notification (bell). This controls
  // ONLY the dismissible top-of-site banner — off for a "quiet" announcement that
  // should just land in people's notifications without also plastering the site.
  showBanner Boolean   @default(true)
  // Where the banner navigates on click — an internal path (e.g. "/blog/my-post")
  // or a full external URL. Null/empty = banner isn't clickable, just the dismiss X.
  linkUrl    String?
  createdBy  String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?

  @@index([active])
}

model HostingPlan {
  id                String         @id @default(cuid())
  name              String
  storageGB         Int
  uploadLimitKbps   Int
  cpuShare          Float          @default(0.25)
  priceMonthlyCents Int
  active            Boolean        @default(true)
  // A price change that has been ANNOUNCED but is not in force yet.
  //
  // The Payments policy promises advance notice and "the new price applies from your
  // next renewal, never to a period already paid for". Editing priceMonthlyCents
  // directly cannot keep that promise: it changes the price the instant Save is pressed,
  // with nobody told. So an increase is staged here, subscribers are emailed at the
  // moment it is scheduled, and the sweeper swaps it in on the day.
  pendingPriceCents Int?
  pendingPriceAt    DateTime?
  // When the announcement went out, and to how many — so the same change is never
  // announced twice, and so the record of "we did give notice" outlives the mailbox.
  pendingNoticeAt   DateTime?
  pendingNoticeCount Int           @default(0)
  // Does the announced change touch people who are ALREADY subscribed?
  //
  // false (the default, and what happens today whether anyone intended it or not): each
  // Stripe subscription is pinned to its own ad-hoc Price created at checkout, so a new
  // plan price only ever reaches NEW buyers. Existing subscribers are grandfathered by
  // the payment model itself, not by a decision.
  //
  // true: on the effective date their Stripe subscription item is moved onto a new Price
  // with proration_behavior 'none', so the new amount starts at their next renewal and
  // nobody is charged mid-term. That is the same promise the notice email makes.
  pendingApplyExisting Boolean     @default(false)
  subscriptions     Subscription[]

  @@index([pendingPriceAt])
}

model ServerRepo {
  id                String            @id @default(cuid())
  owner             User              @relation(fields: [ownerId], references: [id])
  ownerId           String
  name              String
  hosted            Boolean           @default(false)
  // TRUE only when provisioned through the actual $0 Free plan (the FreeTierClaim
  // checkout path). Admin-provisioned and promo-granted repos stay false — they must
  // NOT count against the Free-plan pool cap (the "70/10 GB while empty" bug).
  freePlan          Boolean           @default(false)
  status            RepoStatus        @default(OFFLINE)
  publicUrl         String?
  region            String?
  storageQuotaBytes BigInt            @default(0)
  storageUsedBytes  BigInt            @default(0)
  uploadLimitKbps   Int               @default(0) // OUR limit (overrides the author's) when hosted
  cpuShare          Float             @default(0.25)
  seed              String?
  // Public listing + content verification.
  description       String            @default("")
  tags              String[]          @default([])
  links             Json? // { discord, website, changelog } shown on the listing
  repoUrl           String? // source URL for a non-hosted, listed repo
  sha               String? // current content SHA (integrity of last verified content)
  // Listed by default — you opt OUT. The common case is a repo made for people to use;
  // the old opt-in meant it stayed invisible until the owner found a menu item they had no
  // reason to look for. repos.json still also requires `verified`, so a moderator check is
  // unchanged. Existing rows keep whatever they had (see the migration).
  listed            Boolean           @default(true)
  verified          Boolean           @default(false) // content checked by a mod/admin
  pendingReview     Boolean           @default(false) // a change is awaiting verification
  // Unlisted-share link: when set, anyone with /r/<id>?k=<shareKey> can see the repo's
  // public page even though it isn't in the browse list (mirrors CommunityCatalog.shareKey).
  shareKey          String            @default("")
  /// Optional download password, argon2 hash. Null / empty = no password, matching BMM's
  /// own mini-server, which treats a blank password as "not required".
  ///
  /// The CLIENT contract is fixed and predates this column: BMM sends `X-Repo-Password` on
  /// EVERY file request (there is no token exchange), and accepts `?password=` too because
  /// a browser cannot set a header. See repo_server.rs in the BMM repo — matching it means
  /// a password-protected repo hosted here needs no client change at all.
  ///
  /// Stored hashed rather than in clear because it is a user-chosen secret. Verifying
  /// argon2 on every file of a sync would be crippling, so the hot path is a short-lived
  /// in-memory verification cache (see hosting-content.mjs); the slow hash is paid once
  /// per client per window.
  syncPasswordHash  String?
  // Admin-set classification for the public browser: "community" (default),
  // "official" (maintained by the BMM team — green badge) or "partner" (trusted
  // community members — blue badge). Official/partner float to the top of the list.
  category          String            @default("community")
  featuredUntil     DateTime? // paid promotion expiry (listing boost)
  // Hosted-content publishing (for repos we host): admin validates → repo.json served.
  hostPath          String?           @unique // "<ownerSlug>/<repoSlug>" for the public URL
  published         Boolean           @default(false)
  repoJson          Json? // parsed manifest of the uploaded repo.json
  // Sandboxed, owner-managed settings: bans, whitelist, requested upload limit.
  // Requested values are always clamped to the hard sandbox caps on this row.
  settings          Json? // { access:{whitelistEnabled,ips,keys}, bans:{ips,keys}, requestedUploadKbps }
  // Dedicated dashboard access control. The owner (or an ADMIN) always has access.
  // Others get in either by being a logged-in user whose email is in accessEmails,
  // or by entering dashPassword (login-less, mints a short-lived per-repo cookie).
  accessEmails      String[]          @default([]) // authorized collaborator emails
  dashPassword      String? // argon2 hash of the dashboard password (null = disabled)
  group             HostingGroup?     @relation(fields: [groupId], references: [id])
  groupId           String?
  deleteAt          DateTime? // scheduled hard-deletion (72h grace, e.g. after a failed payment)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  subscription      Subscription?
  files             RepoFile[]
  auditLogs         RepoAuditLog[]
  accessEvents      RepoAccessEvent[]
  favorites         RepoFavorite[]

  @@index([groupId])
  @@index([deleteAt])
  // Public list (/repos): the exact filter + sort of the community repo browser, so it
  // doesn't seq-scan every repo to find the listed + verified ones.
  @@index([listed, verified, pendingReview, createdAt])
}

// A user starring a Server-Repo on the public list — purely social (visibility
// into how liked a repo is), not an access grant of any kind.
model RepoFavorite {
  id           String     @id @default(cuid())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  repo         ServerRepo @relation(fields: [serverRepoId], references: [id], onDelete: Cascade)
  serverRepoId String
  createdAt    DateTime   @default(now())

  @@unique([userId, serverRepoId])
  @@index([serverRepoId])
}

// The same, for a community catalog. Mirrors RepoFavorite exactly (same shape, same
// semantics: purely social, never an access grant) so the two can be listed together on the
// member's Favourites tab without special-casing either.
model CatalogFavorite {
  id        String           @id @default(cuid())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  catalog   CommunityCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  catalogId String
  createdAt DateTime         @default(now())

  @@unique([userId, catalogId])
  @@index([catalogId])
}

// A file uploaded to a hosted Server-Repo (counted against the storage quota).
// Stored in object storage; NEVER executed — only listed/served as bytes.
model RepoFile {
  id           String     @id @default(cuid())
  repo         ServerRepo @relation(fields: [serverRepoId], references: [id], onDelete: Cascade)
  serverRepoId String
  path         String // logical path within the repo (e.g. "repo.json", "mods/x.zip")
  key          String // object-storage key
  size         BigInt     @default(0)
  contentType  String     @default("application/octet-stream")
  sha256       String? // content checksum (computed at upload) — shown in the manager
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([serverRepoId, path])
}

// Per-repo activity log for the dedicated dashboard: who did what (uploads, deletes,
// publish/offline, settings + access changes). Actor is a display label (owner name,
// collaborator email, or "password access") — no auth material is stored.
model RepoAuditLog {
  id           String     @id @default(cuid())
  repo         ServerRepo @relation(fields: [serverRepoId], references: [id], onDelete: Cascade)
  serverRepoId String
  actor        String
  action       String // upload | delete | publish | unpublish | settings | access | ban | unban
  detail       String     @default("")
  createdAt    DateTime   @default(now())

  @@index([serverRepoId, createdAt])
}

// Consumer-side access to a published repo (BMM clients syncing it): a manifest fetch
// (kind='connect' — an import/connect) or a file fetch (kind='download'). Powers the
// dashboard's Users/Traffic view + who's connected, so the owner can ban IPs/keys.
model RepoAccessEvent {
  id           String     @id @default(cuid())
  repo         ServerRepo @relation(fields: [serverRepoId], references: [id], onDelete: Cascade)
  serverRepoId String
  ip           String
  accessKey    String? // the ?key= the client sent (sandbox access key), if any
  userId       String? // resolved via the X-Creator-ID header -> CreatorLink, if linked
  discordId    String? // resolved via that same account's DiscordLink, if linked
  path         String
  kind         String // connect | download
  createdAt    DateTime   @default(now())

  @@index([serverRepoId, createdAt])
}

// A single, admin-managed access policy applied identically to EVERY hosted repo, on
// top of (never instead of) each repo's own per-repo settings.access/settings.bans:
// bans here block a client everywhere; the whitelist here is unioned with a repo's own
// whitelist when either the repo or `whitelistOnly` (site-wide) requires one. Entries
// in the account lists are { type: "bcweb"|"discord", id, label }. Singleton row
// (id is always "global") — read/written via GET/PUT /admin/access-policy.
model GlobalAccessPolicy {
  id                String   @id @default("global")
  whitelistOnly     Boolean  @default(false) // forces whitelist-only mode on ALL repos
  whitelistIps      String[] @default([])
  whitelistKeys     String[] @default([])
  whitelistAccounts Json     @default("[]")
  bannedIps         String[] @default([])
  bannedKeys        String[] @default([])
  bannedAccounts    Json     @default("[]")
  updatedAt         DateTime @updatedAt
}

// Same shape as GlobalAccessPolicy, but owner-managed and scoped to only THAT
// owner's own hosted repos (one row per user, on top of both the repo's own
// settings AND the site-wide GlobalAccessPolicy — see hosting-content.mjs).
model UserAccessPolicy {
  userId            String   @id
  whitelistOnly     Boolean  @default(false)
  whitelistIps      String[] @default([])
  whitelistKeys     String[] @default([])
  whitelistAccounts Json     @default("[]")
  bannedIps         String[] @default([])
  bannedKeys        String[] @default([])
  bannedAccounts    Json     @default("[]")
  updatedAt         DateTime @updatedAt
}

// Every login attempt against /auth/login, success or failure — powers the admin
// security log (login attempts, IPs hitting the panel) and basic abuse review.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  success   Boolean
  reason    String? // "bad_password" | "2fa_required" | "2fa_invalid" | "ok"
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([ip, createdAt])
}

// A general admin/staff action audit trail — wired into the highest-value mutation
// points (role changes, access-policy edits, server-control actions), not every
// single endpoint (that would be a much larger retrofit for marginal benefit).
model AuditLogEntry {
  id        String   @id @default(cuid())
  actor     User     @relation(fields: [actorId], references: [id])
  actorId   String
  action    String
  detail    String   @default("")
  ip        String   @default("")
  createdAt DateTime @default(now())
  // Tamper-evidence: each entry is HMAC-signed (server secret) over its own fields +
  // the previous entry's hash, forming a chain. Editing any field breaks that row's
  // HMAC; deleting/inserting a row breaks the next row's `prevHash` linkage. A
  // compromised staff account therefore can't silently rewrite history. Verified via
  // GET /admin/security/audit/verify. ("" on legacy rows written before this landed.)
  prevHash  String   @default("")
  hash      String   @default("")

  @@index([createdAt])
}

// A periodic sample of this host's own resource usage (see server-monitor.mjs's
// sweeper tick) — builds the history behind the perf dashboard's graphs/uptime.
model ServerMetricSample {
  id        String   @id @default(cuid())
  cpuPct    Float
  memPct    Float
  diskPct   Float
  loadAvg1  Float
  uptimeSec Int
  latencyMs Int?
  netRxKbps Int? // avg download throughput over the tick (kbit/s)
  netTxKbps Int? // avg upload throughput over the tick (kbit/s)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// A fired threshold alert (CPU/RAM/disk/service-down) — the persistent form of
// what also gets pushed to Discord + surfaced live in the admin dashboard.
/// One moderation decision, with a reference you can quote.
///
/// Before this, a sanction was a handful of columns on User (status/moderationUntil/
/// moderationReason) — which meant only ONE could exist, nothing could be said about a repo
/// or a catalog item, and a person told "your account was suspended" had no number to put in
/// a reply. A record with a `code` is what turns moderation into something you can appeal
/// against: both sides are talking about the same decision.
///
/// The account columns on User stay: they are the fast path every request reads. This is the
/// history and the paperwork, not the lock itself.
model Sanction {
  id          String    @id @default(cuid())
  /// SNC-XXXX-XXXX. Quoted in the e-mail, searchable in the admin, given by the user when
  /// they contest. Unique so it can be looked up directly.
  code        String    @unique
  /// warning · suspension · ban · closure · takedown
  kind        String
  /// account · content — what the decision is really about, which decides what lifting it does.
  scope       String    @default("account")

  /// The person answerable for it, ALWAYS set — including for a content sanction, because a
  /// repo cannot read its e-mail.
  user        User      @relation("SanctionTarget", fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  /// For a content sanction: repo · catalog · item, its id, and its name at the time.
  /// The name is denormalised on purpose — the row may be deleted, the record must survive it.
  targetType  String?
  targetId    String?
  targetName  String?
  /// Other content caught by the same decision (ids), so one takedown can name several items
  /// instead of becoming five unrelated records.
  relatedIds  String[]  @default([])

  reason      String
  /// What the person is being asked to do about it, if anything. A warning with no request
  /// is just an insult with a reference number.
  request     String?
  requiresAction Boolean @default(false)

  issuedBy    User?     @relation("SanctionIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  issuedById  String?
  issuedAt    DateTime  @default(now())
  expiresAt   DateTime?

  /// active · lifted · expired
  status      String    @default("active")
  liftedAt    DateTime?
  liftedById  String?
  liftReason  String?

  /// The contest. An admin closure cannot be cancelled by the person it lands on — but it can
  /// be argued with, and an argument nobody can file is not a right.
  contestedAt        DateTime?
  contestBody        String?
  /// upheld · overturned
  contestOutcome     String?
  contestAnswer      String?
  contestAnsweredAt  DateTime?
  contestAnsweredById String?

  /// The report this came out of, when it came out of one. A decision with no cause recorded
  /// is a decision nobody can review later — and without it the next moderator re-reads a
  /// case that was already handled.
  report      Report?   @relation(fields: [reportId], references: [id], onDelete: SetNull)
  reportId    String?

  /// STAFF ONLY. Never sent, never quoted, never shown to the person it is about.
  ///
  /// `reason` is the opposite: it goes in the e-mail and comes back in any contest, so it has
  /// to be something you are willing to defend to the person reading it. That left nowhere to
  /// put "third account from this IP, see SNC-4821" — context the next moderator needs and the
  /// subject must not read. Without a field for it, that context either goes in `reason`
  /// (where it is disclosed) or nowhere (where it is lost).
  ///
  /// It is still a record about a person: it appears in a data-access request as staff-held
  /// data, and it is covered by the same edit history as the rest.
  internalNote String?

  /// Whatever the decision needs to remember — chiefly the subscriptions it cancelled, so the
  /// offer to take them out again can name them when the suspension ends.
  meta        Json?

  /// Filed away, not deleted. A sanction is a record of a decision about a person, so it must
  /// never be removable — but a moderation list that shows every settled case from three years
  /// ago is a list nobody reads, and an unread list is how an open contest gets missed.
  /// Archiving hides a row from the default view and changes nothing else. An ACTIVE sanction
  /// cannot be archived: that would take a decision still in force out of sight.
  archivedAt   DateTime?
  archivedById String?

  /// Every edit, oldest first: { at, byId, field, from, to }. A sanction's reason is quoted in
  /// the e-mail the person received and in any contest they file, so changing it silently
  /// would leave them holding a document that no longer matches the record. Editable, but not
  /// quietly.
  edits        Json?

  attachments  SanctionAttachment[]

  @@index([userId, issuedAt])
  @@index([status, expiresAt])
  @@index([targetType, targetId])
  @@index([reportId])
  @@index([archivedAt])
}

/// Evidence attached to a sanction: a screenshot, a recording, a link, a file.
///
/// A separate table rather than a Json array on Sanction, because these are uploaded objects
/// with a lifetime — deleting one has to delete the stored blob, and a row makes that an
/// ordinary cascade instead of something the application has to remember.
///
/// Staff-only. Nothing here is served to the person the sanction is about: a report's evidence
/// routinely names the account that filed it, and handing that over on request would make
/// reporting unsafe. Whether a redacted subset should reach a contest is a policy question, and
/// the honest default is to answer it deliberately rather than by leaving the field public.
model SanctionAttachment {
  id         String   @id @default(cuid())
  sanction   Sanction @relation(fields: [sanctionId], references: [id], onDelete: Cascade)
  sanctionId String

  /// image · video · file · link
  kind       String
  /// For an uploaded object: its key in storage. Null for a link.
  storageKey String?
  /// For a link: the address. Null for an upload.
  url        String?
  /// Original filename, or the label a moderator gave the link.
  name       String
  mime       String?
  bytes      Int      @default(0)
  /// Why this is here. Evidence with no note is evidence the next moderator has to re-derive.
  note       String?

  addedBy    User?    @relation("SanctionAttachmentAuthor", fields: [addedById], references: [id], onDelete: SetNull)
  addedById  String?
  createdAt  DateTime @default(now())

  @@index([sanctionId, createdAt])
}

/// A row somebody has dealt with, or does not want to look at, in the "Needs attention" list.
///
/// It hides the row from THAT list and nothing else. The queue counts stay truthful, because
/// the work still exists: a submission that is still PENDING is still pending whether or not
/// a moderator ticked it off here. A dismissal that silently decremented the count would turn
/// the one number staff trust into a to-do list anybody could edit.
///
/// Shared, not per-person: two moderators working the same list should not each have to
/// dismiss the same handled item. Who did it is recorded so the other one can ask.
model PendingDismissal {
  id      String   @id @default(cuid())
  queue   String
  itemId  String
  /// handled · archived — the difference is only what the person meant, and it is worth
  /// keeping: "I dealt with this" and "I am not going to" are different admissions.
  mode    String   @default("handled")
  by      User?    @relation(fields: [byId], references: [id], onDelete: SetNull)
  byId    String?
  at      DateTime @default(now())

  @@unique([queue, itemId])
  @@index([at])
}

/// An address to tell when something happens, so a developer stops asking.
///
/// Every integration built against this API so far has to poll: ask /v1/catalogs every
/// minute in case an item was published. That is wasted on both sides and always late by up
/// to a minute. A webhook inverts it — we call them.
model WebhookEndpoint {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  url       String
  /// Which events this address wants. Empty means none — the same rule as scopes on a key:
  /// a subscription to nothing is silence, not a wildcard.
  events    String[] @default([])
  /// Shared with the receiver once, at creation. Every delivery is signed with it, so the
  /// receiver can tell our call from anybody who learned the URL.
  secret    String
  enabled   Boolean  @default(true)
  label     String   @default("")
  /// Consecutive failures. A dead address is disabled rather than retried for ever, and the
  /// owner is told — an endpoint quietly retried for a month is a bill nobody agreed to.
  failures  Int      @default(0)
  disabledReason String?
  lastAt    DateTime?
  lastStatus Int?
  createdAt DateTime @default(now())

  deliveries WebhookDelivery[]

  @@index([userId])
  @@index([enabled])
}

/// One attempt to deliver one event. Kept so "you never called me" has an answer, and so a
/// failed delivery can be replayed once the receiver is fixed.
model WebhookDelivery {
  id         String   @id @default(cuid())
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  endpointId String
  event      String
  payload    Json
  /// pending · ok · failed
  status     String   @default("pending")
  httpStatus Int?
  error      String?
  attempts   Int      @default(0)
  /// When the next attempt is due. Null once it succeeded or was given up on.
  nextAt     DateTime?
  createdAt  DateTime @default(now())
  deliveredAt DateTime?

  @@index([endpointId, createdAt])
  @@index([status, nextAt])
}

model ServerAlertLog {
  id        String   @id @default(cuid())
  kind      String
  message   String
  announced Boolean  @default(false) // has the Discord bot posted this one yet?
  // Acknowledgement is what turns a log into a queue: the "Server perf" tab badges the
  // count of alerts nobody has looked at yet. Without it the badge would show a 30-day
  // history for ever and be ignored within a week.
  ackAt     DateTime?
  ackById   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([ackAt])
}

/// One row per period a dependency was unreachable — opened the first tick it fails and
/// closed the first tick it answers again. The alert log says "storage is unreachable"
/// once per debounce window; this says *for how long*, which is the question actually
/// asked after the fact. `cause` keeps the message that opened it, so an outage carries
/// its reason rather than just its shape.
model ServiceOutage {
  id        String    @id @default(cuid())
  dep       String
  cause     String?
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([dep, startedAt])
  @@index([endedAt])
}

model Subscription {
  id               String      @id @default(cuid())
  user             User        @relation(fields: [userId], references: [id])
  userId           String
  // A hosting subscription anchors to EITHER a single repo (legacy single-repo hosting)
  // OR a whole storage pool (the current model: you buy a pool and fill it with repos
  // and/or catalogs). Exactly one is set. Pool subs let a purchase exist with no repo at
  // all (e.g. a catalog-only pool).
  serverRepo       ServerRepo?   @relation(fields: [serverRepoId], references: [id])
  serverRepoId     String?       @unique
  // A pool can hold MULTIPLE subscriptions once pools are merged (each keeps billing
  // separately); poolContribBytes is the storage THIS sub adds to the pool. A pool's
  // effective poolBytes = sum of its ACTIVE subs' poolContribBytes.
  hostingGroup     HostingGroup? @relation(fields: [hostingGroupId], references: [id])
  hostingGroupId   String?
  poolContribBytes BigInt        @default(0)
  plan             HostingPlan @relation(fields: [planId], references: [id])
  planId           String
  stripeSubId      String?     @unique
  status           String      @default("active")
  currentPeriodEnd DateTime?
  warnedAt         DateTime? // set when the 72h-before-expiry warning was sent (once per term)

  @@index([hostingGroupId])
}

// Recurring "featured" boost — a Stripe subscription that re-extends a repo's
// featuredUntil every `days`. Separate from Subscription (which is @unique per
// repo for hosting), so a repo can be both hosted AND boosted. No relations, on
// purpose (like Payment), to keep ServerRepo/User untouched — looked up by
// serverRepoId / stripeSubId in the webhook.
model FeatureSubscription {
  id               String    @id @default(cuid())
  userId           String
  serverRepoId     String
  stripeSubId      String    @unique
  days             Int
  status           String    @default("active")
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())

  @@index([serverRepoId])
}

// Password reset tokens (single-use, short-lived). The raw token is never stored.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // sha256 of the emailed token
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Email-confirmation token, emailed on sign-up (and re-sendable). Same shape as
// PasswordReset — sha256 of the token, single-use, expiring.
model EmailVerification {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Global, admin-editable settings: total hosting capacity, reserved free margin,
// price/GB, price/upload, price/cpu, feature flags, etc. (key -> JSON value).
// Admin-generated promo code. Three kinds:
//  - 'discount'     : % off (and/or first N months free) applied at hosting/boost checkout
//  - 'free_hosting' : redeeming provisions a free hosted repo (storage/upload/duration)
//  - 'free_boost'   : redeeming boosts one of the user's repos for boostDays
model PromoCode {
  id              String            @id @default(cuid())
  code            String            @unique
  kind            String
  percentOff      Int? // discount: 1..100
  freeMonths      Int? // discount: first N months free (100% off, repeating)
  minMonths       Int? // discount: only applies at checkout when the chosen prepaid term is >= this (e.g. Ko-fi's reward is 12mo+ only)
  storageGB       Int? // free_hosting
  uploadMbps      Int? // free_hosting
  hostMonths      Int? // free_hosting: grant duration (0/none = no auto-expiry)
  boostDays       Int? // free_boost
  maxRedemptions  Int? // null = unlimited
  redeemedCount   Int               @default(0)
  perUserLimit    Int               @default(1)
  notBefore       DateTime? // if set, the code is NOT valid before this (e.g. an event-only code)
  expiresAt       DateTime?
  active          Boolean           @default(true)
  stackable       Boolean           @default(false) // may be combined with OTHER stackable codes in one cart
  assignedUserIds String[]          @default([]) // if non-empty, ONLY these users may redeem it (gift codes)
  assignedTokens  String[]          @default([]) // typed identifiers that may redeem (no linked account required): "email:x" | "discord:x" | "creator:x" | "bcid:x"; matched to the redeeming user at redeem time
  note            String            @default("")
  createdAt       DateTime          @default(now())
  redemptions     PromoRedemption[]
}

model PromoRedemption {
  id        String    @id @default(cuid())
  promo     PromoCode @relation(fields: [promoId], references: [id], onDelete: Cascade)
  promoId   String
  userId    String
  detail    String    @default("")
  createdAt DateTime  @default(now())

  @@index([promoId])
  @@index([userId])
}

// A site-wide, time-boxed promo CAMPAIGN (Black Friday, New Year sale, a random flash
// sale…). Unlike PromoCode (the user types a code), a campaign AUTO-applies its discount
// to purchases during its window and shows an announcement badge across the whole site.
// A campaign may also be owned by an Event (Phase 2) — eventId links them.
model PromoCampaign {
  id             String   @id @default(cuid())
  name           String // internal label, e.g. "Black Friday 2026"
  kind           String   @default("custom") // "custom" | "black_friday" | "new_year" | "flash"
  percentOff     Int // 1..100, applied site-wide to purchases in-window
  appliesTo      String   @default("all") // "all" | "hosting" | "boost"
  startsAt       DateTime
  endsAt         DateTime
  active         Boolean  @default(true) // master switch (must ALSO be within [startsAt,endsAt])
  badgeEnabled   Boolean  @default(true) // show the site-wide announcement badge
  badgeMessageEn String   @default("") // custom announcement (EN); blank → sensible default
  badgeMessageFr String   @default("") // custom announcement (FR)
  badgeColor     String   @default("") // optional accent hex (validated); blank → brand color
  badgeLink      String   @default("") // optional click target: internal "/blog/x" or "https://…" (validated)
  // The Stripe coupon that carries this campaign onto SUBSCRIPTION checkouts.
  //
  // A one-time charge can simply be multiplied; a subscription cannot — a discounted
  // unit_amount would bill the sale price every month for as long as the item is hosted.
  // Stripe's coupon with `duration: 'once'` is the mechanism that ends when the sale does.
  // Created lazily on the first subscription checkout during the campaign and reused after.
  stripeCouponId String?
  // DEAD. Declared, never read, never written — anywhere. An event that mints a code
  // records it on Event.eventCode and finds it back by `note`, and campaign teardown goes
  // through Event.campaignId. Kept as a column rather than dropped so no deployed database
  // needs a destructive migration for a field that has only ever held NULL; do not start
  // writing to it — add the relation properly if that is ever wanted.
  promoCodeId    String?
  eventId        String?  @unique // set when the campaign belongs to an Event (Phase 2)
  createdAt      DateTime @default(now())

  @@index([active, startsAt, endsAt])
}

// A site EVENT (New Year, a national holiday…). One event is live at a time. While
// live it plays a full-screen effect (fireworks; for a national holiday the burst
// forms the country's flag) and shows a custom announcement. An event may own a promo
// (a PromoCampaign via campaignId) and an event-only code (eventCode, valid only for
// its window). Notifications fire `notifyDaysBefore` days ahead and again at start.
model Event {
  id               String    @id @default(cuid())
  name             String // internal label
  kind             String    @default("custom") // "custom" | "national_holiday" | "new_year"
  countryCode      String    @default("") // ISO-3166 alpha-2 (national_holiday → which flag)
  startsAt         DateTime
  endsAt           DateTime
  active           Boolean   @default(true) // master switch (must ALSO be within the window)
  effect           String    @default("fireworks") // the effect kind (same everywhere = fireworks)
  fxDensity        Int       @default(5) // 1..10 — how many fireworks (rocket rate)
  fxSize           Int       @default(5) // 1..10 — particle size
  fxFlagDrops      Int       @default(2) // how many times the flag forms (random time/place)
  badgeIcon        String    @default("sparkles") // announcement icon (named lucide icon, NOT an emoji)
  linkUrl          String? // where the announcement badge links (internal path or full URL)
  titleEn          String    @default("")
  titleFr          String    @default("")
  messageEn        String    @default("")
  messageFr        String    @default("")
  notifyDaysBefore Int       @default(0) // X days before → notify users currently on the site
  preNotifiedAt    DateTime? // set once the pre-event notification fired (idempotent)
  startNotifiedAt  DateTime? // set once the at-activation notification fired
  promoPercent     Int       @default(0) // event discount % (0 = no promo); drives the linked campaign + code
  campaignId       String?   @unique // linked PromoCampaign (the event's discount + badge)
  eventCode        String    @default("") // event-only promo code (valid only during the window)
  createdAt        DateTime  @default(now())

  @@index([active, startsAt, endsAt])
}

// ── OpenID Connect provider (BCWEB as an SSO identity provider for other services) ──
// RSA signing key. The public half is served at /.well-known/jwks.json; the private
// PEM is server-only and NEVER leaves the API. Generated once on first use.
model OidcKey {
  id         String   @id // kid
  alg        String   @default("RS256")
  publicJwk  Json // JWK (public) for JWKS
  privatePem String // PKCS8 PEM — secret, never exposed
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model OAuthClient {
  id           String   @id @default(cuid()) // client_id
  name         String
  secretHash   String   @default("") // sha256(client_secret); empty for public clients
  confidential Boolean  @default(true) // false = public client (PKCE required, no secret)
  redirectUris String[] @default([])
  scopes       String[] @default(["openid", "profile", "email"])
  active       Boolean  @default(true)
  // 'public'  → `sub` is the BetterCommunity user id, the same value every client sees.
  // 'pairwise'→ `sub` is an opaque id unique to THIS client, so two clients comparing
  //             notes cannot tell they are looking at the same person.
  //
  // Default stays 'public' because changing an existing client's subject type silently
  // re-identifies every one of its users as a stranger — accounts get orphaned, not
  // merged. It is a choice made when a client is created, not a switch to flip later.
  subjectType  String   @default("public")
  // Self-service registration. Null = created by staff, which is what every client was
  // before the developer page existed.
  owner        User?    @relation("OAuthClientOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId      String?
  // Reviewed by staff. An unverified client works exactly the same — refusing to sign
  // people in until a human looks would make registration pointless — but the consent
  // screen says so, because "which app is this, really" is the one question a consent
  // screen exists to answer and anyone can type any name.
  verified     Boolean  @default(false)
  description  String   @default("")
  homepageUrl  String?
  createdAt    DateTime @default(now())

  @@index([ownerId])
}

// The stored mapping behind a pairwise `sub`.
//
// Stored rather than derived. A computed sub (hash of client + user + a server salt) needs
// nothing persisted right up until the salt is rotated or the algorithm changed, at which
// point every user of every pairwise client becomes a brand-new person with an empty
// account and no way back. A row is boring and cannot drift.
// Handing a repository or a catalog item to somebody else.
//
// A request, never an act: the recipient inherits storage they will be billed for, content
// they become answerable for, and abuse reports that follow the object rather than the
// person. Pushing that onto an account without asking is how you make somebody the owner
// of a problem they have never seen.
//
// The row survives its own resolution — an accepted transfer is the record of who used to
// own something, which is exactly the question asked after a takedown.
// Why somebody left, or why they stayed.
//
// Deliberately its own table rather than a column on User: the answer must outlive the
// anonymisation it describes, and it is about the DECISION, not the person — so it holds
// no identity beyond the fact that some account gave it.
model AccountClosureSurvey {
  id        String   @id @default(cuid())
  // Kept so a support conversation can be matched to an answer while the account still
  // exists; it points at a row that will have been scrubbed by the time most of these are
  // read, which is the intended amount of identifiability.
  userId    String
  // 'closed' = they went through with it. 'cancelled' = they came back.
  outcome   String
  reason    String   @default("")
  comment   String   @default("")
  createdAt DateTime @default(now())

  @@index([outcome, createdAt])
}

model OwnershipTransfer {
  id          String    @id @default(cuid())
  kind        String    // 'repo' | 'catalog'
  targetId    String    // ServerRepo.id or CatalogItem.id
  targetName  String    // snapshot: the object may be renamed or gone by the time this is read
  fromUserId  String
  toUserId    String
  // pending → accepted | declined | cancelled | expired
  status      String    @default("pending")
  message     String    @default("")
  createdAt   DateTime  @default(now())
  respondedAt DateTime?
  // Requests do not hang around forever: an unanswered one becomes noise in both
  // inboxes, and consent that old is not consent to today's object.
  expiresAt   DateTime

  @@index([toUserId, status])
  @@index([fromUserId, status])
  @@index([kind, targetId, status])
}

model OAuthPairwiseSub {
  sub       String   @id
  userId    String
  clientId  String
  createdAt DateTime @default(now())

  @@unique([userId, clientId])
  @@index([clientId])
}

model OAuthCode {
  code          String    @id // authorization code (random, single-use)
  clientId      String
  userId        String
  redirectUri   String
  scope         String
  nonce         String    @default("")
  codeChallenge String    @default("") // PKCE S256 challenge
  // When the user authenticated, as unix seconds — carried from /authorize so the ID
  // token minted at /token can state auth_time. Without it, a client that sent max_age
  // gets a token with nothing to check that claim against and rejects it.
  authTime      Int?
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([expiresAt])
}

model OAuthConsent {
  id        String   @id @default(cuid())
  userId    String
  clientId  String
  scope     String
  createdAt DateTime @default(now())

  @@unique([userId, clientId])
}

model OAuthRefreshToken {
  token     String    @id // sha256 of the refresh token
  clientId  String
  userId    String
  scope     String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// A Discord giveaway managed from the admin bot dashboard. The bot posts a message
// with an "Enter" button, collects entrant Discord ids, and at `endsAt` draws random
// winners, announces them, and (if `giftConfig` is set) DMs each winner a promo code.
model Giveaway {
  id            String   @id @default(cuid())
  prize         String
  channelId     String
  messageId     String? // the Discord message carrying the Enter button (set once posted)
  endsAt        DateTime
  winnersCount  Int      @default(1)
  status        String   @default("active") // active | ended
  entries       String[] @default([]) // entrant Discord ids
  winnerIds     String[] @default([]) // drawn winner Discord ids
  giftConfig    Json? // optional promo gift for each winner ({ kind, percentOff, … })
  requirements  Json? // optional entry gate: { linked?: bool (Discord⇄BCWEB account), creator?: bool (linked BMM creator id) }
  winnerMessage String? // customizable winner DM template; bot substitutes {user}/{prize}/{code}
  createdBy     String?
  createdAt     DateTime @default(now())

  @@index([status])
}

// A hosting shopping-cart checkout, persisted while the user is at Stripe. The
// resolved line items (hosting plan ids / boost repo+days) + promo codes are stored
// here and consumed by the checkout.session.completed webhook (metadata carries only
// the cart id, since a full cart won't fit in Stripe's metadata limits).
model PendingCart {
  id        String   @id @default(cuid())
  userId    String
  payload   Json // { items: [...], promoCodes: [...] }
  createdAt DateTime @default(now())

  @@index([userId])
}

model AdminSetting {
  key   String @id
  value Json
}

// A snapshot of a project page's config at a given version — powers the version-history
// modal (open a project page "as it was" in a past version, with that version's info +
// downloads). `target` is the built-in project key ("bmm") or a showcase ("sc:<id>"). A
// snapshot is (re)written whenever an admin saves that project's config while its version
// field is set, so each distinct version keeps its final config.
// Edit history for a project page's config blob (same idea as BlogRevision/DocRevision).
//
// The config lives in an AdminSetting row, which keeps only the CURRENT value — so an
// edit that broke a page left nothing to compare against and nobody to ask. A snapshot is
// written on every save: the whole config, who saved it, and when.
//
// Distinct from ProjectVersion, which is keyed by the config's own `version` STRING and
// exists to show visitors what shipped in each release. Two saves inside one version
// overwrite that row; here they are two entries, because "what changed at 14:02" is a
// different question from "what does 1.2.0 look like".
model ProjectConfigRevision {
  id        String   @id @default(cuid())
  // 'bmm' | 'bsm' | … for a fixed project, or 'sc:<id>' for a showcase project — the
  // same target convention ProjectVersion already uses.
  target    String
  config    Json
  editorId  String?
  createdAt DateTime @default(now())

  @@index([target, createdAt])
}

model ProjectVersion {
  id        String   @id @default(cuid())
  target    String
  version   String
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([target, version])
  @@index([target])
}

// Platform-hosted assets served at stable public URLs (/api/assets/<key>): app download
// files (BMM/BSM/BI installers), auto-update manifests, and JSON configs (links.json,
// contributors.json). A `file` asset lives in object storage (storageKey); a `json` asset
// stores its content inline so admins can edit it in the dashboard. `key` is the stable
// public slug. `channel`/`version` let one logical download (e.g. bmm-installer) advertise
// a version + release channel to the auto-updater.
model PlatformAsset {
  id          String   @id @default(cuid())
  key         String   @unique
  kind        String   @default("file") // "file" | "json"
  label       String   @default("")
  // file assets
  filename    String?
  contentType String?
  size        BigInt   @default(0)
  storageKey  String?
  version     String?
  channel     String   @default("stable")
  // json assets
  json        Json?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// One row per Ko-fi webhook event — lets the public funding-goal widget show a
// real running total + tip count, not just the one-time discount-grant flag on
// User. messageId dedupes Ko-fi's at-least-once webhook retries.
model KofiDonation {
  id             String   @id @default(cuid())
  messageId      String   @unique
  fromName       String
  email          String?
  amount         Float
  currency       String
  isSubscription Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

// Admin-curated "Other projects" showcase. Each has a name, a short tag (3-4 chars),
// and a flexible config (tabs, links, overview media, progress source, release-notes
// source, community, legal cards) rendered by a BMM/BSM-style project page.
model ShowcaseProject {
  id             String     @id @default(cuid())
  slug           String     @unique
  name           String
  short          String // 3-4 char label shown in the nav/cards
  // Logo/icon URL for this project — shown as the tag icon and used as the blog
  // thumbnail fallback for posts in this project's blog when they have no cover.
  icon           String?
  config         Json       @default("{}")
  published      Boolean    @default(true)
  order          Int        @default(0)
  // Per-blog toggle: do this custom page's posts also surface in the home page's
  // unified "Latest news"? They always show on /blog regardless of this flag.
  showOnHomeNews Boolean    @default(true)
  // Opt-in "Blog" tab on this page, showing only this page's own posts.
  showBlogTab    Boolean    @default(false)
  posts          BlogPost[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Who can view this page: public (anyone), private (nobody but admins), unlisted
  // (viewable with the direct link, just hidden from /projects and the topbar),
  // whitelist (gated by visibilityWhitelist — see pageAccountEntrySchema in lib.mjs).
  visibility          String  @default("public")
  visibilityWhitelist Json    @default("[]")
  // Shows this page as its own topbar pill (next to BMM/BSM/etc.) instead of only
  // being reachable through the /projects grid.
  pinTopbar           Boolean @default(false)

  // ── Project announcement (a "coming soon" teaser instead of the real page) ──
  // While announceEnabled and now < announceRevealAt, GET /showcase/:slug serves
  // the teaser (logo + markdown + countdown) regardless of `visibility`. Once the
  // countdown passes, the teaser stops and normal `visibility` rules take over —
  // there's nothing to sweep/cron, it's computed at read time (see showcase.mjs).
  announceEnabled     Boolean   @default(false)
  announceTitle       String    @default("")
  announceLogo        String?
  announceMarkdown    String    @default("")
  announceRevealAt    DateTime?
  // When true, the countdown does NOT take over the page — instead the real page
  // renders normally with an extra "Countdown" FIRST tab. When false (default) the
  // countdown is the only thing shown until it ends.
  announceShowPage    Boolean   @default(false)
  // Optional call-to-action on the countdown (teaser or first-tab): a button that
  // can point anywhere — an external URL, or an in-site /blog/… or /docs/… article.
  announceButtonLabel String    @default("")
  announceButtonUrl   String    @default("")

  // ── Scheduled content update: stage a future edit, swapped in automatically at
  // scheduledAt (old info fully replaced by "next") — computed + lazily persisted
  // on first read past scheduledAt (see showcase.mjs). ──
  scheduledAt   DateTime?
  scheduledNext Json?

  @@index([published, order])
}

// Contact-form submissions. Shown in the Admin dashboard and (if a webhook is
// configured) forwarded to Discord. No account required to send.
// A user report against another user / repo / catalog / catalog item, OR a general
// support thread. Works like a GitHub PR conversation: the reporter opens it with a
// message, staff and the reporter exchange messages (optionally with image attachments),
// and it moves open → archived (auto after inactivity, or manual) → deleted (after a
// further delay). A reporter may have at most one OPEN report per target at a time.
model Report {
  id             String          @id @default(cuid())
  targetType     String // "user" | "repo" | "catalog" | "item" | "general"
  targetId       String          @default("") // the reported entity's id ("" for general)
  targetLabel    String          @default("") // denormalized name for the admin list
  /// NULLABLE so a report can outlive the person who filed it.
  ///
  /// A report is about somebody ELSE'S content. When its author asks to be erased, deleting
  /// the report would remove moderation history about other people because the reporter left,
  /// and keeping the link would leave a pointer to an account that was told it was gone.
  /// Anonymising is the only option that costs neither: the decision and its thread survive,
  /// and nothing points back.
  ///
  /// Every read already tolerates it — canAccessReport compares ids, and the archive mail is
  /// guarded by `r.reporter?.email` — so this changes what CAN happen, not what does.
  reporter       User?           @relation("ReportReporter", fields: [reporterId], references: [id])
  reporterId     String?
  reason         String          @default("") // short category chosen by the reporter
  status         String          @default("open") // open | archived | closed
  staffUnread    Boolean         @default(true) // a new reporter message staff hasn't seen
  userUnread     Boolean         @default(false) // a new staff message the reporter hasn't seen
  lastActivityAt DateTime        @default(now())
  archivedAt     DateTime? // when it was archived (starts the delete countdown)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  messages       ReportMessage[]
  participants   ReportParticipant[]
  invites        ReportInvite[]
  sanctions      Sanction[]

  @@index([reporterId])
  @@index([status])
  @@index([targetType, targetId])
  @@index([lastActivityAt])
  @@index([archivedAt])
}

// Extra people added to a report thread beyond the reporter: other staff, or invited
// users. A participant can read + post in the thread (like the reporter).
model ReportParticipant {
  id        String   @id @default(cuid())
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      String   @default("invited") // "staff" | "invited"
  addedById String? // who added them (staff id), or null for a self-join via invite
  createdAt DateTime @default(now())

  @@unique([reportId, userId])
  @@index([reportId])
  @@index([userId])
}

// A shareable invite link to join a report thread. Optionally capped by number of uses and
// constrained to a specific account / email / BMM creator id.
model ReportInvite {
  id          String    @id @default(cuid())
  report      Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId    String
  token       String    @unique
  maxUses     Int       @default(1) // 0 = unlimited
  uses        Int       @default(0)
  targetType  String    @default("any") // any | user | email | creator
  targetValue String    @default("") // the account id / email / creator id it's locked to
  expiresAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([reportId])
}

model ReportMessage {
  id        String   @id @default(cuid())
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId  String
  author    User?    @relation(fields: [authorId], references: [id])
  authorId  String? // null = system note
  staff     Boolean  @default(false) // authored by a staff member (admin/mod)
  body      String   @default("")
  images    String[] @default([]) // uploaded attachment URLs (via the media presign)
  createdAt DateTime @default(now())

  @@index([reportId])
}

// A social account a user has linked to SHOW on their public profile (YouTube, Twitch,
// GitHub, Steam). Separate from OAuthAccount/DiscordLink (which are for signing in). Each
// provider is only offered if its credentials are configured server-side (.env).
model SocialConnection {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  provider   String // youtube | twitch | github | steam
  handle     String // display name / username
  url        String // public profile URL
  externalId String? // provider account id
  createdAt  DateTime @default(now())

  @@unique([userId, provider])
  @@index([userId])
}

model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  body      String
  // Set when the sender was logged in — links the message to their account so
  // support can see who's asking without them having to repeat it. Never required.
  user      User?     @relation(fields: [userId], references: [id])
  userId    String?
  /// What the sender says this is about.
  ///
  /// other · data_export · data_delete · bug · billing · appeal
  ///
  /// It exists because two of those are legal deadlines, not support tickets. A request to
  /// export or erase personal data has a clock on it, and until now it arrived as free text
  /// in the same list as "the download button is grey" — findable only by whoever happened
  /// to read it. A kind makes it countable, and a countable thing can be surfaced and
  /// chased. Sender-declared, so it is a routing hint and never a decision: staff can
  /// re-file one, and the body is still what gets read.
  kind      String    @default("other")
  ip        String    @default("") // for the daily anonymous rate limit + abuse review
  status    String    @default("new") // new | read
  readAt    DateTime?
  createdAt DateTime  @default(now())

  // Declared here because the DB already has it: 20260815040000_contact_kind created it and
  // the model never named it, so every drift check wanted to DROP an index the admin queue
  // filters on. Keeping the index and declaring it is the correct half of that disagreement.
  @@index([kind, status])
  @@index([createdAt])
}

enum PaymentKind {
  FEATURE
  HOSTING
  MYO_CONSULTATION // "Make Your Own" consultation fee (opens the advice conversation)
  MYO_PRODUCT // "Make Your Own" quote payment (starts the actual product build)
}

// Billing history / invoices (one-time feature promotions, hosting charges…).
model Payment {
  id              String      @id @default(cuid())
  user            User        @relation(fields: [userId], references: [id])
  userId          String
  serverRepoId    String? // legacy single-repo hosting payment
  hostingGroupId  String? // storage-pool hosting payment (the current model)
  kind            PaymentKind
  description     String
  amountCents     Int
  currency        String      @default("usd")
  days            Int? // promotion duration, when applicable
  stripeSessionId String?
  status          String      @default("paid")
  createdAt       DateTime    @default(now())

  @@index([userId])
}

// ── "Make Your Own" (MYO) — a paid consultation + commission service ─────────────
// A visitor pays a small CONSULTATION fee to open a conversation about a product they
// want built (a Discord bot, an app, a website, a custom job, a security audit…). In the
// conversation they get advice + a real QUOTE; paying the quote starts the actual build;
// the finished product is delivered back into the same conversation. Two clearly-separate
// payments: the consultation fee (this is an *avis*/advice — not the product) and, later,
// the quote (the product itself). Managed under the `manage_myo` capability.

// Admin-curated catalog card shown on the public /myo page (the 3 base options —
// discord_bot / app / website — plus custom / audit). Prices here are display-only "from"
// signals; the binding price is always the admin's per-request MyoQuote.
model MyoProduct {
  id             String       @id @default(cuid())
  kind           String // discord_bot | app | website | custom | audit | …
  name           String
  tagline        String       @default("")
  description    String       @default("")
  icon           String? // lucide name / brand icon / image URL
  basePriceCents Int          @default(0) // shown as "from $X" (0 = "quote only")
  options        Json         @default("[]") // [{ label, priceCents, note }] shown on the card
  includesSource Boolean      @default(true) // whether this kind usually ships with source
  active         Boolean      @default(true)
  featured       Boolean      @default(false)
  order          Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  requests       MyoRequest[]

  @@index([active, order])
}

// One user's commission request — the paid consultation conversation.
model MyoRequest {
  id                String      @id @default(cuid())
  user              User        @relation(fields: [userId], references: [id])
  userId            String
  product           MyoProduct? @relation(fields: [productId], references: [id])
  productId         String?
  productKind       String      @default("custom") // snapshot of the chosen kind
  // ── Intake (collected before the consultation payment) ──
  name              String // the product's name
  logo              String? // optional logo URL
  objective         String      @default("") // what it's for, in one line
  target            String      @default("personal") // personal|friends|community|nonprofit|commercial|other
  description       String      @default("") // ≤ 2000 chars (enforced in the route)
  lang              String      @default("en") // conversation language: en | fr
  urgent            Boolean     @default(false) // higher consultation fee, flagged to staff
  // ── Consultation payment (gate to open the conversation) ──
  consultationPaid  Boolean     @default(false)
  consultationCents Int         @default(0)
  stripeSessionId   String?
  // pending_payment → open (paid, advice stage) → quoted → in_production (quote paid) →
  // delivered → closed (reopenable) / cancelled.
  status            String      @default("pending_payment")
  staffUnread       Boolean     @default(true) // a user message staff hasn't seen
  userUnread        Boolean     @default(false) // a staff message the user hasn't seen
  // Who on the team owns this one. A queue where everybody sees everything is a queue
  // where two people answer the same request and nobody answers the next.
  assignedTo        User?       @relation("MyoAssignee", fields: [assignedToId], references: [id])
  assignedToId      String?
  assignedAt        DateTime?
  // Archived = handled, out of the working queue, still on file. Distinct from `closed`:
  // a request can be closed and still need invoicing, and a cancelled one still counts as
  // history. Nothing is ever deleted here — there is money attached to these rows.
  archivedAt        DateTime?
  lastActivityAt    DateTime    @default(now())
  closedAt          DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  messages          MyoMessage[]
  quotes            MyoQuote[]
  deliverables      MyoDeliverable[]

  @@index([userId])
  @@index([status])
  @@index([lastActivityAt])
  @@index([assignedToId])
  @@index([archivedAt])
}

// A message in a request's conversation (mirrors ReportMessage). Both the user and staff
// post here; `staff` marks the author side; `images` are uploaded attachment URLs.
model MyoMessage {
  id        String     @id @default(cuid())
  request   MyoRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String
  author    User?      @relation(fields: [authorId], references: [id])
  authorId  String? // null = system note
  staff     Boolean    @default(false)
  body      String     @default("")
  images    String[]   @default([]) // uploaded attachment URLs (media presign)
  createdAt DateTime   @default(now())

  @@index([requestId])
}

// A priced quote (devis) an admin builds inside a conversation. The user pays it to move
// the request into production. Line items are shown itemised; `includesSource` is surfaced
// as a badge (some products ship with source, some without).
model MyoQuote {
  id              String     @id @default(cuid())
  request         MyoRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId       String
  title           String     @default("")
  note            String     @default("")
  lineItems       Json       @default("[]") // [{ label, priceCents }]
  totalCents      Int        @default(0)
  currency        String     @default("usd")
  includesSource  Boolean    @default(false)
  validUntil      DateTime?
  status          String     @default("sent") // sent | paid | rejected | withdrawn
  stripeSessionId String?
  createdBy       String // admin userId
  createdAt       DateTime   @default(now())
  paidAt          DateTime?

  @@index([requestId])
}

// A finished-product delivery an admin posts into the conversation: an uploaded file
// and/or an external link (repo / hosted site), flagged whether it includes source code.
model MyoDeliverable {
  id             String     @id @default(cuid())
  request        MyoRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId      String
  title          String     @default("")
  note           String     @default("")
  fileUrl        String? // uploaded artifact (served via the media proxy)
  fileName       String?
  linkUrl        String? // external link / repo / hosted URL
  includesSource Boolean    @default(false)
  createdBy      String // admin userId
  createdAt      DateTime   @default(now())

  @@index([requestId])
}

// First-party, cookie-consent-gated page analytics (no third party, minimal data).
// `visitor` is a DAILY-rotating salted hash (ip+ua+date) — approximates unique
// visitors/sessions without a persistent cookie or storing any PII.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  path      String
  ref       String?
  visitor   String? // daily anonymous hash
  device    String? // mobile | tablet | desktop
  browser   String? // Chrome | Firefox | Safari | Edge | …
  os        String? // Windows | macOS | Ubuntu | Fedora | Kali | ChromeOS | Android | iOS | …
  country   String? // ISO-3166 alpha-2 (from the CDN's country header, when present)
  region    String? // subdivision (state/province) name, when geo resolves it
  city      String? // city name, when geo resolves it
  lat       Float? // approximate latitude from the IP (geoip `ll`), for the globe map
  lng       Float? // approximate longitude
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([visitor])
  @@index([country])
}

// Daily pre-aggregation of AnalyticsEvent so the dashboard's day-granularity series is a
// small primary-key range read instead of two full-window GROUP BY scans. Populated by the
// sweeper (rollupAnalyticsDaily). Rows persist beyond raw-event retention, so they also
// double as long-term history. `day` is the UTC date. (The hourly zoom still reads raw.)
model AnalyticsDaily {
  day       DateTime @id @db.Date
  views     Int      @default(0)
  visitors  Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Real-user Web Vitals (Core Web Vitals + FCP/TTFB), one row per metric sample, tied to
// the page path it was measured on. Percentiles (p50/p75/p90/p99) are computed per path
// in the admin panel. Values are milliseconds except CLS (unitless float).
model WebVital {
  id        String   @id @default(cuid())
  path      String
  metric    String // LCP | CLS | INP | FCP | TTFB
  value     Float
  rating    String? // good | needs-improvement | poor (as reported by web-vitals)
  // INP only: the element the slowest interaction landed on ("button: Save"). Identity,
  // never a field's value — this table is read by staff, and an INP number with nothing to
  // point at is something you can watch and cannot fix.
  label     String?
  visitor   String?
  device    String? // mobile | tablet | desktop
  browser   String? // Chrome | Firefox | Safari | Edge | … (for per-page breakdowns)
  os        String? // Windows | macOS | Android | iOS | …
  country   String? // ISO-3166 alpha-2 (from the CDN's country header, when present)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([metric])
}

// First-party in-page interaction events (clicks, copies, field edits, form submits,
// modal open/close). Same trust/consent model as AnalyticsEvent (daily anonymous
// visitor hash, no PII, no cookie) but kept in a SEPARATE table so it never pollutes
// pageview aggregates. Merged back into each visitor's session timeline in the admin
// Sessions feed (which button / which modal, à la a session-replay timeline) — without
// any heavyweight recording. `label` is a short human tag (button text / field name /
// modal title), never a field VALUE.
model InteractionEvent {
  id        String   @id @default(cuid())
  visitor   String? // daily anonymous hash (matches AnalyticsEvent.visitor)
  path      String // page path where it happened
  kind      String // click | copy | input | submit | modal_open | modal_close | nav
  label     String? // button text / field name / modal title (never a value)
  device    String? // mobile | tablet | desktop
  createdAt DateTime @default(now())

  @@index([visitor, createdAt])
  @@index([createdAt])
}

// Client-side errors captured in the wild (uncaught errors + unhandled rejections). Same
// consent model as the other analytics (daily anonymous visitor, no PII). Grouped by
// message in the admin error view (occurrences + distinct sessions + latest sample).
model ErrorEvent {
  id        String   @id @default(cuid())
  message   String // error message (bounded, client-clipped)
  stack     String? // stack trace (bounded)
  path      String // page path where it fired (or the request URL, for a server error)
  // "client" = reported by the browser (uncaught JS, consent-gated); "server" = a 5xx the
  // API's error handler caught. Server errors used to only reach stdout, so an admin
  // reading this page had no idea the API was failing.
  source    String   @default("client")
  visitor   String? // daily anonymous hash
  userId    String? // the signed-in account that hit it, if any (admin-only; resolved to a BC id)
  device    String?
  browser   String?
  os        String?
  country   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([message])
  @@index([source, createdAt])
}

// 404-page mini-game high scores. One best score per user per game (leaderboard). `userId`
// is a plain reference (no FK/cascade) so the leaderboard survives an account delete and the
// User model stays untouched; display name/avatar are resolved at read time.
model GameScore {
  id        String   @id @default(cuid())
  userId    String
  game      String   @default("orbfall")
  score     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, game])
  @@index([game, score])
}

// FAQ — admin/editor-curated questions & answers, grouped by category. Answers use the
// BetterCommunity doc-block markdown (rendered with the same md.jsx pipeline as blog/docs).
model FaqItem {
  id          String   @id @default(cuid())
  question    String
  // The question and the category are TITLES — they are what a French reader sees first, and
  // they had no translation while the answer did. Nullable: an entry with no French title
  // falls back to the English one rather than showing an empty heading.
  questionFr  String?
  answer      String   @default("") // markdown (doc-block system), EN base
  answerFr    String? // optional French translation
  category    String   @default("General")
  categoryFr  String?
  order     Int      @default(0)
  published Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([category])
}

// Admin-defined conversion goals, evaluated against the analytics streams. A goal matches
// a pageview (path) or an interaction (kind + optional label), both filtered by an optional
// path pattern. Completions + unique-visitor conversion rate are computed on demand.
model AnalyticsGoal {
  id        String   @id @default(cuid())
  name      String
  kind      String   @default("pageview") // pageview | click | submit | input | copy
  path      String? // path pattern (case-insensitive contains), optional
  label     String? // event label pattern (contains), optional — for click/submit/input
  // Optional numeric target (e.g. "reach 1000 pageviews / 200 signups this window"). When
  // set, the goal shows progress toward it in addition to the conversion rate.
  target    Int?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Blog newsletter subscribers. Double opt-in (GDPR): a signup starts `pending` and only
// becomes `active` once the confirm link is clicked. Every email carries a one-click,
// no-login unsubscribe link (unsubToken). We store only the email + status + timestamps
// + preferred locale — no other PII. Unsubscribing is always honoured.
model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  status         String    @default("pending") // pending | active | unsubscribed
  locale         String    @default("en") // preferred email language (en | fr)
  confirmToken   String?   @unique // consumed when the confirm link is clicked
  unsubToken     String    @unique // stable; embedded in every email
  createdAt      DateTime  @default(now())
  confirmedAt    DateTime?
  unsubscribedAt DateTime?

  @@index([status])
}

// A profile badge shown Twitch-chat-style next to a user's name (verified, developer,
// moderator, YouTuber, Twitch, certified, …). Admin-created & configurable.
model Badge {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String      @default("")
  // Visual: a lucide icon name, a simple-icons brand slug, or an uploaded image.
  iconType    String      @default("lucide") // "lucide" | "brand" | "image"
  icon        String      @default("BadgeCheck") // lucide/brand name, or an image URL / data URI
  color       String      @default("#f59e0b")
  // How it's earned: staff grant, the footer easter-egg, or an automatic rule.
  grant       String      @default("manual") // "manual" | "easter_egg" | "auto"
  trigger     String? // for easter_egg: the trigger key (e.g. "footer5x")
  // For grant="auto": the rule that auto-grants it, e.g.
  //   { type:"signup_nth", every:100 }  → every 100th signup (100th, 200th, …)
  //   { type:"signup_before", date:"2026-08-01" } → everyone who signed up before a date
  //   { type:"kofi_donation" } → anyone whose Ko-fi donation is matched to their account
  rule        Json?
  earnMessage String      @default("") // shown when earned (e.g. the footer 5x-click modal body)
  priority    Int         @default(0) // display order next to the name (higher = first)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  holders     UserBadge[]

  @@index([trigger])
}

model UserBadge {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  badgeId   String
  grantedAt DateTime @default(now())
  grantedBy String? // staff user id, or "system" for auto/easter-egg grants

  @@unique([userId, badgeId])
  @@index([userId])
}

// ─── Public API ──────────────────────────────────────────────────────────────

// One API key. Several per account, each named, each scoped, each revocable on its
// own — so a script that only reads a catalog cannot be replayed against the account
// it was minted from.
//
// The secret is NEVER stored. `hash` is its SHA-256 and the key is shown exactly once,
// at creation; losing it means minting another. The old `User.apiToken` sat in the
// database in clear and was re-readable from the profile page forever, which made
// "revoke" the only remedy for a leak nobody could detect (CWE-256, CWE-312).
model ApiKey {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  // What the key is for, in the owner's words. Shown in the list; never sent to callers.
  label      String    @default("")
  // First few characters of the secret, kept in clear on purpose: it is what the list
  // shows so the owner can tell two keys apart without being able to use either.
  prefix     String
  hash       String    @unique
  // Empty means "nothing" — a key with no scope authenticates and is allowed nothing.
  scopes     String[]  @default([])
  lastUsedAt DateTime?
  lastUsedIp String?
  // A test key: every write it makes is simulated, with no header to remember.
  //
  // The sandbox header works and is documented, but it is opt-in per request, which means the
  // one time you forget it you have written to your real account. A key that cannot write is
  // the same protection made structural — you choose it once, when you create the key,
  // instead of correctly every time.
  testMode   Boolean   @default(false)
  // Optional lifetime. A key past its date fails closed, it is not swept.
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  usageDays  ApiUsageDay[]
  requests   ApiRequest[]

  @@index([userId, createdAt])
}

// How much a key was used, per day. The count, and nothing else.
//
// Separate from ApiRequest below because the two answer different questions and only one
// of them can be answered by a sample. "Did this key make 12 calls or 12 000?" has to be
// exact and has to stay true for months; "what did call number 300 look like?" is a
// forensic question with a short shelf life. One row per key per day stays small enough to
// keep indefinitely, which is what makes a usage graph honest.
model ApiUsageDay {
  id     String   @id @default(cuid())
  key    ApiKey?  @relation(fields: [keyId], references: [id], onDelete: SetNull)
  keyId  String?
  // Denormalised so the history survives the key: an admin looking at last quarter's usage
  // should not lose it because somebody tidied up a token.
  userId String
  day    DateTime @db.Date
  count  Int      @default(0)
  errors Int      @default(0)
  // Sandbox calls are counted here but never added to `count`: the daily figure answers
  // "how much is this key really being used", and a console click is not use. Kept so the
  // usage chart can show exploration as its own band rather than as nothing at all —
  // "nobody is calling us" and "three people are learning the API" look identical otherwise.
  sandbox Int     @default(0)

  @@unique([keyId, day])
  @@index([userId, day])
  @@index([day])
}

// A SAMPLE of individual API calls — method, path, status, duration.
//
// Sampled and short-lived on purpose. Every call kept forever would be a second, unbounded
// copy of the access log inside the primary database, and the value of an individual line
// decays in days. Retention and sample rate are admin settings (api.sampleRate,
// api.retentionDays); the sweeper prunes.
//
// The path is stored WITHOUT its query string. Private share links carry their secret in
// the query (?k=…), and a table of URLs an admin can read is exactly where that must not
// end up (CWE-532).
model ApiRequest {
  id     String   @id @default(cuid())
  key    ApiKey?  @relation(fields: [keyId], references: [id], onDelete: SetNull)
  keyId  String?
  userId String?
  method String
  path   String
  status Int
  ms     Int      @default(0)
  ip     String?
  // A call made from the developer console's sandbox: authenticated and scope-checked, but
  // it wrote nothing. Kept apart from real traffic so somebody exploring the API does not
  // appear in the usage figures as a customer hammering it.
  sandbox Boolean @default(false)
  at     DateTime @default(now())

  @@index([at])
  @@index([userId, at])
  @@index([keyId, at])
}


// Polls — a question, some options, and an honest count.
//
// `audience` decides who may answer: 'users' (signed in, one vote each, exact) or 'all'
// (anybody, deduplicated by a device fingerprint). Both are offered because both are
// wanted, and the difference between them is a difference in what the number MEANS: the
// signed-in tally is exact, the open one is an estimate that both over- and under-counts
// (two people behind one router look like one; the same person on a phone looks like two).
// Every count is therefore stored and reported split by `wasLoggedIn`, never merged into a
// single reassuring total.
model Poll {
  id          String   @id @default(cuid())
  question    String
  description String   @default("")
  // 'users' | 'all'
  audience    String   @default("users")
  // More than one option allowed? maxChoices caps it (0 = no cap).
  multiple    Boolean  @default(false)
  maxChoices  Int      @default(0)
  // 'draft' | 'open' | 'closed'. Draft is invisible; closed keeps its results.
  status      String   @default("draft")
  opensAt     DateTime?
  closesAt    DateTime?
  // 'always' | 'after_vote' | 'staff' — when a voter may see the tally. after_vote is the
  // default because showing a running total before someone answers steers the answer.
  results     String   @default("after_vote")
  // Shown on the site's poll page, and optionally pinned to the home page.
  pinned      Boolean  @default(false)
  createdBy   User?    @relation("PollAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  options     PollOption[]
  votes       PollVote[]
  // Multi-question shape. `question` above becomes the TITLE; a single-question poll is one
  // PollQuestion, which is what the backfill turns every existing poll into.
  questions   PollQuestion[]
  answers     PollAnswer[]

  @@index([status, pinned])
}

// One question of a poll. `config` carries only what genuinely varies per kind — a scale's
// bounds, whether a choice question allows several answers — and is never aggregated, which is
// why it can be Json while the ANSWER's value cannot.
model PollQuestion {
  id       String       @id @default(cuid())
  poll     Poll         @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollId   String
  // 'choice' | 'text' | 'scale' | 'date' | 'number'. Five, not fifteen: each earns a typed
  // value column below and an aggregate that means something.
  kind     String       @default("choice")
  label    String
  help     String       @default("")
  required Boolean      @default(false)
  sort     Int          @default(0)
  config   Json?
  // One condition on one earlier answer: { questionId, equals: choiceId }. Full branching is
  // where form builders become unmaintainable; widening a Json column later is easy, narrowing
  // a branching engine is not.
  showIf   Json?
  choices  PollChoice[]
  answers  PollAnswer[]

  @@index([pollId, sort])
}

model PollChoice {
  id         String       @id @default(cuid())
  question   PollQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String
  label      String
  sort       Int          @default(0)
  answers    PollAnswer[]

  @@index([questionId, sort])
}

// One row per (voter, question, answer). Four TYPED value columns rather than one Json: a Json
// value would make every question kind free and every aggregate a full table scan, because
// "average rating" over Json cannot use an index — and the statistics are the reason this
// feature exists.
//
// Exactly one value column is non-null per row — with `choiceId` playing two roles depending
// on the question's kind, which is worth stating rather than discovering:
//
//   choice   choiceId IS the value. Nothing else is set.
//   ranking  choiceId says WHICH item, `number` says what rank it was given. Both, on purpose:
//            the answer is a pairing, and splitting it across two rows would make "rank 2" a
//            fact with nothing attached to it.
//
// Everything else sets exactly one of text / number / date and leaves choiceId null. Refining
// the rule this way keeps the aggregates indexable, which is the whole reason the columns are
// typed at all.
model PollAnswer {
  id          String        @id @default(cuid())
  poll        Poll          @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollId      String
  question    PollQuestion  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId  String
  choice      PollChoice?   @relation(fields: [choiceId], references: [id], onDelete: Cascade)
  choiceId    String?
  text        String?
  number      Float?
  date        DateTime?
  // WHICH sub-item of the question this row answers. 0 for every kind that has only one thing
  // to answer, and the row index for a grid — where one voter legitimately picks the SAME
  // column for two rows ("Speed: good, Docs: good") and the unique below would otherwise call
  // the second one a duplicate of the first. NOT NULL on purpose: a nullable discriminator is
  // no discriminator at all in Postgres, where every NULL is distinct from every other.
  slot        Int           @default(0)
  user        User?         @relation("PollAnswerer", fields: [userId], references: [id], onDelete: SetNull)
  userId      String?
  voterKey    String?
  // Same reason as PollVote.wasLoggedIn: a closed account must not move its answer into the
  // anonymous column and change a published result.
  wasLoggedIn Boolean       @default(false)
  createdAt   DateTime      @default(now())

  // The uniqueness moves with the data: one answer per (question, voter) for a single-choice
  // question, per (question, voter, choice) when several are allowed. NULLs are distinct in
  // Postgres, so the signed-in and anonymous forms coexist exactly as they do for PollVote.
  // `slot` is in the key so a grid can repeat a column across rows; it is 0 everywhere else,
  // which leaves the constraint exactly as strict as it was for every other kind.
  @@unique([questionId, userId, choiceId, slot])
  @@unique([questionId, voterKey, choiceId, slot])
  @@index([pollId, createdAt])
  @@index([questionId])
  @@index([userId])
}

model PollOption {
  id     String     @id @default(cuid())
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollId String
  label  String
  sort   Int        @default(0)
  votes  PollVote[]

  @@index([pollId, sort])
}

// One row per (voter, option). Multi-choice polls therefore produce several rows for one
// person, which is what makes "62% of voters picked A" computable separately from "A got
// 62% of the ticks" — two different numbers that a single counter would conflate.
//
// voterKey is a per-poll device fingerprint for anonymous voters, and NOT the daily
// analytics visitor hash: that one rotates at midnight, which would quietly let everybody
// vote again every day.
model PollVote {
  id          String     @id @default(cuid())
  poll        Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollId      String
  option      PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionId    String
  user        User?      @relation("PollVoter", fields: [userId], references: [id], onDelete: SetNull)
  userId      String?
  voterKey    String?
  // Kept even after userId is cleared (account closure anonymises the user, and the answer
  // still counted). Without it a closed account would silently move its vote into the
  // anonymous column and change a published result.
  wasLoggedIn Boolean    @default(false)
  createdAt   DateTime   @default(now())

  // NULLs are distinct in Postgres, so these two constraints coexist: one bites for signed
  // -in voters, the other for anonymous ones.
  @@unique([pollId, userId, optionId])
  @@unique([pollId, voterKey, optionId])
  @@index([pollId, createdAt])
  @@index([userId])
}

// What happened to a catalog item, and when — the record the item itself cannot keep.
//
// A deleted item is really deleted: the grace period ends and sweeper.mjs drops the row,
// leaving nothing behind. Without a tombstone the change feed could only ever report
// what still exists, which is the opposite of what a consumer syncing a mirror needs to
// know. So this table outlives the row it describes: `catalogId` goes null, the slug and
// kind stay.
model CatalogAuditLog {
  id        String      @id @default(cuid())
  // Null once the item row is gone. The slug is the durable identity.
  catalogId String?
  slug      String
  kind      CatalogKind
  ownerId   String?
  // created | updated | published | rejected | hidden | restored | deleted
  action    String
  version   String?
  detail    String      @default("")
  createdAt DateTime    @default(now())

  @@index([createdAt])
  @@index([slug, createdAt])
}

/// One signed-in device. Auth itself stays stateless (a JWT in the bcw_session cookie),
/// but the token now carries this row's id as `sid`, which buys two things a bare JWT
/// cannot give: the account owner can SEE where they are signed in, and can revoke a
/// single device without rotating anything global.
///
/// `revokedAt` is checked on every authenticated request, so revocation takes effect at
/// once rather than when the 7-day token happens to expire.
///
/// The IP is kept because it is the whole point of the panel — recognising a session you
/// do not know. Geo is resolved once at sign-in and stored denormalized: it must survive
/// the GeoIP database being updated later, and re-resolving on every read would turn a
/// list into a batch of lookups.
model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip         String?
  userAgent  String?
  device     String?
  browser    String?
  os         String?
  country    String?
  region     String?
  city       String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  /// Set when the user (or a global sign-out) kills this device. Kept rather than deleted
  /// so "signed out from X at Y" stays answerable; the sweeper prunes old rows.
  revokedAt  DateTime?

  @@index([userId, revokedAt])
  @@index([lastSeenAt])
}

/// A staff note about an account, and the record of why an account was closed or erased.
///
/// Deliberately NOT a relation to User. A note explaining why somebody was removed is the note
/// you need AFTER they are gone — a foreign key would cascade it away at the exact moment it
/// starts to matter. The subject is a plain id plus what they were called at the time, so the
/// trail survives the erasure it describes.
model StaffNote {
  id           String   @id @default(cuid())
  /// The account this is about. No FK on purpose — see above.
  subjectId    String
  /// Display name + address as they were when the note was written, so a closed account still
  /// reads as a person rather than as a cuid.
  subjectLabel String   @default("")

  /// note · closure · ban · suspension · erasure — what produced it. A `note` is somebody
  /// writing something down; the others are stamped by the action itself.
  kind         String   @default("note")
  body         String
  /// For an action: was the reason sent to the person, and to which address.
  notified     Boolean  @default(false)
  notifiedTo   String?

  author       User?    @relation("StaffNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorId     String?
  /// Denormalised for the same reason as subjectLabel: the author may leave too.
  authorLabel  String   @default("")

  pinned       Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([subjectId, createdAt])
  @@index([kind])
}
