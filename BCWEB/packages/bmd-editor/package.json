{
  "name": "@bettercommunity/bmd-editor",
  "version": "3.1.0",
  "description": "The editor for B.MD documents: a block menu with every directive, a live preview through the real renderer, phone and desktop layouts, a link checker and an HTML export, as one React component. Separate from @bettercommunity/bmd so a site that only reads documents never ships it.",
  "keywords": [
    "markdown",
    "editor",
    "react",
    "bmd",
    "wysiwyg",
    "directives",
    "bettercommunity"
  ],
  "license": "MIT",
  "author": "BetterCommunity (https://bettercommunity.ch)",
  "homepage": "https://bettercommunity.ch/dev/editor",
  "bugs": {
    "url": "https://github.com/FreeProject089/BCW/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FreeProject089/BCW.git",
    "directory": "BCWEB/packages/bmd-editor"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "snippets": [
        "./dist/snippets.d.ts"
      ],
      "block-canvas": [
        "./dist/block-canvas.d.ts"
      ],
      "live-preview": [
        "./dist/live-preview.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./snippets": {
      "types": "./dist/snippets.d.ts",
      "default": "./dist/snippets.js"
    },
    "./block-canvas": {
      "types": "./dist/block-canvas.d.ts",
      "default": "./dist/block-canvas.js"
    },
    "./live-preview": {
      "types": "./dist/live-preview.d.ts",
      "default": "./dist/live-preview.js"
    },
    "./editor.css": "./dist/editor.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "node ../bmd/scripts/build.mjs bmd-editor",
    "prepack": "node ../bmd/scripts/build.mjs bmd-editor",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@bettercommunity/bmd": "^3.1.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
