# Copy to .env and fill in. NEVER commit .env.
POSTGRES_USER=bcweb
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=bcweb

# 32+ random chars (openssl rand -hex 32)
JWT_SECRET=change-me-32-bytes-hex

# Object storage (MinIO defaults shown; use real S3 creds in prod)
S3_ACCESS_KEY=bcweb-minio
S3_SECRET_KEY=change-me-strong
S3_BUCKET=bcweb
# Public endpoint the BROWSER uses for pre-signed up/downloads (must be reachable
# from the user's machine). Local: http://localhost:9000 — Prod: https://s3.your-domain
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Caddy site address. LOCAL dev: http://localhost:5176 (plain HTTP on :5176).
# PRODUCTION: set to your bare domain (e.g. community.example.com) and Caddy
# auto-provisions HTTPS. See DOMAIN_SETUP.md for the full walkthrough.
SITE_DOMAIN=http://localhost:5176
# Full public URL (scheme + host) — used for Stripe + OAuth callback redirects.
SITE_URL=http://localhost:5176

# Parent domain the session cookie is scoped to, so it's ALSO sent to sub-domains
# (needed for the telemetry dashboard gate — see TELEMETRY_DOMAIN below).
#   LOCAL dev: localhost   (covers localhost + telemetry.localhost)
#   PRODUCTION: .your-domain.com   (leading dot = shared across all sub-domains)
# It MUST be the ROOT domain, not the telemetry sub-domain — otherwise the cookie
# would only reach telemetry and the main site login would break.
COOKIE_DOMAIN=localhost

# ─────────────────────────────────────────────────────────────────────────────
# Stripe (hosting & catalog-file billing). Leave both blank to disable paid
# features entirely (the free tier still works; paid buttons return "not
# configured"). Full setup:
#
# 1. SECRET KEY — dashboard.stripe.com → Developers → API keys → "Secret key".
#    Use a TEST key (sk_test_…) until you go live, then the live key (sk_live_…).
#
# 2. WEBHOOK — Stripe must call us back when a payment settles. Point a webhook at:
#        <SITE_URL>/api/hosting/webhook      (e.g. https://community.example.com/api/hosting/webhook)
#    and subscribe to EXACTLY these events (the only ones we handle):
#        • checkout.session.completed     → provision hosting / catalog-file hosting / featured boost
#        • invoice.paid                   → recurring hosting auto-renewal → extend the term
#        • invoice.payment_failed         → renewal charge failed → warn the owner
#        • customer.subscription.deleted  → recurring hosting stopped → suspend the repo / hide the item
#        • charge.refunded                → record the refund (the Discord bot can announce it)
#    Then copy the endpoint's "Signing secret" (whsec_…) into STRIPE_WEBHOOK_SECRET.
#
#    LOCAL dev (no public URL): forward events with the Stripe CLI —
#        stripe listen --forward-to localhost:5176/api/hosting/webhook
#    it prints a whsec_… to use here. The signature is verified on every call, so a
#    wrong/blank secret makes the webhook reject everything (payments won't apply).
#
# Prices are computed server-side from the admin pricing settings — there are NO
# Stripe Price IDs to configure here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Tag Manager container id (e.g. GTM-XXXXXXX). Optional — leave blank to never
# load it. Baked into the frontend bundle at BUILD time (Vite), and even when set it
# only actually loads client-side after a visitor accepts the "Analytics" cookie
# category (see CookieConsent.jsx / gtm.js) — matches the promise made on /cookies.
VITE_GTM_ID=

# OAuth "Continue with…" login/signup. Leave a provider's pair BLANK to hide its
# button entirely (the frontend only shows configured providers — see
# GET /auth/oauth/providers). Register an OAuth app and set the redirect/callback to
# exactly <SITE_URL>/api/auth/oauth/<provider>/callback:
#   GitHub:  github.com/settings/developers (OAuth Apps) → callback:
#              <SITE_URL>/api/auth/oauth/github/callback
#   Discord: discord.com/developers/applications → OAuth2 → Redirects:
#              <SITE_URL>/api/auth/oauth/discord/callback   (scopes: identify, email)
#   Google:  console.cloud.google.com → APIs & Services → Credentials →
#              OAuth client ID (Web application) → Authorized redirect URIs:
#              <SITE_URL>/api/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# BMM telemetry dashboard (served at TELEMETRY_DOMAIN, default http://telemetry.localhost).
# Access is gated at the edge by a BCWEB login + the "canViewTelemetry" permission
# (grant it from Admin → Access & permissions; SUPERADMIN always has access). No
# separate key is needed to open it. TELEMETRY_API_KEY is still what the BMM app uses
# to SEND telemetry, and TELEMETRY_ADMIN_KEY remains the dashboard's own fallback key.
TELEMETRY_ADMIN_KEY=change-me-admin
TELEMETRY_API_KEY=change-me
# Public hostname for the telemetry dashboard. It MUST be a SUB-DOMAIN of SITE_DOMAIN
# (so the session cookie — scoped via COOKIE_DOMAIN above — reaches it). A separate
# domain would NOT share the cookie and the gate would always bounce you to login.
#   Local:      http://telemetry.localhost
#   Production: https://telemetry.your-domain.com   (sub-domain of SITE_DOMAIN)
TELEMETRY_DOMAIN=http://telemetry.localhost
# URL the "open telemetry" SSO button uses — keep equal to TELEMETRY_DOMAIN.
TELEMETRY_PUBLIC_URL=http://telemetry.localhost
DISCORD_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# SSO — "Sign in with BetterCommunity" (OpenID Connect provider). NO env needed:
# the RS256 signing key is auto-generated (stored in the DB) and the issuer is your
# SITE_URL. Register client apps in Admin → SSO / OAuth. Discovery document:
#   <SITE_URL>/.well-known/openid-configuration

# ─────────────────────────────────────────────────────────────────────────────
# Transactional email (account-confirmation on sign-up + password-reset links).
# OFF by default: without it, password reset returns the token in the API response
# (dev flow) and no confirmation email is sent. Turn ON for production + set SMTP.
#
# Example below = Infomaniak-hosted domain (bettercommunity.ch): SPF already includes
# spf.infomaniak.ch and DKIM is managed by Infomaniak, so DMARC alignment just works —
# create a REAL mailbox (NOT the reserved "no-reply"/catchall special alias, which has no
# password) e.g. noreply@ / mailer@ / system@, and put its password in SMTP_PASS. (For a
# generic provider use its own smtp host/port/credentials instead.)
#EMAIL_ENABLED=true
#SMTP_HOST=mail.infomaniak.com
#SMTP_PORT=587                             # 465 = implicit TLS, otherwise STARTTLS
#SMTP_USER=noreply@bettercommunity.ch      # a real mailbox you created (no hyphen)
#SMTP_PASS=                                # that mailbox's password (keep in the real .env only)
#SMTP_FROM=BetterCommunity <noreply@bettercommunity.ch>

# ─────────────────────────────────────────────────────────────────────────────
# Object storage endpoint (S3-compatible). Default = the bundled MinIO container
# (free, stores on this server's disk) — fine to start. To migrate to Cloudflare
# R2 later (no egress fees, storage off-box), it's ENV-ONLY — no code changes:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_PUBLIC_ENDPOINT=<your R2 public/custom domain>
#   S3_BUCKET / S3_ACCESS_KEY / S3_SECRET_KEY = your R2 bucket + API token
# then copy existing objects once (rclone sync / mc mirror) and remove the minio
# service. Full walkthrough: guides/DEPLOY_EN.md → "Object storage".
# NOTE: the free Cloudflare CDN is a SEPARATE thing from R2 — you can (and should)
# put the free CDN in front at any time without paying for R2.
#S3_ENDPOINT=http://minio:9000
#S3_REGION=us-east-1

# ─────────────────────────────────────────────────────────────────────────────
# Managed / separate-server Postgres  (barreau ② — "DB on its own server", NO K8s).
# Set these FULL urls to point the whole stack at an external DB; they override the
# composed local defaults. Use the POOLED endpoint for DATABASE_URL and the DIRECT
# (non-pooled) endpoint for DIRECT_DATABASE_URL — migrations can't run through a pooler.
# Afterwards you can stop the bundled db:  docker compose stop db  (its volume is kept).
#DATABASE_URL=postgresql://user:pass@managed-host:5432/bcweb?sslmode=require
#DIRECT_DATABASE_URL=postgresql://user:pass@managed-host:5432/bcweb?sslmode=require

# ─────────────────────────────────────────────────────────────────────────────
# PgBouncer connection pooler (OPT-IN — only worth it with >1 api replica).
# 1) start it:   docker compose --profile pgbouncer up -d
# 2) route the API through it by uncommenting these three:
#DB_HOST=pgbouncer
#DB_PORT=6432
#DB_URL_PARAMS=?pgbouncer=true
# Migrations keep using the direct db:5432 connection automatically.
# To pool a MANAGED/remote Postgres (instead of the local db), also set:
#PGBOUNCER_UPSTREAM_HOST=managed-host
#PGBOUNCER_UPSTREAM_PORT=5432

# ─────────────────────────────────────────────────────────────────────────────
# Redis AUTH password (internal network only — the default is fine for a single
# box; set a strong one in production anyway).
#REDIS_PASSWORD=change-me-strong
