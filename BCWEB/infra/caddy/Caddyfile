# Global options. MUST be the first block in the file, and there was none before customer
# domains needed one — `on_demand_tls` is a global setting in Caddy, not a per-site one.
{
	# Before Caddy obtains a certificate for a name it has never seen, it asks the API whether
	# that name is one of ours. 200 = issue, anything else = refuse. This is the only thing
	# standing between "a customer can bring their own domain" and "anybody who points DNS at
	# this IP can make us request a certificate for their name" — which is both a way to burn
	# the ACME rate limit and a way to have us serve a stranger's traffic.
	#
	# `ask` is the whole guard, and it is enough: Caddy will not obtain a certificate for a
	# name the API refuses, however many times it is asked for one.
	#
	# There is deliberately no `interval`/`burst` here. Those options were deprecated and then
	# REMOVED, and a Caddy that meets them refuses the ENTIRE config and exits 1 — taking the
	# reverse proxy with it, so every site goes down over a setting that belongs to a feature
	# nobody has switched on yet. Which is exactly what happened: the containers were all up
	# and there was nothing in front of them.
	on_demand_tls {
		ask http://api:3000/domains/ask?key={$DOMAIN_ASK_KEY:}
	}

	# HTTPS terminated IN FRONT of this Caddy (a hosting relay, a router, another proxy that
	# holds the certificates and forwards plain HTTP to port 80 here). Production runs that way
	# since October 2026. Two things follow, and only the second needs this block:
	#
	#   1. Every site address must be written `http://name` (SITE_DOMAIN, TELEMETRY_DOMAIN,
	#      S3_DOMAIN in .env, and every sites.d/ file — `TLS_TERMINATED_UPSTREAM=true` makes
	#      infra/caddy/site.mjs write them that way). A bare `name` makes Caddy try to get a
	#      certificate the front proxy already has, fail, and retry for ever; it also redirects
	#      :80 to https, which the front proxy then forwards back to :80 — a loop.
	#   2. Every request arrives from the front proxy's address. Without this, the API sees ONE
	#      client: every rate limit is shared by all visitors, and an IP ban bans everybody.
	#      TRUSTED_PROXIES lists the front proxy's address(es) as seen from here (CIDR or IP,
	#      space-separated). Caddy then reads the real client from the X-Forwarded-For it sent
	#      (`strict`: the right-most address that is NOT a trusted proxy, which a client cannot
	#      forge) and passes it on as {client_ip} — see `header_up X-Forwarded-For` below.
	#      Empty (the default) = trust nobody, exactly the behaviour before this block.
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:}
		trusted_proxies_strict
	}
}

# Reverse proxy. SITE_DOMAIN drives the scheme:
#   local dev ? http://localhost  (plain HTTP on :80)
#   production ? your-domain.com   (Caddy auto-provisions HTTPS)
#
# TUNNEL_DOMAIN is a SECOND address on this same block, for showing a local stack to somebody
# who is not on this machine (infra/tunnel.mjs). Listed here rather than duplicated as its own
# block because everything below — headers, CSP, every route — must be identical, or the
# tunnel would be testing a different site than the one you run.
#
# It is REQUIRED, and the way it fails is quiet. Caddy matches sites by Host: a request
# arriving as `something.trycloudflare.com` does not match `localhost`, and Caddy answers
# 200 WITH AN EMPTY BODY. Not a 404 — an empty success. Measured: Host localhost returns
# 1044 bytes on `/`, any other host returns 0. So the tunnel connects, the page loads, and
# nothing is there.
#
# The default is a hostname nobody can request, so this costs nothing when no tunnel is up.
# Where the API lives, resolved FRESH on every refresh instead of once at startup.
#
# `reverse_proxy api:3000` resolves that name when the config loads and sticks to what it
# got. With one container that is correct and invisible. Run `docker compose up -d --scale
# api=3` and Docker's DNS starts returning three addresses — but Caddy is still talking to
# the one it resolved, so two thirds of the capacity you just paid for sits idle and nothing
# anywhere says so.
#
# `dynamic a` re-resolves on an interval and load-balances across every address it gets, so
# scaling up or down is a compose flag and nothing else. With a single replica it behaves
# exactly as before.
(api_upstream) {
	reverse_proxy {
		dynamic a {
			name api
			port 3000
			refresh 10s
		}
		# The DNS answer lags a rolling deploy by up to `refresh`. Without retries, every
		# request that dials a just-stopped container during that lag is a 502 the visitor
		# sees; with them, a failed DIAL tries the next address and nobody sees anything.
		# Dial failures only — a request the upstream ACCEPTED is never replayed, because
		# replaying a non-idempotent write is worse than failing it.
		lb_try_duration 12s
		lb_try_interval 250ms
		# A container that refused one dial is set aside briefly rather than re-tried by
		# every request in the queue.
		fail_duration 10s
		# ONE address: the client as Caddy established it (the peer, or with TRUSTED_PROXIES
		# the real client behind the front proxy). apps/api/src/lib/client-ip.mjs reads the
		# LAST hop; Caddy's default would append the front proxy after the client's own list,
		# and the last hop would be the proxy again. Unchanged when TRUSTED_PROXIES is empty.
		header_up X-Forwarded-For {client_ip}
	}
}

# Same shape, same reason. `reverse_proxy web:80` resolved the name when the config loaded
# and stuck with what it got — the exact defect described above api_upstream — so a rolling
# replacement of the web container would leave Caddy talking to the dead one's address.
# Port 8080: the web image runs nginx unprivileged (apps/web/Dockerfile, apps/web/nginx.conf),
# and an unprivileged process cannot listen on 80.
(web_upstream) {
	reverse_proxy {
		dynamic a {
			name web
			port 8080
			refresh 10s
		}
		lb_try_duration 12s
		lb_try_interval 250ms
		fail_duration 10s
	}
}

{$SITE_DOMAIN:http://localhost}, {$TUNNEL_DOMAIN:http://tunnel.invalid} {
	encode gzip zstd

	# -- form-action, per page (used by the CSP below) --
	# form-action does not fall back to default-src, so without it a form injected into a page
	# could post anywhere (ZAP 10055-13, 2026-09-25). 'self' everywhere, EXCEPT the two pages
	# whose form is SUPPOSED to end on another site: a browser checks form-action against every
	# redirect that follows the submission (Chromium does), and both of these answer the POST
	# with a redirect to a third party's registered URL:
	#   /authorize      the OAuth consent page (apps/web account-pages.jsx): its form posts to
	#                   /oauth2/authorize/decision, which redirects to the client's redirect_uri
	#   /oauth2/logout  the RP-initiated logout page (apps/api oidc-provider.mjs): its form posts
	#                   to /oauth2/logout, which redirects to the post_logout_redirect_uri
	# With 'self' there, every third-party sign-in would stop on the consent screen. The relaxed
	# list is what a registered redirect URI may be (oidc-provider.mjs: https, or http on
	# localhost / 127.0.0.1); [::1] cannot be written in a CSP source, so it is not listed.
	# apps/web/scripts/check-csp.mjs checks this map: the default must stay 'self', and only
	# these two paths may widen it.
	map {path} {csp_form_action} {
		/authorize "'self' https: http://localhost:* http://127.0.0.1:*"
		/oauth2/logout "'self' https: http://localhost:* http://127.0.0.1:*"
		default "'self'"
	}

	# -- Security headers --
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# HSTS. Without it, the FIRST request a visitor makes to `example.com` is plain HTTP
		# and can be intercepted before Caddy's redirect to HTTPS is ever seen — the session
		# cookie is Secure, but the login page itself, and every link on it, are not protected
		# on that first hop. One year, subdomains included, because the telemetry dashboard and
		# the S3 origin are subdomains of the same zone and share the session cookie.
		# No `preload`: that is a one-way submission to a browser-vendor list and belongs to an
		# owner decision, not to a config change.
		# Sent unconditionally: a browser IGNORES this header when it arrives over plain HTTP,
		# so the local `http://localhost:5176` default is unaffected.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# CSP (SECURITY_SUMMARY §9 #5, F10-9). Allows youtube/spotify embeds, rrweb blob
		# iframes and React inline STYLES.
		#
		# script-src has NO 'unsafe-inline'. It had, for one inline theme bootstrap, and that
		# is what made W1, W2 and A-4 script execution instead of inert text. The bootstrap is
		# apps/web/public/theme-boot.js now, the French preload reads a <meta>, and the GA4
		# bootstrap runs in the bundle (src/lib/gtm.js). Google Tag Manager / Analytics hosts
		# stay, for the consent-gated tag (loaded only after opt-in, client-side).
		# apps/web/scripts/check-csp.mjs (web `lint`) fails if 'unsafe-inline' comes back.
		#
		# connect-src is no longer `https: ws: wss:` (any host): only the site, the storage
		# origin the api signs into pre-signed URLs (S3_PUBLIC_ENDPOINT, and S3_DOMAIN which
		# fronts it), and the hosts the site really calls from the browser:
		#   raw.githubusercontent.com   project notes read from GitHub
		#   cdn.jsdelivr.net, cdn.simpleicons.org   the icon picker's catalogues and SVGs
		#   basemaps.cartocdn.com       the admin analytics map's raster tiles (maplibre fetches)
		#   *.google-analytics.com, *.analytics.google.com, *.googletagmanager.com   GA4 hits
		# CSP_CONNECT_SRC_EXTRA adds more (space-separated), for a live B.MD block's host or a
		# project's live-number source; empty by default.
		#
		# Kept on purpose, and reviewed as ZAP IGNORE rules in .github/security/zap-rules.tsv
		# (2026-09-25): style-src 'unsafe-inline' (React `style={…}` attributes and the theme
		# engine's runtime CSS variables are inline styles; a nonce cannot cover an attribute),
		# and img-src/media-src/font-src `https:` (avatars and markdown images, videos and theme
		# fonts come from any host a member links). style-src `https:` was not proven unused and
		# was left alone: dropping it would not clear that ZAP alert, which img-src keeps anyway.
		# form-action is per page: see the map above.
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https: blob:; media-src 'self' https: blob:; font-src 'self' data: https:; style-src 'self' 'unsafe-inline' https:; script-src 'self' https://www.googletagmanager.com https://www.google-analytics.com https://ssl.google-analytics.com https://tagmanager.google.com; worker-src 'self' blob:; child-src 'self' blob:; frame-src 'self' blob: {$TELEMETRY_DOMAIN:http://telemetry.localhost} https://www.youtube-nocookie.com https://www.youtube.com https://open.spotify.com https://www.googletagmanager.com; connect-src 'self' {$S3_PUBLIC_ENDPOINT:http://localhost:9000} {$S3_DOMAIN:http://s3.invalid} https://raw.githubusercontent.com https://cdn.jsdelivr.net https://cdn.simpleicons.org https://basemaps.cartocdn.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com {$CSP_CONNECT_SRC_EXTRA:}; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action {csp_form_action}"
		-Server
	}

	# -- Edge anti-bot / anti-scan (handle blocks are evaluated in written order
	#    and are mutually exclusive, so these run BEFORE any upstream — unlike a
	#    bare `respond`, which Caddy orders after `handle`). --
	# Block known attack-tool / aggressive-scraper User-Agents outright.
	@badbots header_regexp User-Agent (?i)(sqlmap|nikto|nmap|masscan|zgrab|nuclei|wpscan|dirbuster|gobuster|feroxbuster|acunetix|nessus|openvas|metasploit|semrushbot|ahrefsbot|mj12bot|petalbot|bytespider)
	handle @badbots {
		respond 403
	}
	# Common vuln-scanner probe paths for OTHER stacks — nothing here to serve, so
	# abort at the edge instead of running the SPA fallback (saves nginx + logs).
	@scanpaths path /wp-login* /wp-admin* /wp-content* /xmlrpc.php /.env /.env.* /.git* /.aws* /phpmyadmin* /administrator* /vendor/* /cgi-bin/* /actuator* /.ssh* /*.sql /shell* /eval-stdin.php /solr/*
	handle @scanpaths {
		respond 404
	}

	# -- One URL per page --
	# `/faq` and `/faq/` both answered 200 with byte-identical HTML, and the SPA writes its
	# canonical link from the path it was served at, so every route on the site existed twice
	# as far as a crawler is concerned. That is duplicate content on the whole tree, and it
	# also splits analytics and makes every shared link a coin flip.
	#
	# 308 rather than 301: it keeps the method and body, so a POST that arrives with a stray
	# slash still works instead of silently turning into a GET.
	#
	# Two matchers because Caddy has no "append the query only if there is one": with a single
	# rule every redirect ends in a bare `?`. The first handles the URLs that carry a query,
	# the second the ones that do not. The pattern never matches the root, which must keep its
	# slash.
	#
	# /api and /hosting are exempt. Under /hosting a trailing slash is not noise, it is a
	# directory listing of a hosted repo and means something different from the file beside
	# it; the API answers both spellings itself (ignoreTrailingSlash in server.mjs), which is
	# the right fix for a programmatic client that should not have to follow a redirect.
	#
	# An app mounted on a path by a drop-in in paths.d/ is exempt too, for the same reason and
	# a worse failure: its page lives at `/myapp/`, and stripping that slash sends the visitor
	# to `/myapp`, which the drop-in redirects back to `/myapp/` — a redirect loop. Each
	# paths.d file sets the `bc_mount` variable on its own prefix (`vars` runs before `redir`),
	# so this list never has to be edited to mount something.
	#
	# The captured path must not start with a second `/`, a `\` (\x5c) or whitespace. The
	# Location it produces is RELATIVE, and browsers read `/\evil.example` (and `/<TAB>/evil…`,
	# the tab being dropped) as `//evil.example`: a request for `/%5Cevil.example/` was answered
	# `308 Location: /\evil.example`, an open redirect to any host (CWE-601), found by the DAST
	# job (nuclei open-redirect-generic, 2026-09-25). Such a path is not a page anyway; it falls
	# through to the SPA like any unknown URL. `\x5c` is written that way because the Caddyfile
	# lexer turns `\\` into one backslash (checked with `caddy adapt`).
	@tslash_q {
		path_regexp tslash ^(/[^/\x5c\s].*)/$
		not path /api/* /hosting/* /og/*
		not vars {http.vars.bc_mount} yes
		expression {query} != ""
	}
	redir @tslash_q {re.tslash.1}?{query} 308
	@tslash {
		path_regexp tslash2 ^(/[^/\x5c\s].*)/$
		not path /api/* /hosting/* /og/*
		not vars {http.vars.bc_mount} yes
	}
	redir @tslash {re.tslash2.1} 308

	# The API's own /og/* assets (e.g. the composed /og/profile/<id>.png card image) — served
	# DIRECTLY by the API for everyone, never through the unfurl rewrite below. Must come before
	# @unfurl so a crawler fetching the image gets the PNG, not the meta-tag HTML shell.
	handle /og/* {
		import api_upstream
	}

	# -- Link-unfurl prerender --
	# Social/link-preview crawlers (Discord, Twitter/X, Slack, Telegram, WhatsApp,
	# Facebook, …) don't run our SPA's JS, so a shared URL would only ever show the
	# static homepage card. Route ONLY those bots (by User-Agent) to the API's /og
	# endpoint, passing the original path — it returns per-page og:title/og:image so
	# a blog link unfurls with its own title + cover. Real users never match this and
	# fall through to the SPA below. Must precede /api, /hosting and the SPA handles.
	@unfurl {
		# Link-unfurl bots ONLY — deliberately NOT search engines (Googlebot/Bingbot
		# render JS and must get the indexable SPA, not this noindex redirect shell).
		header_regexp User-Agent (?i)(discordbot|twitterbot|facebookexternalhit|facebot|slackbot|slack-imgproxy|telegrambot|whatsapp|linkedinbot|embedly|redditbot|pinterest|vkshare|skypeuripreview|nuzzel|bitlybot|iframely|mastodon|snapchat)
		path / /blog/* /project/* /p/* /item/* /catalog /repos /hosting /projects /u/*
	}
	handle @unfurl {
		rewrite * /og?u={uri}
		import api_upstream
	}

	# -- Other apps mounted on a PATH of this domain (infra/caddy/paths.d/*.caddy) --
	# One file per app, written by `node infra/caddy/site.mjs add path …` or by hand from
	# infra/caddy/templates/path.caddy. This line is the only thing in this block that ever
	# has to know about them. An app here shares this ORIGIN — cookies, CSP, the lot — so a
	# sub-domain (sites.d/, below) is the right home for anything not trusted like this site.
	# No file yet = a warning in the log and nothing else; Caddy does not fail on an empty glob.
	import paths.d/*.caddy

	# API
	# The certificate-issuance question is asked by CADDY, over the internal network, at
	# http://api:3000/domains/ask. It has no business being reachable from the internet: a
	# stranger could otherwise use it to learn whether any hostname they name is hosted here.
	# Blocked before the /api proxy below, which would otherwise forward it.
	handle /api/domains/ask* {
		respond 404
	}

	handle_path /api/* {
		import api_upstream
	}

	# Public hosted-repo content (repo.json / files) at a clean URL: /hosting/<user>/<repo>/...
	handle /hosting/* {
		import api_upstream
	}

	# SEO files served by the API (dynamic sitemap incl. Other Projects + blog).
	handle /sitemap.xml {
		import api_upstream
	}
	handle /robots.txt {
		import api_upstream
	}
	# Public aggregate Server-Repos feed (a consumable repo.json index of every listed repo).
	handle /repos.json {
		import api_upstream
	}

	# Public catalog.json feed (BMM-consumable app/plugin/theme catalog, ?project=&kind=).
	handle /catalog.json {
		import api_upstream
	}

	# notify (agent-notify): RSS/Atom feeds, at a clean URL a feed reader keeps for years.
	# /feeds/news.xml is public; /feeds/u/<token>.xml is a member's personal feed, whose file
	# name IS the credential. Caddy writes no access log for this site block, and the API
	# redacts that path in its own logs (errorlog.mjs redactPath), so the token is stored nowhere.
	handle /feeds/* {
		import api_upstream
	}

	# OpenID Connect provider: discovery + JWKS (issuer-root paths, NOT under /api) and
	# the OAuth2 authorize/token/userinfo endpoints. Specific well-known paths only, so
	# Caddy still answers /.well-known/acme-challenge/* itself for TLS.
	handle /.well-known/openid-configuration {
		import api_upstream
	}
	handle /.well-known/jwks.json {
		import api_upstream
	}
	handle /oauth2/* {
		import api_upstream
	}

	# Content-hashed static assets (Vite emits immutable `assets/*.[hash].js|css`) ?
	# cache hard at the browser/CDN so a CDN serves repeats with zero origin hits.
	# The HTML shell (handled below) stays uncached so a deploy is picked up at once.
	@assets path /assets/*
	handle @assets {
		header Cache-Control "public, max-age=31536000, immutable"
		import web_upstream
	}

	# Everything else ? the web SPA
	handle {
		import web_upstream
	}
}

# BMM telemetry dashboard on its OWN origin (it owns /api, /assets, etc., which
# would collide under a sub-path). Local: http://telemetry.localhost.
# Production: set TELEMETRY_DOMAIN to a real subdomain (auto-HTTPS).
#
# TELEMETRY_TUNNEL_DOMAIN is the second address, mirroring TUNNEL_DOMAIN on the site block
# above so the two are configured the same way. It is NOT wired into infra/tunnel.mjs, and
# that is deliberate: a Cloudflare QUICK tunnel cannot serve this dashboard, for a reason no
# amount of configuration fixes.
#
# The forward_auth gate below reads the session cookie set by the main site. A quick tunnel
# hands out ONE random hostname per process, so the dashboard would need a second, unrelated
# `*.trycloudflare.com` name — and two unrelated hostnames cannot share a cookie. Scoping it
# to `trycloudflare.com` itself is not an option either: it is on the Public Suffix List and
# browsers refuse a cookie set that wide. The gate would deny every request.
#
# So this slot is for a REAL domain, where the site and the dashboard are two subdomains of
# one zone and the cookie spans both. Until then it stays at its unreachable default.
{$TELEMETRY_DOMAIN:http://telemetry.localhost}, {$TELEMETRY_TUNNEL_DOMAIN:http://telemetry-tunnel.invalid} {
	encode gzip zstd

	# -- Security headers --
	# This origin had NONE. It is the most privileged surface on the platform — every
	# installation's telemetry, behind nothing but a session cookie and `canViewTelemetry` —
	# and without `frame-ancestors`/X-Frame-Options any page on the internet could frame it
	# and drive an authenticated admin's clicks (CWE-1021). It was `DENY` while nothing framed
	# the dashboard; the OS mode's telemetry window does now (see "Framing" below), so only
	# the site's own origin may.
	#
	# A CSP is NOT set here yet, and that is deliberate rather than forgotten. The dashboard
	# is not self-contained: MapPage.tsx pulls raster tiles from tile.openstreetmap.org and
	# basemaps.cartocdn.com, glyphs from fonts.openmaptiles.org, visuals.tsx pulls flags from
	# flagcdn.com, and index.html loads the Inter stylesheet from rsms.me. The policy that
	# actually fits is the line below; it has not been switched on because a CSP that is one
	# host short white-pages an admin surface, and that has to be confirmed in a browser
	# against the running stack, not reasoned about. Owner: enable it after that check.
	#
	#	Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https://tile.openstreetmap.org https://basemaps.cartocdn.com https://flagcdn.com; style-src 'self' 'unsafe-inline' https://rsms.me; font-src 'self' data: https://rsms.me; script-src 'self'; worker-src 'self' blob:; connect-src 'self' https://fonts.openmaptiles.org; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	#
	# Framing (agent-bcw-os, Sept 30 2026): the admin's OS mode shows this dashboard in a window,
	# an <iframe> on the SITE's origin. So `frame-ancestors` names the site (and its tunnel
	# address), and nothing else: any other page still cannot frame it (CWE-1021 stays closed).
	# X-Frame-Options cannot name another origin (ALLOW-FROM is dead), so it goes; browsers
	# ignore it anyway when frame-ancestors is present. The site's own CSP lists this origin in
	# frame-src. This policy is frame-ancestors ONLY, on purpose: the full one above is still
	# waiting for its browser check (apps/web/scripts/check-csp.mjs knows this exception).
	header {
		X-Content-Type-Options nosniff
		Content-Security-Policy "frame-ancestors {$SITE_DOMAIN:http://localhost} {$TUNNEL_DOMAIN:http://tunnel.invalid}"
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Public ingest + client-facing helpers. BMM posts telemetry batches with an
	# api_key (NOT a login session), so these MUST bypass the dashboard's
	# forward_auth gate below — otherwise the app's telemetry is blocked at the edge.
	# (These endpoints expose no collected data — see main.rs "public" router.)
	# /issues is BMM's live error reporting (same public key, its own rate bucket).
	@ingest path /batch /batch/ /batch/* /capture /capture/* /delete-request /data-request /api/packet-status /issues
	handle @ingest {
		# One address, as on the API (see api_upstream): the telemetry server reads the FIRST
		# X-Forwarded-For hop, which with TRUSTED_PROXIES set would otherwise be the client's own.
		reverse_proxy telemetry:8900 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# The DASHBOARD (SPA + /api/stats + assets): gated behind a BCWEB login + the
	# canViewTelemetry grant. forward_auth hits the BCWEB API first: 2xx ? proceed;
	# otherwise its response (302 to /auth for anon, 403 for signed-in-but-not-
	# granted) is returned to the browser. The telemetry app itself is never modified.
	# NOTE: the bcw_session cookie must reach this sub-domain, so set COOKIE_DOMAIN
	# (BCWEB api) to a parent domain (e.g. .example.com) in production.
	# NOTE: forward_auth talks to api:3000 directly (not through this proxy), so the
	# path is the API's real route WITHOUT the /api prefix that handle_path strips.
	handle {
		# Static on purpose: forward_auth takes a plain upstream, not the `dynamic a` block
		# the site's routes use. With several API replicas this gate always asks the same one,
		# so if THAT replica is down the telemetry dashboard bounces everyone to login while
		# the site itself is fine. It is an admin surface, so the trade is acceptable — but it
		# is a trade, not an oversight.
		forward_auth api:3000 {
			uri /telemetry/authorize
			header_up X-Forwarded-For {client_ip}
		}
		reverse_proxy telemetry:8900 {
			header_up X-Forwarded-For {client_ip}
		}
	}
}

# -----------------------------------------------------------------------------
# Object storage (the `storage` service, versitygw) on its own origin.
#
# INERT until S3_DOMAIN is set — the default is a hostname nobody can request, exactly like
# TUNNEL_DOMAIN above. Locally storage is reached directly on :9000 and this block never
# matches, so it costs nothing.
#
# To turn it on: point an A record at this server, then in infra/compose/.env set
#   S3_DOMAIN=s3.example.com
#   S3_PUBLIC_ENDPOINT=https://s3.example.com
# and `docker compose up -d caddy api`. Caddy provisions the certificate itself.
#
# WHY IT IS NEEDED AT ALL: uploads never pass through the API. The browser asks for a
# pre-signed URL and PUTs the bytes straight at storage, so storage needs a public address —
# and its own :9000 is published on 127.0.0.1 only (compose), so from outside the host this
# block IS that address. The site CSP's connect-src names it (S3_PUBLIC_ENDPOINT, S3_DOMAIN).
#
# NO `handle_path`, NO path prefix. A pre-signed S3 signature covers the HOST and the PATH,
# so rewriting either makes the gateway compute a different signature and answer 403
# SignatureDoesNotMatch — which reads as "wrong credentials" and is nothing of the sort.
# Caddy v2 forwards the incoming Host header unchanged by default, which is what makes the
# signature match; do not add `header_up Host {upstream_hostport}` here.
{$S3_DOMAIN:http://s3.invalid} {
	# This origin serves USER-UPLOADED bytes and had no headers at all. `nosniff` is safe to
	# add here because every writer names a Content-Type (storage.mjs presignPut/putObject),
	# so no asset depends on a type being guessed.
	# And the type is the API's choice, not the uploader's claim: a presigned PUT is signed
	# over Content-Type and Content-Length (X-Amz-SignedHeaders=content-length;content-type;host,
	# storage.mjs presignPut), so the gateway refuses 403 SignatureDoesNotMatch a PUT whose type
	# or byte count differs from what the API validated (measured against versitygw v1.8.0,
	# 2026-09-25, agent-presign; until then it signed `host` only and any type was stored).
	# A hosted-repo file still takes the type its uploader names, text/html and SVG included,
	# and nothing sets Content-Disposition, so such an object opens as a document on this
	# sub-domain of the brand. The CSP below makes that document inert: `sandbox` without
	# allow-scripts gives it a unique opaque origin and no script, form or popup, and
	# `default-src 'none'` stops it loading anything. It costs the legitimate uses nothing: an
	# <img>, <video> or fetch of an object from the site is governed by the SITE's CSP, not by
	# the response's, and a download is a download (owner decision, Sept 25).
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy no-referrer
		Content-Security-Policy "sandbox; default-src 'none'; img-src 'self' data:; media-src 'self'; style-src 'unsafe-inline'; frame-ancestors 'none'; form-action 'none'"
		-Server
	}
	reverse_proxy storage:9000
}

# ── Customer domains ──────────────────────────────────────────────────────────────────────
#
# A paying owner points a CNAME at us and their repo or catalogue answers on their own name.
# This block is the catch-all: it matches any Host that none of the blocks above claimed.
#
# The certificate is obtained ON DEMAND, at the moment of the first TLS handshake for that
# name — there is no list of domains in this file, because the list lives in the database and
# changes without a redeploy. `ask` is what makes that safe: before Caddy will obtain a
# certificate it asks the API whether the name is one of ours, and the API answers 200 only
# for a VERIFIED domain attached to something on a paid pool. Without `ask`, anybody who
# points a DNS record at this IP makes us request a certificate for their name, which is both
# a way to burn the ACME rate limit and a way to have us serve a stranger's traffic.
#
# The API does the rest: an onRequest hook rewrites `/foo.zip` on a customer host to the
# `/hosting/<path>/files/foo.zip` route, so every access rule, password and counter that
# already existed applies unchanged. Nothing about the request reaches a different handler
# than it would on our own domain.
#
# Not enabled by default: CUSTOM_DOMAINS must be set to `https://` for this block to bind.
# The placeholder is a scheme+host nobody can request, exactly like TUNNEL_DOMAIN above, so a
# stack that has not opted in costs nothing.
{$CUSTOM_DOMAIN_MATCHER:http://custom-domains.invalid} {
	encode gzip zstd
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# A customer domain serves an owner's repo manifest and their UPLOADED files. Two
		# headers were missing that the site block has had all along, and the content here is
		# less trusted than the content there, not more:
		#   - framing: without it a stranger frames a paid owner's download page and drives
		#     clicks on it (CWE-1021). SAMEORIGIN, matching the site block, so an owner can
		#     still frame their own pages on their own name.
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
		#
		# Two more belong here and are NOT set, because both act on a name that is not ours:
		#
		#   Content-Security-Policy "sandbox allow-downloads; frame-ancestors 'self'"
		#     An .html a customer uploads is served from THEIR origin, so it can already only
		#     attack their own visitors — but it runs with nothing stopping it. `sandbox` is
		#     the right shape here rather than a source allowlist, since this block serves no
		#     application of ours. It is off because a repo index that legitimately uses
		#     JavaScript would stop working (an nginx-style index counts as a repo here), and
		#     that is a product decision about what a paid customer is allowed to host.
		#
		#   Strict-Transport-Security "max-age=31536000"
		#     Pinning a YEAR of HTTPS-only onto a domain the customer owns follows them if
		#     they later point it somewhere that serves plain HTTP. That commitment is the
		#     owner's to make (and belongs in the custom-domain terms), not a config default.
	}
	tls {
		on_demand
	}
	# Everything, including `/`: on a customer domain the apex IS the repo manifest, and the
	# API's rewrite decides what that means for a repo versus a catalogue.
	import api_upstream
}

# ── Other sites and apps on this server (infra/caddy/sites.d/*.caddy) ─────────────────────
#
# Everything that is not BetterCommunity lives in its own file in sites.d/: one sub-domain or
# domain per file, each a complete site block. Adding one never touches a line above.
#
#   node infra/caddy/site.mjs add host --domain shop.example.com --port 8081
#
# writes the file from infra/caddy/templates/, validates the WHOLE config, and only then
# reloads Caddy (guides/run/CADDY_SITES_EN.md). Caddy obtains each name's certificate itself,
# the same way it does for the site above: the only manual step is the DNS record.
#
# Matching is by Host, and the most specific address wins, so a name here is served by its
# own block even while the customer-domain catch-all above is switched on.
#
# No file yet = a warning in the log and nothing else; Caddy does not fail on an empty glob.
import sites.d/*.caddy
