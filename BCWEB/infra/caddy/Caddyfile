# Reverse proxy. SITE_DOMAIN drives the scheme:
#   local dev → http://localhost  (plain HTTP on :80)
#   production → your-domain.com   (Caddy auto-provisions HTTPS)
#
# TUNNEL_DOMAIN is a SECOND address on this same block, for showing a local stack to somebody
# who is not on this machine (infra/tunnel.mjs). Listed here rather than duplicated as its own
# block because everything below — headers, CSP, every route — must be identical, or the
# tunnel would be testing a different site than the one you run.
#
# It is REQUIRED, and the way it fails is quiet. Caddy matches sites by Host: a request
# arriving as `something.trycloudflare.com` does not match `localhost`, and Caddy answers
# 200 WITH AN EMPTY BODY. Not a 404 — an empty success. Measured: Host localhost returns
# 1044 bytes on `/`, any other host returns 0. So the tunnel connects, the page loads, and
# nothing is there.
#
# The default is a hostname nobody can request, so this costs nothing when no tunnel is up.
{$SITE_DOMAIN:http://localhost}, {$TUNNEL_DOMAIN:http://tunnel.invalid} {
	encode gzip zstd

	# ── Security headers ──
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Permissive-but-real CSP (allows the app's github/minio fetches, youtube
		# embeds, rrweb blob iframes, inline theme bootstrap + React inline styles).
		# script-src also allows Google Tag Manager / Analytics so a consent-gated
		# analytics tag works when enabled (it is only loaded after opt-in, client-side).
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https: blob:; media-src 'self' https: blob:; font-src 'self' data: https:; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://ssl.google-analytics.com https://tagmanager.google.com; worker-src 'self' blob:; child-src 'self' blob:; frame-src 'self' blob: https://www.youtube-nocookie.com https://www.youtube.com https://www.googletagmanager.com; connect-src 'self' https: http://localhost:9000 ws: wss:; frame-ancestors 'self'; base-uri 'self'"
		-Server
	}

	# ── Edge anti-bot / anti-scan (handle blocks are evaluated in written order
	#    and are mutually exclusive, so these run BEFORE any upstream — unlike a
	#    bare `respond`, which Caddy orders after `handle`). ──
	# Block known attack-tool / aggressive-scraper User-Agents outright.
	@badbots header_regexp User-Agent (?i)(sqlmap|nikto|nmap|masscan|zgrab|nuclei|wpscan|dirbuster|gobuster|feroxbuster|acunetix|nessus|openvas|metasploit|semrushbot|ahrefsbot|mj12bot|petalbot|bytespider)
	handle @badbots {
		respond 403
	}
	# Common vuln-scanner probe paths for OTHER stacks — nothing here to serve, so
	# abort at the edge instead of running the SPA fallback (saves nginx + logs).
	@scanpaths path /wp-login* /wp-admin* /wp-content* /xmlrpc.php /.env /.env.* /.git* /.aws* /phpmyadmin* /administrator* /vendor/* /cgi-bin/* /actuator* /.ssh* /*.sql /shell* /eval-stdin.php /solr/*
	handle @scanpaths {
		respond 404
	}

	# ── Link-unfurl prerender ──
	# Social/link-preview crawlers (Discord, Twitter/X, Slack, Telegram, WhatsApp,
	# Facebook, …) don't run our SPA's JS, so a shared URL would only ever show the
	# static homepage card. Route ONLY those bots (by User-Agent) to the API's /og
	# endpoint, passing the original path — it returns per-page og:title/og:image so
	# a blog link unfurls with its own title + cover. Real users never match this and
	# fall through to the SPA below. Must precede /api, /hosting and the SPA handles.
	@unfurl {
		# Link-unfurl bots ONLY — deliberately NOT search engines (Googlebot/Bingbot
		# render JS and must get the indexable SPA, not this noindex redirect shell).
		header_regexp User-Agent (?i)(discordbot|twitterbot|facebookexternalhit|facebot|slackbot|slack-imgproxy|telegrambot|whatsapp|linkedinbot|embedly|redditbot|pinterest|vkshare|skypeuripreview|nuzzel|bitlybot|iframely|mastodon|snapchat)
		path / /blog/* /project/* /p/* /item/* /catalog /repos /hosting /projects
	}
	handle @unfurl {
		rewrite * /og?u={uri}
		reverse_proxy api:3000
	}

	# API
	handle_path /api/* {
		reverse_proxy api:3000
	}

	# Public hosted-repo content (repo.json / files) at a clean URL: /hosting/<user>/<repo>/...
	handle /hosting/* {
		reverse_proxy api:3000
	}

	# SEO files served by the API (dynamic sitemap incl. Other Projects + blog).
	handle /sitemap.xml {
		reverse_proxy api:3000
	}
	handle /robots.txt {
		reverse_proxy api:3000
	}
	# Public aggregate Server-Repos feed (a consumable repo.json index of every listed repo).
	handle /repos.json {
		reverse_proxy api:3000
	}

	# Public catalog.json feed (BMM-consumable app/plugin/theme catalog, ?project=&kind=).
	handle /catalog.json {
		reverse_proxy api:3000
	}

	# OpenID Connect provider: discovery + JWKS (issuer-root paths, NOT under /api) and
	# the OAuth2 authorize/token/userinfo endpoints. Specific well-known paths only, so
	# Caddy still answers /.well-known/acme-challenge/* itself for TLS.
	handle /.well-known/openid-configuration {
		reverse_proxy api:3000
	}
	handle /.well-known/jwks.json {
		reverse_proxy api:3000
	}
	handle /oauth2/* {
		reverse_proxy api:3000
	}

	# Content-hashed static assets (Vite emits immutable `assets/*.[hash].js|css`) →
	# cache hard at the browser/CDN so a CDN serves repeats with zero origin hits.
	# The HTML shell (handled below) stays uncached so a deploy is picked up at once.
	@assets path /assets/*
	handle @assets {
		header Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy web:80
	}

	# Everything else → the web SPA
	handle {
		reverse_proxy web:80
	}
}

# BMM telemetry dashboard on its OWN origin (it owns /api, /assets, etc., which
# would collide under a sub-path). Local: http://telemetry.localhost.
# Production: set TELEMETRY_DOMAIN to a real subdomain (auto-HTTPS).
#
# TELEMETRY_TUNNEL_DOMAIN is the second address, mirroring TUNNEL_DOMAIN on the site block
# above so the two are configured the same way. It is NOT wired into infra/tunnel.mjs, and
# that is deliberate: a Cloudflare QUICK tunnel cannot serve this dashboard, for a reason no
# amount of configuration fixes.
#
# The forward_auth gate below reads the session cookie set by the main site. A quick tunnel
# hands out ONE random hostname per process, so the dashboard would need a second, unrelated
# `*.trycloudflare.com` name — and two unrelated hostnames cannot share a cookie. Scoping it
# to `trycloudflare.com` itself is not an option either: it is on the Public Suffix List and
# browsers refuse a cookie set that wide. The gate would deny every request.
#
# So this slot is for a REAL domain, where the site and the dashboard are two subdomains of
# one zone and the cookie spans both. Until then it stays at its unreachable default.
{$TELEMETRY_DOMAIN:http://telemetry.localhost}, {$TELEMETRY_TUNNEL_DOMAIN:http://telemetry-tunnel.invalid} {
	encode gzip zstd

	# Public ingest + client-facing helpers. BMM posts telemetry batches with an
	# api_key (NOT a login session), so these MUST bypass the dashboard's
	# forward_auth gate below — otherwise the app's telemetry is blocked at the edge.
	# (These endpoints expose no collected data — see main.rs "public" router.)
	@ingest path /batch /batch/ /batch/* /capture /capture/* /delete-request /data-request /api/packet-status
	handle @ingest {
		reverse_proxy telemetry:8900
	}

	# The DASHBOARD (SPA + /api/stats + assets): gated behind a BCWEB login + the
	# canViewTelemetry grant. forward_auth hits the BCWEB API first: 2xx → proceed;
	# otherwise its response (302 to /auth for anon, 403 for signed-in-but-not-
	# granted) is returned to the browser. The telemetry app itself is never modified.
	# NOTE: the bcw_session cookie must reach this sub-domain, so set COOKIE_DOMAIN
	# (BCWEB api) to a parent domain (e.g. .example.com) in production.
	# NOTE: forward_auth talks to api:3000 directly (not through this proxy), so the
	# path is the API's real route WITHOUT the /api prefix that handle_path strips.
	handle {
		forward_auth api:3000 {
			uri /telemetry/authorize
		}
		reverse_proxy telemetry:8900
	}
}
