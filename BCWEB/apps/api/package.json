    "boring-avatars": "^1.11.2",
    "fastify": "^5.10.0",
    "geoip-lite": "^2.0.3",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "smol-toml": "^1.8.0",
    "stripe": "^16.8.0",
    "zod": "^3.23.8"
