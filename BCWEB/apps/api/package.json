{
  "name": "@bcweb/api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node --watch src/server.mjs",
    "start": "node src/server.mjs",
    "seed": "node src/seed.mjs",
    "clear-content": "node src/clear-repos-catalogs.mjs",
    "nuke": "node src/clear-repos-catalogs.mjs --nuke",
    "migrate": "prisma migrate deploy --schema ../../packages/db/schema.prisma",
    "test": "node --test test/*.test.mjs",
    "seed:demo": "node src/seed-demo.mjs",
    "seed:content": "node src/seed-content.mjs",
    "seed:docs": "node src/seed-docs.mjs",
    "seed:faq": "node src/seed-faq.mjs",
    "setup": "node src/setup.mjs",
    "test:e2e": "node --test test/e2e/*.test.mjs",
