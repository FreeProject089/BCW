# Dependencies
node_modules/
**/node_modules/

# Runtime data / databases / volumes (NEVER commit — can be GBs)
**/data/
*.sqlite
*.sqlite3
*.db

# Build output
dist/
build/
.next/
.vite/

# Secrets / env
.env
.env.*
!.env.example
# How infra/tunnel.mjs undoes itself after a dirty exit. Local runtime state, and it holds a
# copy of .env values — it belongs to one machine's tunnel session, never to the repo.
.tunnel-restore.json
**/keys/
*.private.key

# Logs / OS
*.log
.DS_Store
Thumbs.db

# Rust build artifacts
target/
**/target/

# Large rrweb replay served by the web (do not commit ~26MB)
apps/web/public/*.bmmreplay

*.bmmreplay
.claude/